#Область ОписаниеПеременных

&НаКлиенте
Перем Пометка; // Структура

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Параметры.АдресДереваОтбораПоПодсистемам)
		 Или Не ЭтоАдресВременногоХранилища(Параметры.АдресДереваОтбораПоПодсистемам) Тогда
		ТекстОшибки = НСтр("ru = 'Отбор по подсистемам можно открыть только передав адрес дерева отбора по подсистемам.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);
	КонецЕсли;
	ВключатьОбъектыИзПодчиненныхПодсистем = Параметры.ВключатьОбъектыИзПодчиненныхПодсистем;
	ВключатьОбъектыИзРодительскихПодсистем = Параметры.ВключатьОбъектыИзРодительскихПодсистем;

	Дерево = ПолучитьИзВременногоХранилища(Параметры.АдресДереваОтбораПоПодсистемам);
	УдалитьИзВременногоХранилища(Параметры.АдресДереваОтбораПоПодсистемам);
	ЗначениеВДанныеФормы(Дерево, ДеревоОтбораПоПодсистемам);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОтбораПоПодсистемам

&НаКлиенте
Процедура ДеревоОтбораПоПодсистемамПометкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ДеревоОтбораПоПодсистемам.ТекущиеДанные;

	Если ТекущиеДанные.Пометка = Пометка.Снята Или ТекущиеДанные.Пометка = Пометка.Установлена Тогда
		ТекущиеДанные.Пометка = Пометка.Установлена;
	Иначе
		ТекущиеДанные.Пометка = Пометка.Снята;
	КонецЕсли;

	СписокРодителей = СписокРодителей(ТекущиеДанные);
	
	СнятьПометкуРодителя = Ложь;
	РодителиДляСнятияПометки = Новый Соответствие;
	Для Сч = 0 По СписокРодителей.ВГраница() Цикл
		Родитель = СписокРодителей[СписокРодителей.ВГраница() - Сч];
		СнятьПометкуРодителя = СнятьПометкуРодителя Или (Родитель.Пометка = Пометка.Установлена);
		Если СнятьПометкуРодителя Тогда
			РодителиДляСнятияПометки.Вставить(Родитель, Родитель);
		КонецЕсли;
	КонецЦикла;
	
	ОбработатьИзменениеПометкиРодителя(ТекущиеДанные, РодителиДляСнятияПометки);
	ОбработатьИзменениеПометкиПодчиненныхЭлементов(ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СброситьОтбор(Команда)

	ЭлементыДерева = ДеревоОтбораПоПодсистемам.ПолучитьЭлементы();
	Если ЭлементыДерева.Количество() > 0 Тогда
		ТекущиеДанные = ЭлементыДерева[0];
		ТекущиеДанные.Пометка = Пометка.Установлена;
		ОбработатьИзменениеПометкиПодчиненныхЭлементов(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтбор(Команда)
	ЕстьПомеченные = Ложь;
	ЭлементыДерева = ДеревоОтбораПоПодсистемам.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыДерева Цикл
		Если Элемент.Пометка <> Пометка.Снята Тогда
			ЕстьПомеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьПомеченные Тогда
		Результат = Новый Структура;
		Результат.Вставить("ВключатьОбъектыИзПодчиненныхПодсистем", ВключатьОбъектыИзПодчиненныхПодсистем);
		Результат.Вставить("ВключатьОбъектыИзРодительскихПодсистем", ВключатьОбъектыИзРодительскихПодсистем);
		Результат.Вставить("АдресДереваОтбораПоПодсистемам", АдресДереваОтбораПоПодсистемам());
		Закрыть(Результат);
	Иначе
		ТекстОшибки = НСтр("ru = 'Нужно выбрать хотя бы одну подсистему для отбора.'");
		УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьИзменениеПометкиРодителя(ТекущиеДанные, РодителиДляСнятияПометки)

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УбратьПометки = (РодителиДляСнятияПометки[Родитель] <> Неопределено);

	ЕстьПомеченные = Ложь;
	ЕстьНепомеченные = Ложь;
	ЭлементыРодителя = Родитель.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыРодителя Цикл
		Если Элемент <> ТекущиеДанные И УбратьПометки Тогда
			Элемент.Пометка = Пометка.Снята;
			ОбработатьИзменениеПометкиПодчиненныхЭлементов(Элемент);
		КонецЕсли;

		Если Элемент.Пометка = Пометка.Установлена Или Элемент.Пометка = Пометка.Частная Тогда
			ЕстьПомеченные = Истина;
		Иначе
			ЕстьНепомеченные = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьПомеченные И ЕстьНепомеченные Тогда
		Родитель.Пометка = Пометка.Снята;
	Иначе
		Родитель.Пометка = Пометка.Частная;
	КонецЕсли;
	ОбработатьИзменениеПометкиРодителя(Родитель, РодителиДляСнятияПометки);
	
КонецПроцедуры

&НаКлиенте
Функция СписокРодителей(ТекущиеДанные, СписокРодителей = Неопределено)
	
	Если СписокРодителей = Неопределено Тогда
		СписокРодителей = Новый Массив;	
	КонецЕсли;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат СписокРодителей;
	КонецЕсли;
	
	СписокРодителей.Добавить(Родитель);
	СписокРодителей(Родитель, СписокРодителей);
	Возврат СписокРодителей;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеПометкиПодчиненныхЭлементов(ТекущиеДанные)

	Если ТекущиеДанные.Пометка = Пометка.Установлена Или ТекущиеДанные.Пометка = Пометка.Частная Тогда
		ПометкаЭлементов = Пометка.Частная;
	Иначе
		ПометкаЭлементов = Пометка.Снята;
	КонецЕсли;
	ЭлементыТекущихДанных = ТекущиеДанные.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыТекущихДанных Цикл
		Элемент.Пометка = ПометкаЭлементов;
		ОбработатьИзменениеПометкиПодчиненныхЭлементов(Элемент);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция АдресДереваОтбораПоПодсистемам()

	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоОтбораПоПодсистемам");
	Адрес = ПоместитьВоВременноеХранилище(ДеревоЗначений);
	Возврат Адрес;

КонецФункции

&НаКлиенте
Функция ЗначенияПометок()
	Результат = Новый Структура;
	Результат.Вставить("Снята", 0);
	Результат.Вставить("Установлена", 1);
	Результат.Вставить("Частная", 2);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Инициализация

#Если Клиент Тогда

Пометка = ЗначенияПометок();

#КонецЕсли

#КонецОбласти