&НаСервере
Процедура ЗаполнитьДеревоОтбораКонфигураций()

	ВерхнийУровень = ДеревоОтбораКонфигураций.ПолучитьЭлементы();
	Элемент = ВерхнийУровень.Добавить();
	Элемент.Имя = Метаданные.Имя;
	Элемент.Синоним = Метаданные.Синоним;
	Элемент.Пометка = 1;
	Элемент.ТекущаяБазаДанных = Истина;

	ЭлементыРасширений = Элемент.ПолучитьЭлементы();
	АктивныеРасширения = АктивныеРасширения();
	Для Каждого Расширение Из АктивныеРасширения Цикл
		ЭлементРасширения = ЭлементыРасширений.Добавить();
		ЭлементРасширения.Имя = Расширение.Имя;
		ЭлементРасширения.Синоним = Расширение.Синоним;
		ЭлементРасширения.Пометка = 1;
		ЭлементРасширения.ТекущаяБазаДанных = Истина;
	КонецЦикла;

КонецПроцедуры

// Возвращает расширение по имени.
// 
// Параметры:
//  СписокРасширений - Массив из РасширениеКонфигурации - Список расширений
//  ИмяРасширения - Строка - Имя расширения
// 
// Возвращаемое значение:
//  Неопределено, РасширениеКонфигурации - Найти расширение по имени
&НаСервереБезКонтекста
Функция НайтиРасширениеПоИмени(СписокРасширений, ИмяРасширения)

	Результат = Неопределено;
	Для Каждого Расширение Из СписокРасширений Цикл
		Если Расширение.Имя = ИмяРасширения Тогда
			Результат = Расширение;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает активные расширения текущего сеанса.
// 
// Параметры:
//  ИмяРасширения - Неопределено, Строка - Имя расширения, если указан, то вернется расширение по этому имени
// 
// Возвращаемое значение:
//  Массив из РасширениеКонфигурации - Активные расширения
&НаСервереБезКонтекста
Функция АктивныеРасширения(ИмяРасширения = Неопределено)

	Перем СтруктураПоиска;
	Если ИмяРасширения <> Неопределено Тогда
		СтруктураПоиска = Новый Структура("Имя", ИмяРасширения);
	КонецЕсли;
	АктивныеРасширения = РасширенияКонфигурации.Получить(СтруктураПоиска, ИсточникРасширенийКонфигурации.СеансАктивные);
	Возврат АктивныеРасширения;

КонецФункции

&НаСервере
Функция АдресДереваОтбораКонфигураций()

	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоОтбораКонфигураций");
	Адрес = ПоместитьВоВременноеХранилище(ДеревоЗначений);
	Возврат Адрес;

