
#Область ОписаниеПеременных

&НаСервере
Перем ЭлементыСтруктурыКонфигурации;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСтруктуруКонфигурации();
	ЗаполнитьДеревоОтбораКонфигураций();
	ЗаполнитьДеревоОбъектовМетаданных();
	
	УИ_ОбщегоНазначения.ФормаИнструментаПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка,
		Элементы.ДеревоОбъектовМетаданных.КоманднаяПанель);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОбъектовМетаданных

&НаКлиенте
Процедура ДеревоОбъектовМетаданныхПередРазворачиванием(Элемент, Строка, Отказ)

	ТекущиеДанные = ДеревоОбъектовМетаданных.НайтиПоИдентификатору(Строка);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЗаполнитьКоллекциюМетаданных Тогда
		ДеревоОбъектовМетаданныхПередРазворачиваниемНаСервере(Строка);
	КонецЕсли;
	Элементы.ДеревоОбъектовМетаданных.ТекущаяСтрока = Строка;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовМетаданныхПриАктивизацииСтроки(Элемент)
	УстановитьДоступностьКнопокДереваОбъектов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьОтборКонфигураций(Команда)

	Оповещение = Новый ОписаниеОповещения("ОткрытьОтборКонфигурацийЗавершение", ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура("АдресДереваОтбораКонфигураций", АдресДереваОтбораКонфигураций());
	ОткрытьФорму("Обработка.УИ_НавигаторПоМетаданным.Форма.ФормаОтбораКонфигураций",
				 ПараметрыОткрытия,
				 ЭтотОбъект,
				 УникальныйИдентификатор,
				 ,
				 ,
				 Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъектСписокМетаданных(Команда)

	ТекущиеДанные = Элементы.ДеревоОбъектовМетаданных.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Позиция = СтрНайти(ТекущиеДанные.ПолноеИмя, ".");
	Если Позиция > 0 Тогда
		ИмяБазовогоТипа = Лев(ТекущиеДанные.ПолноеИмя, Позиция - 1);
	Иначе
		ТекстОшибки = НСтр("ru = 'Не удалось получить базовый тип по полному имени метаданных.'");
		УИ_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;

	ТипыСФормойСписка = Новый Массив;
	ТипыСФормойСписка.Добавить("Справочник");
	ТипыСФормойСписка.Добавить("Документ");
	ТипыСФормойСписка.Добавить("БизнесПроцесс");
	ТипыСФормойСписка.Добавить("Задача");
	ТипыСФормойСписка.Добавить("ПланСчетов");
	ТипыСФормойСписка.Добавить("ПланОбмена");
	ТипыСФормойСписка.Добавить("ПланВидовХарактеристик");
	ТипыСФормойСписка.Добавить("ПланВидовРасчета");
	ТипыСФормойСписка.Добавить("Перечисление");
	ТипыСФормойСписка.Добавить("ЖурналДокументов");
	ТипыСФормойСписка.Добавить("РегистрСведений");
	ТипыСФормойСписка.Добавить("РегистрНакопления");
	ТипыСФормойСписка.Добавить("РегистрБухгалтерии");
	ТипыСФормойСписка.Добавить("РегистрРасчета");

	Если ТипыСФормойСписка.Найти(ИмяБазовогоТипа) <> Неопределено Тогда
		Если ИспользоватьФормуСпискаИнструмента И ИмяБазовогоТипа <> "Перечисление" Тогда
			УИ_ОбщегоНазначенияКлиент.ОткрытьДинамическийСписок(ТекущиеДанные.ПолноеИмя);
		Иначе
			ИмяФормыОткрытия = СтрШаблон("%1.ФормаСписка", ТекущиеДанные.ПолноеИмя);
			ОткрытьФорму(ИмяФормыОткрытия);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТипыСФормой = Новый Массив;
	ТипыСФормой.Добавить("Обработка");
	ТипыСФормой.Добавить("Отчет");
	Если ТипыСФормой.Найти(ИмяБазовогоТипа) <> Неопределено Тогда
		ИмяФормыОткрытия = СтрШаблон("%1.Форма", ТекущиеДанные.ПолноеИмя);
		ОткрытьФорму(ИмяФормыОткрытия);
		Возврат;
	КонецЕсли;

	Если ИмяБазовогоТипа = "Константа" Тогда
		ИмяФормыОткрытия = СтрШаблон("%1.ФормаКонстант", ТекущиеДанные.ПолноеИмя);
		ОткрытьФорму(ИмяФормыОткрытия);
		Возврат;
	КонецЕсли;

	Если ИмяБазовогоТипа = "ОбщаяФорма" Тогда
		ОткрытьФорму(ТекущиеДанные.ПолноеИмя);
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДеревоОбъектовМетаданных()

	ДанныеПоОтборуКонфигураций = ДанныеПоОтборуКонфигураций();
	ДеревоОбъектов = РеквизитФормыВЗначение("ДеревоОбъектовМетаданных");
	ЗаполнитьОбъектыМетаданных(ДеревоОбъектов, ДанныеПоОтборуКонфигураций);
	ЗначениеВРеквизитФормы(ДеревоОбъектов, "ДеревоОбъектовМетаданных");

КонецПроцедуры

&НаСервере
Функция ДанныеПоОтборуКонфигураций()

	ВыбранныйРодитель = Неопределено;
	ЭлементыДерева = ДеревоОтбораКонфигураций.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыДерева Цикл
		Если Элемент.Пометка <> 0 Тогда
			ВыбранныйРодитель = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныйРодитель = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Некорректно указан отбор по конфигурациям.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат = Новый Массив;
	Если ВыбранныйРодитель.Пометка = 1 Тогда
		ДанныеКонфигурации = ДанныеКонфигурации(ВыбранныйРодитель);
		Результат.Добавить(ДанныеКонфигурации);
	Иначе
		АктивныеРасширения = АктивныеРасширения();
		ЭлементыРодителя = ВыбранныйРодитель.ПолучитьЭлементы();
		Для Каждого Элемент Из ЭлементыРодителя Цикл
			Если Элемент.Пометка = 1 Тогда
				ДанныеРасширения = ДанныеКонфигурации(Элемент, АктивныеРасширения);
				Результат.Добавить(ДанныеРасширения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеКонфигурации(ТекущиеДанные, СписокРасширений = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("Имя", ТекущиеДанные.Имя);
	Результат.Вставить("Метаданные", Неопределено);
	Результат.Вставить("ДеревоОбъектовМетаданных", Неопределено);
	Результат.Вставить("Идентификатор", ТекущиеДанные.ПолучитьИдентификатор());
	Результат.Вставить("КэшЭлементов", Новый Соответствие);
	Результат.Вставить("КэшУзлов", Новый Соответствие);

	ЕстьРодитель = (ТекущиеДанные.ПолучитьРодителя() <> Неопределено);
	Если ЭтоАдресВременногоХранилища(ТекущиеДанные.АдресМетаданных) Тогда
		ДвоичныеДанныеМетаданных = ПолучитьИзВременногоХранилища(ТекущиеДанные.АдресМетаданных);
		МетаданныеКонфигурации = Новый ОбъектМетаданныхКонфигурация(ДвоичныеДанныеМетаданных);
		Результат.Метаданные = МетаданныеКонфигурации;
	ИначеЕсли ТекущиеДанные.ТекущаяБазаДанных Тогда
		Если ЕстьРодитель Тогда
			Если СписокРасширений = Неопределено Тогда
				СписокРасширений = АктивныеРасширения(ТекущиеДанные.Имя);
			КонецЕсли;
			Расширение = НайтиРасширениеПоИмени(СписокРасширений, ТекущиеДанные.Имя);
			ДанныеРасширения = Расширение.ПолучитьДанные();
			МетаданныеРасширения = Новый ОбъектМетаданныхКонфигурация(ДанныеРасширения);
			Результат.Метаданные = МетаданныеРасширения;
			ТекущиеДанные.АдресМетаданных = ПоместитьВоВременноеХранилище(ДанныеРасширения,
																		  УникальныйИдентификатор);
		Иначе
			МетаданныеКонфигурации = Метаданные;
			Результат.Метаданные = МетаданныеКонфигурации;
		КонецЕсли;
	Иначе
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Для конфигурации ""%1"" не сохранились данные метаданных.'"),
								ТекущиеДанные.Имя);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Если ЭтоАдресВременногоХранилища(ТекущиеДанные.АдресДереваОбъектовМетаданных) Тогда
		Результат.ДеревоОбъектовМетаданных = ПолучитьИзВременногоХранилища(ТекущиеДанные.АдресДереваОбъектовМетаданных);
	Иначе
		ДеревоОбъектов = СоздатьДеревоОбъектов();
		ИнициализироватьОбъектыМетаданных(ДеревоОбъектов, Результат.Метаданные);
		ТекущиеДанные.АдресДереваОбъектовМетаданных = ПоместитьВоВременноеХранилище(ДеревоОбъектов,
																					УникальныйИдентификатор);
		Результат.ДеревоОбъектовМетаданных = ДеревоОбъектов;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СоздатьДеревоОбъектов()

	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоОбъектовМетаданных");
	ДеревоЗначений.Строки.Очистить();
	Возврат ДеревоЗначений;

КонецФункции

&НаСервере
Процедура ЗаполнитьОбъектыМетаданных(ДеревоМетаданных, ДанныеПоОтборуКонфигураций)

//	ЭлементыСтруктурыКонфигурации = ЭлементыСтруктурыКонфигурации();
	ЭлементыДерева = ДеревоМетаданных.Строки;
	ЭлементыДерева.Очистить();

	ОднаКонфигурация = (ДанныеПоОтборуКонфигураций.Количество() = 1);

	КэшУзлов = Новый Соответствие;
	Для Каждого ОписаниеЭлемента Из СтруктураКонфигурации Цикл
		Узел = УзелМетаданныхДерева(ДеревоМетаданных, ОписаниеЭлемента, КэшУзлов);
		Если Узел = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭлементыУзла = Узел.Строки;

		НоваяСтрока = ЭлементыУзла.Добавить();
		Если ОписаниеЭлемента.Имя = ЭлементыСтруктурыКонфигурации.Конфигурация Тогда
			Если ОднаКонфигурация Тогда
				СтрокаДанныхОтбораКонфигурации = ДанныеПоОтборуКонфигураций[0];
				ОбъектКонфигурация = ОбъектМетаданныхДерева(СтрокаДанныхОтбораКонфигурации.ДеревоОбъектовМетаданных,
															ОписаниеЭлемента,
															СтрокаДанныхОтбораКонфигурации.КэшЭлементов,
															СтрокаДанныхОтбораКонфигурации.КэшУзлов);
				Если ОбъектКонфигурация = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбъектКонфигурация);
			Иначе
				НоваяСтрока.Имя = ОписаниеЭлемента.Представление;
				НоваяСтрока.ИмяЭлементаСтруктурыКонфигурации = ОписаниеЭлемента.Имя;
				СписокКонфигураций = НоваяСтрока.Строки;
				Для Каждого СтрокаДанных Из ДанныеПоОтборуКонфигураций Цикл
					ОбъектКонфигурация = ОбъектМетаданныхДерева(СтрокаДанных.ДеревоОбъектовМетаданных,
																ОписаниеЭлемента,
																СтрокаДанных.КэшЭлементов,
																СтрокаДанных.КэшУзлов);
					НоваяКонфигурация = СписокКонфигураций.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяКонфигурация, ОбъектКонфигурация);
				КонецЦикла;
			КонецЕсли;
		Иначе
			НоваяСтрока.Имя = ОписаниеЭлемента.Представление;
			НоваяСтрока.ИмяЭлементаСтруктурыКонфигурации = ОписаниеЭлемента.Имя;
		КонецЕсли;
		Если ОписаниеЭлемента.ЕстьКоллекция Тогда
			ЗаполнитьКоллекциюМетаданных = Ложь;
			КоличествоЭлементов = 0;
			КэшСтрокПриемника = КэшСтрокПриемника(НоваяСтрока.Строки);
			Для Каждого СтрокаДанных Из ДанныеПоОтборуКонфигураций Цикл
				ОбъектКонфигурация = ОбъектМетаданныхДерева(СтрокаДанных.ДеревоОбъектовМетаданных,
															ОписаниеЭлемента,
															СтрокаДанных.КэшЭлементов,
															СтрокаДанных.КэшУзлов);
				ДополнитьКоллекциюОбъектаМетаданных(НоваяСтрока.Строки, ОбъектКонфигурация.Строки, КэшСтрокПриемника);
				КоличествоЭлементов = КоличествоЭлементов + ОбъектКонфигурация.КоличествоЭлементов;
				ЗаполнитьКоллекциюМетаданных = (ЗаполнитьКоллекциюМетаданных
												Или ОбъектКонфигурация.ЗаполнитьКоллекциюМетаданных);
			КонецЦикла;
			НоваяСтрока.ЗаполнитьКоллекциюМетаданных = ЗаполнитьКоллекциюМетаданных;
			Если Не НоваяСтрока.ЗаполнитьКоллекциюМетаданных Или ОднаКонфигурация Тогда
				НоваяСтрока.КоличествоЭлементов = КоличествоЭлементов;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьКоллекциюОбъектаМетаданных(КоллекцияМетаданныхПриемник, КоллекцияМетаданныхИсточник,
	КэшСтрокПриемника)

	ЭтоПриемникДанныеФормы = (ТипЗнч(КоллекцияМетаданныхПриемник) = Тип("ДанныеФормыКоллекцияЭлементовДерева"));
	СтруктураПоиска = КолонкиУникальностиОбъектаМетаданных();
	Для Каждого СтрокаИсточник Из КоллекцияМетаданныхИсточник Цикл
		Если ЗначениеЗаполнено(СтрокаИсточник.ИмяЭлементаСтруктурыКонфигурации) Тогда
			Продолжить;
		КонецЕсли;
		КлючПоиска = КлючСтрокиКэша(СтруктураПоиска, СтрокаИсточник);
		РезультатПоиска = КэшСтрокПриемника[КлючПоиска];

		Если РезультатПоиска = Неопределено Тогда
			НоваяСтрока = КоллекцияМетаданныхПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			ДобавитьСтрокуКэша(КэшСтрокПриемника, КлючПоиска);
			Если СтрокаИсточник.Строки.Количество() > 0 Тогда
				Если ЭтоПриемникДанныеФормы Тогда
					ДополнитьКоллекциюОбъектаМетаданных(НоваяСтрока.ПолучитьЭлементы(),
														СтрокаИсточник.Строки,
														КэшСтрокПриемника);
				Иначе
					ДополнитьКоллекциюОбъектаМетаданных(НоваяСтрока.Строки, СтрокаИсточник.Строки, КэшСтрокПриемника);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КэшСтрокПриемника(КоллекцияМетаданныхПриемник)
	КлючевыеПоля = КолонкиУникальностиОбъектаМетаданных();
	Результат = Новый Соответствие();
	Для Каждого СтрокаКоллекции Из КоллекцияМетаданныхПриемник Цикл
		Если ЗначениеЗаполнено(СтрокаКоллекции.ИмяЭлементаСтруктурыКонфигурации) Тогда
			Продолжить;
		КонецЕсли;
		КлючСтроки = КлючСтрокиКэша(КлючевыеПоля, СтрокаКоллекции);
		ДобавитьСтрокуКэша(Результат, КлючСтроки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуКэша(КэшСтрок, КлючСтроки)
	КэшСтрок.Вставить(КлючСтроки, Истина);
КонецПроцедуры

&НаСервереБезКонтекста
