&НаСервереБезКонтекста
Функция КолонкиУникальностиОбъектаМетаданных()

	Результат = Новый Структура;
	Результат.Вставить("Имя");
	Результат.Вставить("ПолноеИмя");
	Результат.Вставить("ИмяЭлементаСтруктурыКонфигурации");
	Результат.Вставить("ЭтоВременнаяСтрока");
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ИнициализироватьОбъектыМетаданных(ДеревоМетаданных, МетаданныеКонфигурации)

//	ЭлементыСтруктурыКонфигурации = ЭлементыСтруктурыКонфигурации();
	ЭлементыДерева = ДеревоМетаданных.Строки;
	ЭлементыДерева.Очистить();

	КэшЭлементов = Новый Соответствие;
	Для Каждого ОписаниеЭлемента Из СтруктураКонфигурации Цикл
		Узел = УзелМетаданныхДерева(ДеревоМетаданных, ОписаниеЭлемента, КэшЭлементов);
		Если Узел = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭлементыУзла = Узел.Строки;

		НоваяСтрока = ЭлементыУзла.Добавить();
		Если ОписаниеЭлемента.Имя = ЭлементыСтруктурыКонфигурации.Конфигурация Тогда
			НоваяСтрока.Имя = МетаданныеКонфигурации.Имя;
			НоваяСтрока.Синоним = МетаданныеКонфигурации.Синоним;
			НоваяСтрока.ИмяЭлементаСтруктурыКонфигурации = ОписаниеЭлемента.Имя;
		Иначе
			НоваяСтрока.Имя = ОписаниеЭлемента.Представление;
			НоваяСтрока.ИмяЭлементаСтруктурыКонфигурации = ОписаниеЭлемента.Имя;
		КонецЕсли;
		Если ОписаниеЭлемента.ЕстьКоллекция Тогда
			НоваяСтрока.ЗаполнитьКоллекциюМетаданных = Истина;
			КоллекцияОбъектовМетаданных = МетаданныеКонфигурации[ОписаниеЭлемента.Имя];
			НоваяСтрока.КоличествоЭлементов = КоличествоЭлементовОбъектовМетаданных(КоллекцияОбъектовМетаданных);
			Если НоваяСтрока.КоличествоЭлементов > 0 Тогда
				ЭлементыНовойСтроки = НоваяСтрока.Строки;
				ДобавитьВременнуюСтрокуВДеревоКонфигурации(ЭлементыНовойСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоЭлементовОбъектовМетаданных(КоллекцияОбъектовМетаданных)
	
	Результат = КоллекцияОбъектовМетаданных.Количество();
	Если Результат > 0 И УИ_ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(КоллекцияОбъектовМетаданных[0],
																						"Подсистемы") Тогда
		Для Каждого Подсистема Из КоллекцияОбъектовМетаданных Цикл
			Результат = Результат + КоличествоЭлементовОбъектовМетаданных(Подсистема.Подсистемы);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Находит узел дерева метаданных по пути элемента с кэшированием результата поиска.
//
// Параметры:
//   ДеревоМетаданных - ДеревоЗначений - дерево структуры конфигурации
//   ОписаниеЭлемента - Структура - описание элемента конфигурации:
//     * ПутьКЭлементу - Строка - путь к элементу через точку
//     * Имя - Строка - имя элемента структуры конфигурации
//   КэшУзлов - Соответствие из Строка - кэш найденных узлов, ключ - путь к элементу, значение - строка дерева значений
//
// Возвращаемое значение:
//   ДеревоЗначений, СтрокаДереваЗначений, Неопределено - дерева метаданных, если путь пустой
//   СтрокаДереваЗначений - найденный узел дерева метаданных
//   Неопределено - если узел по указанному пути не найден
&НаСервереБезКонтекста
Функция УзелМетаданныхДерева(ДеревоМетаданных, ОписаниеЭлемента, КэшУзлов)

	ЗначениеКэша = КэшУзлов[ОписаниеЭлемента.ПутьКЭлементу];
	Если ЗначениеКэша <> Неопределено Тогда
		Возврат ЗначениеКэша;
	КонецЕсли;

	РезультатПоиска = ДеревоМетаданных;
	ЭлементыУзла = ДеревоМетаданных.Строки;
	ПутьКЭлементу = СтрРазделить(ОписаниеЭлемента.ПутьКЭлементу, ".", Ложь);
	Для Каждого ЧастьПути Из ПутьКЭлементу Цикл
		РезультатПоиска = Неопределено;
		Для Каждого ЭлементУзла Из ЭлементыУзла Цикл
			Если ЭлементУзла.ИмяЭлементаСтруктурыКонфигурации = ЧастьПути Тогда
				РезультатПоиска = ЭлементУзла;
			КонецЕсли;
		КонецЦикла;
		Если РезультатПоиска = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ЭлементыУзла = РезультатПоиска.Строки;
	КонецЦикла;
	Если РезультатПоиска = Неопределено Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось найти узел ""%1""%2 для элемента структуры конфигурации ""%3"".'");
		Если ПустаяСтрока(ОписаниеЭлемента.ПутьКЭлементу) Тогда
			ОписаниеПути = "";
		Иначе
			ОписаниеПути = СтрШаблон(НСтр("ru = ' из пути ""%1""'"), ОписаниеЭлемента.ПутьКЭлементу);
		КонецЕсли;
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ЧастьПути, ОписаниеПути, ОписаниеЭлемента.Имя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	Иначе
		КэшУзлов.Вставить(ОписаниеЭлемента.ПутьКЭлементу, РезультатПоиска);
	КонецЕсли;
	Возврат РезультатПоиска;

КонецФункции

// Находит объект метаданных дерева по пути элемента с кэшированием результата поиска.
//
// Параметры:
//   ДеревоМетаданных - ДеревоЗначений - дерево структуры конфигурации
//   ОписаниеЭлемента - Структура - описание элемента конфигурации:
//     * ПутьКЭлементу - Строка - путь к элементу через точку
//     * Имя - Строка - имя элемента структуры конфигурации
//   КэшОбъектов - Соответствие из Строка - кэш найденных объектов, ключ - путь к элементу, значение - строка дерева значений
//   КэшУзлов - Соответствие из Строка - кэш найденных узлов, ключ - путь к элементу, значение - строка дерева значений
//
// Возвращаемое значение:
//   СтрокаДереваЗначений, Неопределено - найденный объект метаданных дерева
//    	Неопределено - если элемент не найден
&НаСервереБезКонтекста
Функция ОбъектМетаданныхДерева(ДеревоМетаданных, ОписаниеЭлемента, КэшОбъектов, КэшУзлов)

	КлючКэша = СтрШаблон("%1.%2", ОписаниеЭлемента.ПутьКЭлементу, ОписаниеЭлемента.Имя);
	ЗначениеКэша = КэшОбъектов[КлючКэша];
	Если ЗначениеКэша <> Неопределено Тогда
		Возврат ЗначениеКэша;
	КонецЕсли;

	СтрокаОбъекта = Неопределено;
	Узел = УзелМетаданныхДерева(ДеревоМетаданных, ОписаниеЭлемента, КэшУзлов);
	Если Узел = Неопределено Тогда
		Возврат СтрокаОбъекта;
	КонецЕсли;
	Для Каждого СтрокаУзла Из Узел.Строки Цикл
		Если СтрокаУзла.ИмяЭлементаСтруктурыКонфигурации = ОписаниеЭлемента.Имя Тогда
			СтрокаОбъекта = СтрокаУзла;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаОбъекта = Неопределено Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось найти элемент структуры конфигурации ""%1"" по пути ""%2"".'");
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ОписаниеЭлемента.Имя, ОписаниеЭлемента.ПутьКЭлементу);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	Иначе
		КэшОбъектов.Вставить(КлючКэша, СтрокаОбъекта);
	КонецЕсли;
	Возврат СтрокаОбъекта;

КонецФункции

&НаСервере
Процедура ДеревоОбъектовМетаданныхПередРазворачиваниемНаСервере(Знач Строка)

	ТекущиеДанные = ДеревоОбъектовМетаданных.НайтиПоИдентификатору(Строка);
	ЗаполнитьУзелМетаданных(ТекущиеДанные);

КонецПроцедуры

&НаСервере
Функция ЭлементСтруктурыКонфигурации(ИмяЭлемента)
	
	Результат = Неопределено;
	СтруктураПоиска = Новый Структура("Имя", ИмяЭлемента);
	НайденныеСтроки = СтруктураКонфигурации.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат = НайденныеСтроки[0];
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьУзелМетаданных(Узел)

	ЭлементыУзла = Узел.ПолучитьЭлементы();
	НайтиИУдалитьВременнуюСтрокуВДеревеКонфигурации(ЭлементыУзла);
	ЭлементСтруктурыКонфигурации = ЭлементСтруктурыКонфигурации(Узел.ИмяЭлементаСтруктурыКонфигурации);
	ДанныеПоОтборуКонфигураций = ДанныеПоОтборуКонфигураций();
	КэшСтрокПриемника = КэшСтрокПриемника(ЭлементыУзла);
	Для Каждого СтрокаДанных Из ДанныеПоОтборуКонфигураций Цикл
		КоллекцияОбъектов = ОбъектМетаданныхДерева(СтрокаДанных.ДеревоОбъектовМетаданных,
												   ЭлементСтруктурыКонфигурации,
												   СтрокаДанных.КэшЭлементов,
												   СтрокаДанных.КэшУзлов);
		Если КоллекцияОбъектов.ЗаполнитьКоллекциюМетаданных Тогда
			ЗаполнитьКоллекциюОбъектовМетаданных(КоллекцияОбъектов, СтрокаДанных.Метаданные);
			СохранитьДеревоМетаданныхКонфигурации(СтрокаДанных);
			ДополнитьКоллекциюОбъектаМетаданных(ЭлементыУзла, КоллекцияОбъектов.Строки, КэшСтрокПриемника);
		КонецЕсли;
	КонецЦикла;
	Узел.КоличествоЭлементов = КэшСтрокПриемника.Количество();
	Узел.ЗаполнитьКоллекциюМетаданных = Ложь;

КонецПроцедуры

&НаСервере
Процедура СохранитьДеревоМетаданныхКонфигурации(СтрокаДанныхПоОтборуКонфигураций)

	СтрокаКонфигурации = ДеревоОтбораКонфигураций.НайтиПоИдентификатору(СтрокаДанныхПоОтборуКонфигураций.Идентификатор);
	Если СтрокаКонфигурации = Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не найдена строка конфигурации по идентификатору %1.'"),
								СтрокаДанныхПоОтборуКонфигураций.Идентификатор);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(СтрокаКонфигурации.АдресДереваОбъектовМетаданных) Тогда
		УдалитьИзВременногоХранилища(СтрокаКонфигурации.АдресДереваОбъектовМетаданных);
	КонецЕсли;
	ДеревоОбъектов = СтрокаДанныхПоОтборуКонфигураций.ДеревоОбъектовМетаданных;
	СтрокаКонфигурации.АдресДереваОбъектовМетаданных = ПоместитьВоВременноеХранилище(ДеревоОбъектов,
																					 УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоллекциюОбъектовМетаданных(КоллекцияОбъектов, МетаданныеКонфигурации, ВидОбъекта = Неопределено)

	Если ВидОбъекта = Неопределено Тогда
		ВидОбъекта = КоллекцияОбъектов.ИмяЭлементаСтруктурыКонфигурации;
	КонецЕсли;
//	ЭлементыСтруктурыКонфигурации = ЭлементыСтруктурыКонфигурации();
	ЭлементыКоллекции = КоллекцияОбъектов.Строки;
	НайтиИУдалитьВременнуюСтрокуВДеревеКонфигурации(ЭлементыКоллекции);
	Для Каждого ОбъектМетаданных Из МетаданныеКонфигурации[ВидОбъекта] Цикл
		НоваяСтрока = ДобавитьОбъектМетаданныхВКоллекцию(ЭлементыКоллекции, ОбъектМетаданных);
		Если ВидОбъекта = ЭлементыСтруктурыКонфигурации.Подсистемы Тогда
			ЗаполнитьКоллекциюОбъектовМетаданных(НоваяСтрока, ОбъектМетаданных, ВидОбъекта);
		КонецЕсли;
	КонецЦикла;
	КоллекцияОбъектов.ЗаполнитьКоллекциюМетаданных = Ложь;

КонецПроцедуры

&НаСервере
Функция ДобавитьОбъектМетаданныхВКоллекцию(ЭлементыКоллекции, ОбъектМетаданных)

	НовыйЭлемент = ЭлементыКоллекции.Добавить();
	НовыйЭлемент.Имя = ОбъектМетаданных.Имя;
	НовыйЭлемент.Синоним = ОбъектМетаданных.Синоним;
	НовыйЭлемент.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Возврат НовыйЭлемент;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВременнуюСтрокуВДеревоКонфигурации(ЭлементыУзла)

	НоваяСтрока = ЭлементыУзла.Добавить();
	НоваяСтрока.ЭтоВременнаяСтрока = Истина;

КонецПроцедуры

// Удаляет временную строку в дереве конфигурации, если она есть в элементах узла.
// 
// Параметры:
//  ЭлементыУзла - ДанныеФормыКоллекцияЭлементовДерева, КоллекцияСтрокДереваЗначений - Элементы узла
&НаСервереБезКонтекста
Процедура НайтиИУдалитьВременнуюСтрокуВДеревеКонфигурации(ЭлементыУзла)

	Для Каждого Элемент Из ЭлементыУзла Цикл
		Если Элемент.ЭтоВременнаяСтрока Тогда
			ЭлементыУзла.Удалить(Элемент);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруКонфигурации()

	ЭлементыСтруктуры = ЭлементыСтруктурыКонфигурации();
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.Конфигурация, НСтр("ru = 'Конфигурация'"), , Ложь);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.Общие, НСтр("ru = 'Общие'"), , Ложь);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.Подсистемы,
										НСтр("ru = 'Подсистемы'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.ОбщиеМодули,
										НСтр("ru = 'Общие модули'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.ПараметрыСеанса,
										НСтр("ru = 'Параметры сеанса'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.Роли, НСтр("ru = 'Роли'"), ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.ОбщиеРеквизиты,
										НСтр("ru = 'Общие реквизиты'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.ПланыОбмена,
										НСтр("ru = 'Планы обмена'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.КритерииОтбора,
										НСтр("ru = 'Критерии отбора'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.ПодпискиНаСобытия,
										НСтр("ru = 'Подписки на события'"),
										ЭлементыСтруктуры.Общие);
	ДобавитьСтрокуСтруктурыКонфигурации(ЭлементыСтруктуры.РегламентныеЗадания,
										НСтр("ru = 'Регламентные задания'"),
										ЭлементыСтруктуры.Общие);
