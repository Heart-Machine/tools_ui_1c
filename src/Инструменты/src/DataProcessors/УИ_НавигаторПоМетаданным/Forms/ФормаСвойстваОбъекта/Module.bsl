	Если ДанныеСтроки = Неопределено Или ПустаяСтрока(ДанныеСтроки.Объект) Тогда
		Возврат;
	КонецЕсли;
	ПерейтиКОбъектуМетаданных(ДанныеСтроки.Объект);

