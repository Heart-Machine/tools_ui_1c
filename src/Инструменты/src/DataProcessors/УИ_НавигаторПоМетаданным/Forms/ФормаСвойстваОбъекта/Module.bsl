&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Дерево отбора переносится до проверок, чтобы переданные данные не остались во временном хранилище.
	ИмяРасширения = Параметры.ИмяРасширения;
	ПеренестиДеревоОтбораКонфигураций(Параметры.АдресДереваОтбораКонфигураций);

	ПолноеИмяОбъекта = Параметры.ПолноеИмя;
	Если ПустаяСтрока(ПолноеИмяОбъекта) Или Не ЗаполнитьДанныеСвойств() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	УстановитьТекущийУзелКорень();
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Для Каждого КорневойУзел Из Состав.ПолучитьЭлементы() Цикл
		Элементы.Состав.Развернуть(КорневойУзел.ПолучитьИдентификатор());
	КонецЦикла;
	ПоказатьДанныеТекущегоУзла();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыУзлаПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаОбратныеСвязи Тогда
		// Индекс обратных связей строится по всей конфигурации, поэтому заполняется только при первом открытии страницы.
		Если Не ОбратныеСвязиЗаполнены Тогда
			ЗаполнитьОбратныеСвязи();
			КлючПоказанныхОбратныхСвязей = Неопределено;
			УзлыСПравамиРолей = Неопределено;
			СсылкиСОбратнымиСвязями = Неопределено;
		КонецЕсли;
		ПоказатьОбратныеСвязиТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРоли Тогда
		ПоказатьПраваРолейТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПользователи Тогда
		ПоказатьПраваПользователейТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДанныеБазы Тогда
		ПоказатьДанныеБазыТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПраваРоли Тогда
		ПоказатьПраваРоли();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРасширения Тогда
		ПоказатьРасширенияТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаУправлениеИтогами Тогда
		// Настройки итогов читаются из базы при первом открытии страницы, дальше - по кнопке "Обновить".
		Если Не НастройкиИтоговЗаполнены Тогда
			ЗаполнитьНастройкиИтогов();
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаЗначение Тогда
		// Значение константы читается из базы при первом открытии страницы, дальше - по кнопке "Обновить".
		Если Не ЗначениеКонстантыЗаполнено Тогда
			ЗаполнитьЗначениеКонстанты();
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПодключение Тогда
		// Состояние и параметры соединения читаются при первом открытии страницы, дальше - по кнопке "Обновить".
		Если Не ПараметрыСоединенияЗаполнены Тогда
			ЗаполнитьПараметрыСоединения();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

