&НаКлиенте
Процедура ОбновитьНумерацию(Команда)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не КомандаПрименимаКУзлу("ОбновитьНумерацию", ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;
	ПолноеИмяУзла = ПолноеИмяУзлаДляНумерации(ТекущиеДанные);
	Если ТекущиеДанные.Вид = "Конфигурация" Тогда
		ТекстВопроса = НСтр("ru = 'Будет обновлена нумерация всех объектов конфигурации. Продолжить?'");
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Будет обновлена нумерация объекта ""%1"". Продолжить?'"), ПолноеИмяУзла);
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ОбновлениеНумерацииПослеВопроса", ЭтотОбъект, ПолноеИмяУзла);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

