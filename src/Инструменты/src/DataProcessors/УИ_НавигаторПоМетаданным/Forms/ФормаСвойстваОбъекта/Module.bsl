&НаКлиенте
Процедура ЗначениеКонстантыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	// Значение выбирается так же, как в редакторе констант.
	ПараметрыОбработчика = УИ_ОбщегоНазначенияКлиент.НовыйПараметрыОбработчикаСобытияНачалоВыбораЗначения(ЭтотОбъект,
		Элемент, "ЗначениеКонстанты");
	ПараметрыОбработчика.ДоступенКонтейнер = Ложь;
	ПараметрыОбработчика.СтруктураХраненияЗначения = ЭтотОбъект;
	ПараметрыОбработчика.Значение = ЗначениеКонстанты;
	ПараметрыОбработчика.ТекущееОписаниеТиповЗначения = ОписаниеТиповКонстанты;
	ПараметрыОбработчика.ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗначениеКонстантыНачалоВыбораЗавершение",
		ЭтотОбъект);
	УИ_ОбщегоНазначенияКлиент.ПолеФормыОбработчикНачалоВыбораЗначения(ПараметрыОбработчика, СтандартнаяОбработка);

