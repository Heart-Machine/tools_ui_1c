#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПраваПользователей

&НаКлиенте
Процедура ПраваПользователейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ПраваПользователей.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Уникальность - идентификатор пользователя: для каждого пользователя открывается своя форма.
	ПараметрыФормы = Новый Структура("РежимРаботы, ИдентификаторПользователяИБ", 0, ДанныеСтроки.Идентификатор);
	ОткрытьФорму("Обработка.УИ_НавигаторПоМетаданным.Форма.ФормаПользовательИБ", ПараметрыФормы, ЭтотОбъект,
		ДанныеСтроки.Идентификатор);

КонецПроцедуры

