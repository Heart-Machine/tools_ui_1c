#Область ОписаниеПеременных

&НаКлиенте
Перем КлючПоказанногоУзла;

&НаКлиенте
Перем КлючПоказанныхОбратныхСвязей;

&НаКлиенте
Перем УзлыСПравамиРолей;

&НаКлиенте
Перем КлючПоказанныхПравРолей;

&НаКлиенте
Перем КлючПоказанныхДанныхБазы;

&НаКлиенте
Перем СсылкиСОбратнымиСвязями;

&НаКлиенте
Перем ВидыПравРолиЗаполнены;

&НаКлиенте
Перем ВидПоказанныхПравРоли;

&НаКлиенте
Перем КлючПоказанныхРасширений;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Дерево отбора переносится до проверок, чтобы переданные данные не остались во временном хранилище.
	ИмяРасширения = Параметры.ИмяРасширения;
	ПеренестиДеревоОтбораКонфигураций(Параметры.АдресДереваОтбораКонфигураций);

	ПолноеИмяОбъекта = Параметры.ПолноеИмя;
	Если ПустаяСтрока(ПолноеИмяОбъекта) Или Не ЗаполнитьДанныеСвойств() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	УстановитьТекущийУзелКорень();
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Для Каждого КорневойУзел Из Состав.ПолучитьЭлементы() Цикл
		Элементы.Состав.Развернуть(КорневойУзел.ПолучитьИдентификатор());
	КонецЦикла;
	ПоказатьДанныеТекущегоУзла();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыУзлаПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаОбратныеСвязи Тогда
		// Индекс обратных связей строится по всей конфигурации, поэтому заполняется только при первом открытии страницы.
		Если Не ОбратныеСвязиЗаполнены Тогда
			ЗаполнитьОбратныеСвязи();
			КлючПоказанныхОбратныхСвязей = Неопределено;
			УзлыСПравамиРолей = Неопределено;
			СсылкиСОбратнымиСвязями = Неопределено;
		КонецЕсли;
		ПоказатьОбратныеСвязиТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРоли Тогда
		ПоказатьПраваРолейТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДанныеБазы Тогда
		ПоказатьДанныеБазыТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПраваРоли Тогда
		ПоказатьПраваРоли();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРасширения Тогда
		ПоказатьРасширенияТекущегоУзла();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСостав

&НаКлиенте
Процедура СоставПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("Подключаемый_ПоказатьДанныеТекущегоУзла");
	ПодключитьОбработчикОжидания("Подключаемый_ПоказатьДанныеТекущегоУзла", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СоставВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Узел-ссылка из состава подсистемы открывает свойства своего объекта.
	ДанныеСтроки = Состав.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено И ДанныеСтроки.ЭтоСсылка Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьСвойстваОбъекта(ДанныеСтроки.ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСвойства

&НаКлиенте
Процедура СвойстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Свойства.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Или ПустаяСтрока(ДанныеСтроки.Ссылки) Тогда
		Возврат;
	КонецЕсли;

	Ссылки = СтрРазделить(ДанныеСтроки.Ссылки, Символы.ПС, Ложь);
	Если Ссылки.Количество() = 1 Тогда
		ПерейтиКОбъектуМетаданных(Ссылки[0]);
		Возврат;
	КонецЕсли;

	СписокСсылок = Новый СписокЗначений;
	СписокСсылок.ЗагрузитьЗначения(Ссылки);
	Оповещение = Новый ОписаниеОповещения("ВыборСсылкиСвойстваЗавершение", ЭтотОбъект);
	ПоказатьВыборИзМеню(Оповещение, СписокСсылок, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭлементыСостава

&НаКлиенте
Процедура ЭлементыСоставаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ЭлементыСостава.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ЭлементыСоставаУсловноеРазделение И ЗначениеЗаполнено(ДанныеСтроки.УсловноеРазделение) Тогда
		ПерейтиКОбъектуМетаданных(ДанныеСтроки.УсловноеРазделение);
	Иначе
		ПерейтиКОбъектуМетаданных(ДанныеСтроки.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбратныеСвязи

&НаКлиенте
Процедура ОбратныеСвязиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ОбратныеСвязи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Или ПустаяСтрока(ДанныеСтроки.Объект) Тогда
		Возврат;
	КонецЕсли;
	ПерейтиКОбъектуМетаданных(ДанныеСтроки.Объект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПраваРолей

&НаКлиенте
Процедура ПраваРолейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ПраваРолей.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено Тогда
		ПерейтиКОбъектуМетаданных(ДанныеСтроки.Роль);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеБазы

&НаКлиенте
Процедура ДанныеБазыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = ДанныеБазы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено И Не ПустаяСтрока(ДанныеСтроки.НавигационнаяСсылка) Тогда
		СтандартнаяОбработка = Ложь;
		ПерейтиПоНавигационнойСсылке(ДанныеСтроки.НавигационнаяСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасширенияОбъекта

&НаКлиенте
Процедура РасширенияОбъектаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = РасширенияОбъекта.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено И Не ПустаяСтрока(ДанныеСтроки.ПолноеИмя) Тогда
		СтандартнаяОбработка = Ложь;
		ПерейтиКОбъектуМетаданных(ДанныеСтроки.ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВидыПравРоли

&НаКлиенте
Процедура ВидыПравРолиПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("Подключаемый_ПоказатьПраваРолиНаТекущийВид");
	ПодключитьОбработчикОжидания("Подключаемый_ПоказатьПраваРолиНаТекущийВид", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПраваРоли

&НаКлиенте
Процедура ПраваРолиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ПраваРоли.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено Тогда
		ПерейтиКОбъектуМетаданных(ДанныеСтроки.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьОбъектСписокМетаданных(Команда)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УИ_НавигаторПоМетаданнымКлиент.ОткрытьОбъектСписокМетаданных(ТекущиеДанные.ПолноеИмя, ЭтотОбъект,
		ТекущиеДанные.Синоним);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДинамическийСписок(Команда)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УИ_НавигаторПоМетаданнымКлиент.ОткрытьДинамическийСписок(ТекущиеДанные.ПолноеИмя);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКартуМаршрута(Команда)

	УИ_НавигаторПоМетаданнымКлиент.ПоказатьКартуМаршрута(ПолноеИмяОбъекта, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выделяет узел состава по полному имени объекта метаданных, если он есть в составе.
// Вызывается после ОткрытьФорму: так узел выделяется и в только что открытой, и в уже открытой форме.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, например Справочник.Номенклатура.Реквизит.Артикул
&НаКлиенте
Процедура ВыделитьЭлементСостава(ПолноеИмя) Экспорт

	ИдентификаторУзла = ИдентификаторУзлаСостава(Состав.ПолучитьЭлементы(), ПолноеИмя);
	Если ИдентификаторУзла <> Неопределено Тогда
		Элементы.Состав.ТекущаяСтрока = ИдентификаторУзла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПоказатьДанныеТекущегоУзла()

	ПоказатьДанныеТекущегоУзла();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанныеТекущегоУзла()

	УстановитьДоступностьКомандОткрытия();
	ПоказатьСвойстваТекущегоУзла();
	ТекущаяСтраница = Элементы.СтраницыУзла.ТекущаяСтраница;
	Если ТекущаяСтраница = Элементы.СтраницаОбратныеСвязи Тогда
		ПоказатьОбратныеСвязиТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРоли Тогда
		ПоказатьПраваРолейТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДанныеБазы Тогда
		ПоказатьДанныеБазыТекущегоУзла();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРасширения Тогда
		ПоказатьРасширенияТекущегоУзла();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасширенияТекущегоУзла()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ключ = КлючПоказанныхРасширений Тогда
		Возврат;
	КонецЕсли;
	КлючПоказанныхРасширений = ТекущиеДанные.Ключ;

	Если ТекущиеДанные.ЭтоКоллекция Тогда
		РасширенияОбъекта.ПолучитьЭлементы().Очистить();
		Пояснение = НСтр("ru = 'Выберите объект в составе, чтобы посмотреть расширения, которые его меняют.'");
	Иначе
		Пояснение = ЗаполнитьРасширенияОбъекта(ТекущиеДанные.Ключ);
	КонецЕсли;
	Элементы.РасширенияОбъекта.Видимость = ПустаяСтрока(Пояснение);
	Элементы.РасширенияОбъектаПояснение.Заголовок = Пояснение;
	Элементы.РасширенияОбъектаПояснение.Видимость = Не ПустаяСтрока(Пояснение);

	Для Каждого СтрокаРасширения Из РасширенияОбъекта.ПолучитьЭлементы() Цикл
		Элементы.РасширенияОбъекта.Развернуть(СтрокаРасширения.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

// Делает доступными команды открытия, если текущий узел состава - объект, который они открывают.
&НаКлиенте
Процедура УстановитьДоступностьКомандОткрытия()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	ПолноеИмяУзла = ?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.ПолноеИмя);
	Элементы.ОткрытьОбъектСписокМетаданных.Доступность =
		УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьОбъектСписокМетаданных(ПолноеИмяУзла);
	Элементы.ОткрытьДинамическийСписок.Доступность =
		УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьДинамическийСписок(ПолноеИмяУзла);

КонецПроцедуры

// Показывает права роли формы. Виды объектов с правами заполняются при первом открытии страницы:
// проверка прав на все объекты конфигурации занимает время.
&НаКлиенте
Процедура ПоказатьПраваРоли()

	Если ВидыПравРолиЗаполнены = Истина Тогда
		Возврат;
	КонецЕсли;
	ВидПоказанныхПравРоли = ЗаполнитьВидыПравРоли();
	ВидыПравРолиЗаполнены = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПоказатьПраваРолиНаТекущийВид()

	ТекущиеДанные = Элементы.ВидыПравРоли.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Вид = ВидПоказанныхПравРоли Тогда
		Возврат;
	КонецЕсли;
	ВидПоказанныхПравРоли = ТекущиеДанные.Вид;
	ЗаполнитьПраваРолиНаВид(ВидПоказанныхПравРоли);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанныеБазыТекущегоУзла()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ключ = КлючПоказанныхДанныхБазы Тогда
		Возврат;
	КонецЕсли;
	КлючПоказанныхДанныхБазы = ТекущиеДанные.Ключ;

	Если ТекущиеДанные.ЭтоКоллекция Тогда
		ДанныеБазы.ПолучитьЭлементы().Очистить();
		Пояснение = НСтр("ru = 'Выберите объект в составе, чтобы посмотреть его данные в базе.'");
	Иначе
		Пояснение = ЗаполнитьДанныеБазы(ТекущиеДанные.Ключ);
	КонецЕсли;
	Элементы.ДанныеБазы.Видимость = ПустаяСтрока(Пояснение);
	Элементы.ДанныеБазыПояснение.Заголовок = Пояснение;
	Элементы.ДанныеБазыПояснение.Видимость = Не ПустаяСтрока(Пояснение);

	// Группы раскрываются; единственная таблица хранения табличной части раскрывается вместе с группой.
	Для Каждого Группа Из ДанныеБазы.ПолучитьЭлементы() Цикл
		Элементы.ДанныеБазы.Развернуть(Группа.ПолучитьИдентификатор());
		ПодчиненныеСтроки = Группа.ПолучитьЭлементы();
		Если ПодчиненныеСтроки.Количество() = 1 И ПодчиненныеСтроки[0].ЭтоГруппа Тогда
			Элементы.ДанныеБазы.Развернуть(ПодчиненныеСтроки[0].ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПраваРолейТекущегоУзла()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ключ = КлючПоказанныхПравРолей Тогда
		Возврат;
	КонецЕсли;
	КлючПоказанныхПравРолей = ТекущиеДанные.Ключ;

	Если ТекущиеДанные.ЭтоКоллекция Тогда
		ПраваРолей.Очистить();
		Элементы.ПраваРолей.Видимость = Ложь;
		Элементы.ПраваРолейПояснение.Заголовок = НСтр("ru = 'Выберите объект в составе, чтобы посмотреть права ролей на него.'");
		Элементы.ПраваРолейПояснение.Видимость = Истина;
	Иначе
		ЗаполнитьПраваРолей(ТекущиеДанные.Ключ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОбратныеСвязиТекущегоУзла()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ключ = КлючПоказанныхОбратныхСвязей Тогда
		Возврат;
	КонецЕсли;
	КлючПоказанныхОбратныхСвязей = ТекущиеДанные.Ключ;
	ДобавитьОбратныеСвязиСсылки(ТекущиеДанные);
	ДобавитьПраваРолейУзла(ТекущиеДанные);

	ЭлементыСвязей = ОбратныеСвязи.ПолучитьЭлементы();
	ЭлементыСвязей.Очистить();

	ГруппаСвязей = Неопределено;
	ИмяГруппыСвязей = Неопределено;
	Отбор = Новый Структура("КлючУзла", КлючПоказанныхОбратныхСвязей);
	Для Каждого СтрокаСвязи Из ВсеОбратныеСвязи.НайтиСтроки(Отбор) Цикл
		Если СтрокаСвязи.ИмяГруппы <> ИмяГруппыСвязей Тогда
			ИмяГруппыСвязей = СтрокаСвязи.ИмяГруппы;
			ГруппаСвязей = ЭлементыСвязей.Добавить();
			ГруппаСвязей.Представление = СтрокаСвязи.Группа;
			ГруппаСвязей.ЭтоГруппа = Истина;
		КонецЕсли;
		НоваяСвязь = ГруппаСвязей.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСвязь, СтрокаСвязи, "Объект, Свойство, Картинка");
		НоваяСвязь.Представление = СтрокаСвязи.Объект;
	КонецЦикла;

	Для Каждого ГруппаСвязей Из ЭлементыСвязей Цикл
		КоличествоСвязей = ГруппаСвязей.ПолучитьЭлементы().Количество();
		ГруппаСвязей.Представление = СтрШаблон("%1 (%2)", ГруппаСвязей.Представление, КоличествоСвязей);
		Элементы.ОбратныеСвязи.Развернуть(ГруппаСвязей.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

// Добавляет к обратным связям узла роли, которые дают на него права. Права проверяются при первом показе узла:
// проверка всех узлов сразу заняла бы много времени у объектов с большим составом, например у конфигурации.
// Строки ролей добавляются в конец таблицы, поэтому группа ролей выводится последней.
//
// Параметры:
//  ДанныеУзла - ДанныеФормыЭлементДерева - строка дерева Состав
&НаКлиенте
Процедура ДобавитьПраваРолейУзла(ДанныеУзла)

	Если ДанныеУзла.ЭтоКоллекция Тогда
		Возврат;
	КонецЕсли;
	Если УзлыСПравамиРолей = Неопределено Тогда
		УзлыСПравамиРолей = Новый Соответствие;
	КонецЕсли;
	Если УзлыСПравамиРолей[ДанныеУзла.Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СвязиРолей = ПраваРолейУзла(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, ДанныеУзла.Ключ);
	Для Каждого СвязьРоли Из СвязиРолей Цикл
		ЗаполнитьЗначенияСвойств(ВсеОбратныеСвязи.Добавить(), СвязьРоли);
	КонецЦикла;
	УзлыСПравамиРолей.Вставить(ДанныеУзла.Ключ, Истина);

КонецПроцедуры

// Добавляет обратные связи узла-ссылки из состава подсистемы. Связи узлов-ссылок не заполняются вместе со связями
// остальных узлов: у большой подсистемы их было бы слишком много, поэтому они читаются при первом показе узла.
//
// Параметры:
//  ДанныеУзла - ДанныеФормыЭлементДерева - строка дерева Состав
&НаКлиенте
Процедура ДобавитьОбратныеСвязиСсылки(ДанныеУзла)

	Если Не ДанныеУзла.ЭтоСсылка Тогда
		Возврат;
	КонецЕсли;
	Если СсылкиСОбратнымиСвязями = Неопределено Тогда
		СсылкиСОбратнымиСвязями = Новый Соответствие;
	КонецЕсли;
	Если СсылкиСОбратнымиСвязями[ДанныеУзла.Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Связи = ОбратныеСвязиСсылки(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, ДанныеУзла.Ключ);
	Для Каждого Связь Из Связи Цикл
		ЗаполнитьЗначенияСвойств(ВсеОбратныеСвязи.Добавить(), Связь);
	КонецЦикла;
	СсылкиСОбратнымиСвязями.Вставить(ДанныеУзла.Ключ, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСвойстваТекущегоУзла()

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Ключ = КлючПоказанногоУзла Тогда
		Возврат;
	КонецЕсли;
	КлючПоказанногоУзла = ТекущиеДанные.Ключ;
	Если ТекущиеДанные.ЭтоСсылка Тогда
		ЗагрузитьСвойстваСсылки(КлючПоказанногоУзла);
	КонецЕсли;

	ЭлементыСвойств = Свойства.ПолучитьЭлементы();
	ЭлементыСвойств.Очистить();

	ГруппаСвойств = Неопределено;
	ИмяГруппыСвойств = Неопределено;
	Для Каждого СтрокаСвойства Из ВсеСвойства.НайтиСтроки(Новый Структура("КлючУзла", КлючПоказанногоУзла)) Цикл
		Если СтрокаСвойства.ИмяГруппы <> ИмяГруппыСвойств Тогда
			ИмяГруппыСвойств = СтрокаСвойства.ИмяГруппы;
			ГруппаСвойств = ЭлементыСвойств.Добавить();
			ГруппаСвойств.Имя = СтрокаСвойства.Группа;
			ГруппаСвойств.ЭтоГруппа = Истина;
		КонецЕсли;
		НовоеСвойство = ГруппаСвойств.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НовоеСвойство, СтрокаСвойства, "Имя, Значение, Ссылки");
	КонецЦикла;

	Для Каждого ГруппаСвойств Из ЭлементыСвойств Цикл
		Элементы.Свойства.Развернуть(ГруппаСвойств.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

// Загружает свойства объекта, на который ссылается узел состава подсистемы. Свойства узлов-ссылок читаются
// при первом показе узла, чтобы большая подсистема не замедляла открытие формы.
//
// Параметры:
//  КлючУзла - Строка - ключ узла-ссылки, полное имя объекта
&НаКлиенте
Процедура ЗагрузитьСвойстваСсылки(КлючУзла)

	// У любого объекта есть хотя бы свойство Имя, поэтому строки свойств есть только у загруженных узлов.
	Если ВсеСвойства.НайтиСтроки(Новый Структура("КлючУзла", КлючУзла)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаСвойства Из СвойстваСсылки(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, КлючУзла) Цикл
		ЗаполнитьЗначенияСвойств(ВсеСвойства.Добавить(), СтрокаСвойства);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыборСсылкиСвойстваЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПерейтиКОбъектуМетаданных(ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

// Выделяет объект в составе, если он входит в текущий объект, иначе открывает свойства его объекта
// верхнего уровня и выделяет объект там. Уже открытую форму того же объекта платформа находит
// по ключевому параметру ПолноеИмя и активизирует.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
&НаКлиенте
Процедура ПерейтиКОбъектуМетаданных(ПолноеИмя)

	ИдентификаторУзла = ИдентификаторУзлаСостава(Состав.ПолучитьЭлементы(), ПолноеИмя);
	Если ИдентификаторУзла <> Неопределено Тогда
		Элементы.Состав.ТекущаяСтрока = ИдентификаторУзла;
	Иначе
		ОткрытьСвойстваОбъекта(ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

// Открывает свойства объекта верхнего уровня, которому принадлежит объект, и выделяет объект в их составе.
// Уже открытую форму того же объекта платформа находит по ключевому параметру ПолноеИмя и активизирует.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
&НаКлиенте
Процедура ОткрытьСвойстваОбъекта(ПолноеИмя)

	ПолноеИмяВерхнегоУровня = ПолноеИмяОбъектаВерхнегоУровня(ПолноеИмя);
	Если ПустаяСтрока(ПолноеИмяВерхнегоУровня) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ПолноеИмя", ПолноеИмяВерхнегоУровня);
	ПараметрыОткрытия.Вставить("АдресДереваОтбораКонфигураций", КопияДереваОтбораКонфигураций());
	ПараметрыОткрытия.Вставить("ИмяРасширения", ИмяРасширения);
	ФормаСвойств = ОткрытьФорму("Обработка.УИ_НавигаторПоМетаданным.Форма.ФормаСвойстваОбъекта", ПараметрыОткрытия);
	Если ФормаСвойств <> Неопределено Тогда
		ФормаСвойств.ВыделитьЭлементСостава(ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

// Возвращает идентификатор узла состава по ключу или Неопределено.
//
// Параметры:
//  ЭлементыУзлов - ДанныеФормыКоллекцияЭлементовДерева - узлы состава
//  Ключ - Строка - ключ узла (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор узла
&НаКлиентеНаСервереБезКонтекста
Функция ИдентификаторУзлаСостава(ЭлементыУзлов, Ключ)

	ИдентификаторУзла = Неопределено;
	Для Каждого Узел Из ЭлементыУзлов Цикл
		Если Узел.Ключ = Ключ Тогда
			ИдентификаторУзла = Узел.ПолучитьИдентификатор();
		Иначе
			ИдентификаторУзла = ИдентификаторУзлаСостава(Узел.ПолучитьЭлементы(), Ключ);
		КонецЕсли;
		Если ИдентификаторУзла <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ИдентификаторУзла;

КонецФункции

// Возвращает полное имя объекта верхнего уровня: Справочник.Номенклатура для Справочник.Номенклатура.Реквизит.Артикул.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Строка - полное имя объекта верхнего уровня, пустая строка, если имя некорректное
&НаКлиентеНаСервереБезКонтекста
Функция ПолноеИмяОбъектаВерхнегоУровня(ПолноеИмя)

	ПолноеИмяВерхнегоУровня = "";
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если ЧастиИмени.Количество() >= 2 Тогда
		ПолноеИмяВерхнегоУровня = СтрШаблон("%1.%2", ЧастиИмени[0], ЧастиИмени[1]);
	КонецЕсли;
	Возврат ПолноеИмяВерхнегоУровня;

КонецФункции

// Переносит дерево отбора конфигураций из переданного адреса во временное хранилище этой формы
// и удаляет переданные данные, чтобы они не копились. Копия формы очищается при ее закрытии.
//
// Параметры:
//  АдресПереданногоДерева - Строка - адрес дерева отбора конфигураций из параметров формы
&НаСервере
Процедура ПеренестиДеревоОтбораКонфигураций(АдресПереданногоДерева)

	Если Не ЭтоАдресВременногоХранилища(АдресПереданногоДерева) Тогда
		Возврат;
	КонецЕсли;

	ДеревоОтбораКонфигураций = ПолучитьИзВременногоХранилища(АдресПереданногоДерева);
	УдалитьИзВременногоХранилища(АдресПереданногоДерева);
	Если ДеревоОтбораКонфигураций <> Неопределено Тогда
		ОставитьВОтбореРасширение(ДеревоОтбораКонфигураций, ИмяРасширения);
		АдресДереваОтбораКонфигураций = ПоместитьВоВременноеХранилище(ДеревоОтбораКонфигураций, УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

// Оставляет в дереве отбора конфигураций отмеченным только расширение, к которому относится объект формы.
// Объекты разных расширений могут называться одинаково, а поиск идет по всем отмеченным расширениям.
// Отбор разбирается так же, как в навигаторе: учитывается первая конфигурация, в которой что-то отмечено.
//
// Параметры:
//  ДеревоОтбораКонфигураций - ДеревоЗначений - дерево отбора конфигураций навигатора
//  ИмяРасширения - Строка - имя расширения; если пустое, отбор не меняется
&НаСервереБезКонтекста
Процедура ОставитьВОтбореРасширение(ДеревоОтбораКонфигураций, ИмяРасширения)

	Если ПустаяСтрока(ИмяРасширения) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаКонфигурации Из ДеревоОтбораКонфигураций.Строки Цикл
		Если СтрокаКонфигурации.Пометка = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Пометка 2 - отмечены отдельные расширения, а не вся конфигурация.
		Если СтрокаКонфигурации.Пометка = 2 Тогда
			Для Каждого СтрокаРасширения Из СтрокаКонфигурации.Строки Цикл
				СтрокаРасширения.Пометка = ?(СтрокаРасширения.Имя = ИмяРасширения, 1, 0);
			КонецЦикла;
		КонецЕсли;
		Прервать;
	КонецЦикла;

КонецПроцедуры

// Возвращает адрес копии дерева отбора конфигураций для открываемой формы свойств.
// Открытая форма удаляет копию; если форма уже была открыта, копия очистится при закрытии этой формы.
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище или пустая строка
&НаСервере
Функция КопияДереваОтбораКонфигураций()

	АдресКопии = "";
	Если ЭтоАдресВременногоХранилища(АдресДереваОтбораКонфигураций) Тогда
		ДеревоОтбораКонфигураций = ПолучитьИзВременногоХранилища(АдресДереваОтбораКонфигураций);
		АдресКопии = ПоместитьВоВременноеХранилище(ДеревоОтбораКонфигураций, УникальныйИдентификатор);
	КонецЕсли;
	Возврат АдресКопии;

КонецФункции

// Заполняет состав и свойства объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если объект найден и данные заполнены
&НаСервере
Функция ЗаполнитьДанныеСвойств()

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	ДанныеЗаполнены = (Найденный.ОбъектМетаданных <> Неопределено);
	Если ДанныеЗаполнены Тогда
		// Расширение показывается, если объект найден в нем, а не в основной конфигурации.
		Если ЗначениеЗаполнено(ИмяРасширения) И Найденный.МетаданныеКонфигурации.Имя = ИмяРасширения Тогда
			Заголовок = СтрШаблон(НСтр("ru = 'Свойства: %1 (%2)'"), ПолноеИмяОбъекта, ИмяРасширения);
		Иначе
			Заголовок = СтрШаблон(НСтр("ru = 'Свойства: %1'"), ПолноеИмяОбъекта);
		КонецЕсли;
		Данные = УИ_НавигаторПоМетаданным.ДанныеСвойствОбъекта(Найденный.ОбъектМетаданных,
															  Найденный.МетаданныеКонфигурации,
															  Найденный.КлючКэша);
		Картинки = КартинкиВидовМетаданных();
		ДеревоСостава = Данные.Состав;
		ДеревоСостава.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		ДеревоСостава.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
		ЗаполнитьПредставлениеСостава(ДеревоСостава.Строки, Картинки);

		ЗначениеВРеквизитФормы(ДеревоСостава, "Состав");
		ЗначениеВРеквизитФормы(Данные.Свойства, "ВсеСвойства");
		ЗаполнитьЭлементыСостава(Данные.ЭлементыСостава, Картинки);
		УстановитьВидимостьЭлементовОбъекта(Найденный, ДеревоСостава.Строки);
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не найден объект метаданных ""%1"".'"), ПолноеИмяОбъекта);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	Возврат ДанныеЗаполнены;

КонецФункции

// Показывает команды открытия, если объект формы из метаданных текущего сеанса и в его составе есть объекты,
// которые они открывают, карту маршрута, если объект формы - бизнес-процесс текущего сеанса, и страницу прав,
// если объект формы - роль текущего сеанса.
//
// Параметры:
//  Найденный - см. УИ_НавигаторПоМетаданным.НайтиОбъектМетаданных
//  СтрокиСостава - КоллекцияСтрокДереваЗначений - узлы состава, см. УИ_НавигаторПоМетаданным.ДанныеСвойствОбъекта
&НаСервере
Процедура УстановитьВидимостьЭлементовОбъекта(Найденный, СтрокиСостава)

	ЭтоОбъектСеанса = УИ_НавигаторПоМетаданным.ЭтоОбъектМетаданныхСеанса(Найденный, ПолноеИмяОбъекта);
	Элементы.ОткрытьОбъектСписокМетаданных.Видимость = ЭтоОбъектСеанса И ЕстьОткрываемыеУзлы(СтрокиСостава, Ложь);
	Элементы.ОткрытьДинамическийСписок.Видимость = ЭтоОбъектСеанса И ЕстьОткрываемыеУзлы(СтрокиСостава, Истина);
	Элементы.ПоказатьКартуМаршрута.Видимость = ЭтоОбъектСеанса
		И УИ_НавигаторПоМетаданнымКлиентСервер.МожноПоказатьКартуМаршрута(ПолноеИмяОбъекта);
	Элементы.СтраницаПраваРоли.Видимость = ЭтоОбъектСеанса И СтрРазделить(ПолноеИмяОбъекта, ".")[0] = "Роль";

КонецПроцедуры

// Проверяет, есть ли в составе объекты, которые открывает команда открытия.
//
// Параметры:
//  СтрокиСостава - КоллекцияСтрокДереваЗначений - узлы состава
//  ДинамическийСписок - Булево - Истина для команды открытия динамического списка
//
// Возвращаемое значение:
//  Булево - Истина, если такой объект есть
&НаСервереБезКонтекста
Функция ЕстьОткрываемыеУзлы(СтрокиСостава, ДинамическийСписок)

	Результат = Ложь;
	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		Если ДинамическийСписок Тогда
			МожноОткрыть = УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьДинамическийСписок(СтрокаСостава.ПолноеИмя);
		Иначе
			МожноОткрыть = УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьОбъектСписокМетаданных(СтрокаСостава.ПолноеИмя);
		КонецЕсли;
		Если МожноОткрыть Или ЕстьОткрываемыеУзлы(СтрокаСостава.Строки, ДинамическийСписок) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заполняет таблицу состава общего реквизита или плана обмена и показывает ее колонки по виду объекта.
//
// Параметры:
//  ТаблицаЭлементов - см. УИ_НавигаторПоМетаданным.ДанныеСвойствОбъекта
//  Картинки - см. КартинкиВидовМетаданных
&НаСервере
Процедура ЗаполнитьЭлементыСостава(ТаблицаЭлементов, Картинки)

	ЕстьУсловноеРазделение = Ложь;
	Для Каждого СтрокаЭлемента Из ТаблицаЭлементов Цикл
		НоваяСтрока = ЭлементыСостава.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЭлемента);
		Картинка = Картинки[СтрокаЭлемента.Вид];
		Если Картинка <> Неопределено Тогда
			НоваяСтрока.Картинка = Картинка;
		КонецЕсли;
		ЕстьУсловноеРазделение = ЕстьУсловноеРазделение Или ЗначениеЗаполнено(СтрокаЭлемента.УсловноеРазделение);
	КонецЦикла;

	УзлыСостава = Состав.ПолучитьЭлементы();
	ЭтоОбщийРеквизит = (УзлыСостава.Количество() > 0 И УзлыСостава[0].Вид = "ОбщийРеквизит");
	Элементы.СтраницаЭлементыСостава.Видимость = (ЭлементыСостава.Количество() > 0);
	Элементы.ЭлементыСоставаИспользование.Видимость = ЭтоОбщийРеквизит;
	Элементы.ЭлементыСоставаУсловноеРазделение.Видимость = ЕстьУсловноеРазделение;
	Элементы.ЭлементыСоставаАвторегистрация.Видимость = Не ЭтоОбщийРеквизит;

КонецПроцедуры

// Заполняет дерево расширений, которые заимствуют или добавляют объект узла.
//
// Параметры:
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Строка - пояснение, почему расширений нет; пустая строка, если они есть
&НаСервере
Функция ЗаполнитьРасширенияОбъекта(КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	Расширения = УИ_НавигаторПоМетаданным.РасширенияОбъекта(Найденный, КлючУзла);
	Дерево = Расширения.Дерево;
	Дерево.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	ЗаполнитьКартинкиРасширений(Дерево.Строки, КартинкиВидовМетаданных());
	ЗначениеВРеквизитФормы(Дерево, "РасширенияОбъекта");
	Возврат Расширения.Пояснение;

КонецФункции

// Заполняет картинки дерева расширений: у расширения - картинка конфигурации, у коллекции - картинка
// ее элементов, у объекта - картинка его вида.
//
// Параметры:
//  СтрокиДерева - КоллекцияСтрокДереваЗначений - строки дерева расширений
//  Картинки - см. КартинкиВидовМетаданных
&НаСервереБезКонтекста
Процедура ЗаполнитьКартинкиРасширений(СтрокиДерева, Картинки)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ВидКартинкиСтроки = СтрокаДерева.Вид;
		Если СтрокаДерева.Вид = "Расширение" Тогда
			ВидКартинкиСтроки = "Конфигурация";
		ИначеЕсли СтрокаДерева.ЭтоГруппа И СтрокаДерева.Строки.Количество() > 0 Тогда
			ВидКартинкиСтроки = СтрокаДерева.Строки[0].Вид;
		КонецЕсли;
		Картинка = Картинки[ВидКартинкиСтроки];
		Если Картинка <> Неопределено Тогда
			СтрокаДерева.Картинка = Картинка;
		КонецЕсли;
		ЗаполнитьКартинкиРасширений(СтрокаДерева.Строки, Картинки);
	КонецЦикла;

КонецПроцедуры

// Заполняет данные базы по узлу состава.
//
// Параметры:
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Строка - пояснение, почему данных нет; пустая строка, если данные есть
&НаСервере
Функция ЗаполнитьДанныеБазы(КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	ДанныеБазыУзла = УИ_НавигаторПоМетаданным.ДанныеБазыУзла(Найденный, КлючУзла);
	ЗначениеВРеквизитФормы(ДанныеБазыУзла.Дерево, "ДанныеБазы");
	Пояснение = ДанныеБазыУзла.Пояснение;
	Возврат Пояснение;

КонецФункции

// Заполняет обратные связи всех узлов состава.
&НаСервере
Процедура ЗаполнитьОбратныеСвязи()

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);

	КлючиУзлов = Новый Массив;
	ДобавитьКлючиУзлов(Состав.ПолучитьЭлементы(), КлючиУзлов);
	Связи = УИ_НавигаторПоМетаданным.ОбратныеСвязиУзлов(Найденный, КлючиУзлов);
	ДобавитьКартинкиСвязей(Связи);

	ЗначениеВРеквизитФормы(Связи, "ВсеОбратныеСвязи");
	ОбратныеСвязиЗаполнены = Истина;

КонецПроцедуры

// Возвращает обратные связи узла-ссылки из состава подсистемы в виде строк таблицы ВсеОбратныеСвязи.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта формы
//  АдресДереваОтбораКонфигураций - Строка - адрес дерева отбора конфигураций во временном хранилище
//  КлючУзла - Строка - ключ узла-ссылки, полное имя объекта
//
// Возвращаемое значение:
//  Массив из Структура - строки с колонками таблицы ВсеОбратныеСвязи
&НаСервереБезКонтекста
Функция ОбратныеСвязиСсылки(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	КлючиУзлов = Новый Массив;
	КлючиУзлов.Добавить(КлючУзла);
	Связи = УИ_НавигаторПоМетаданным.ОбратныеСвязиУзлов(Найденный, КлючиУзлов);
	ДобавитьКартинкиСвязей(Связи);
	Результат = УИ_ОбщегоНазначения.ТаблицаЗначенийВМассив(Связи);
	Возврат Результат;

КонецФункции

// Добавляет к обратным связям колонку Картинка: она показывает вид объекта верхнего уровня,
// который ссылается на узел.
//
// Параметры:
//  Связи - см. УИ_НавигаторПоМетаданным.ОбратныеСвязиУзлов
&НаСервереБезКонтекста
Процедура ДобавитьКартинкиСвязей(Связи)

	Связи.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	Картинки = КартинкиВидовМетаданных();
	Для Каждого СтрокаСвязи Из Связи Цикл
		ЧастиИмени = СтрРазделить(СтрокаСвязи.Объект, ".");
		Картинка = Картинки[ЧастиИмени[0]];
		Если Картинка <> Неопределено Тогда
			СтрокаСвязи.Картинка = Картинка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает свойства объекта, на который ссылается узел состава подсистемы, в виде строк таблицы ВсеСвойства.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта формы
//  АдресДереваОтбораКонфигураций - Строка - адрес дерева отбора конфигураций во временном хранилище
//  КлючУзла - Строка - ключ узла-ссылки, полное имя объекта
//
// Возвращаемое значение:
//  Массив из Структура - строки с колонками таблицы ВсеСвойства
&НаСервереБезКонтекста
Функция СвойстваСсылки(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	Свойства = УИ_НавигаторПоМетаданным.СвойстваОбъекта(Найденный, КлючУзла);
	Результат = УИ_ОбщегоНазначения.ТаблицаЗначенийВМассив(Свойства);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьКлючиУзлов(ЭлементыУзлов, КлючиУзлов)

	Для Каждого Узел Из ЭлементыУзлов Цикл
		// Связи узлов-ссылок читаются при их показе, см. ДобавитьОбратныеСвязиСсылки.
		Если Не Узел.ЭтоКоллекция И Не Узел.ЭтоСсылка Тогда
			КлючиУзлов.Добавить(Узел.Ключ);
		КонецЕсли;
		ДобавитьКлючиУзлов(Узел.ПолучитьЭлементы(), КлючиУзлов);
	КонецЦикла;

КонецПроцедуры

// Возвращает роли, которые дают права на узел состава, в виде строк таблицы ВсеОбратныеСвязи.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта формы
//  АдресДереваОтбораКонфигураций - Строка - адрес дерева отбора конфигураций во временном хранилище
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Массив из Структура - строки с колонками таблицы ВсеОбратныеСвязи
&НаСервереБезКонтекста
Функция ПраваРолейУзла(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций, КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	СвязиРолей = УИ_НавигаторПоМетаданным.ПраваРолейУзла(Найденный, КлючУзла);
	СвязиРолей.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	СвязиРолей.ЗаполнитьЗначения(КартинкиВидовМетаданных()["Роль"], "Картинка");
	Результат = УИ_ОбщегоНазначения.ТаблицаЗначенийВМассив(СвязиРолей);
	Возврат Результат;

КонецФункции

// Заполняет таблицу прав ролей на узел состава.
//
// Параметры:
//  КлючУзла - Строка - ключ узла состава
&НаСервере
Процедура ЗаполнитьПраваРолей(КлючУзла)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	ПраваРолейОбъекта = УИ_НавигаторПоМетаданным.ПраваРолейНаОбъект(Найденный, КлючУзла);
	КолонкиПравРолей = УстановитьКолонкиПрав("ПраваРолей", ПраваРолейОбъекта.Права, КолонкиПравРолей);

	ПраваРолей.Очистить();
	КартинкаРоли = КартинкиВидовМетаданных()["Роль"];
	Для Каждого СтрокаРоли Из ПраваРолейОбъекта.Роли Цикл
		НоваяСтрока = ПраваРолей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРоли);
		НоваяСтрока.Представление = СтрРазделить(СтрокаРоли.Роль, ".")[1];
		НоваяСтрока.Картинка = КартинкаРоли;
	КонецЦикла;

	Элементы.ПраваРолей.Видимость = (ПраваРолейОбъекта.Права.Количество() > 0);
	Элементы.ПраваРолейГруппаОграниченияУсловием.Видимость = ПраваРолейОбъекта.ПроверяетсяОграничениеУсловием;
	Элементы.ПраваРолейПояснение.Заголовок = ПраваРолейОбъекта.Пояснение;
	Элементы.ПраваРолейПояснение.Видимость = Не ПустаяСтрока(ПраваРолейОбъекта.Пояснение);

КонецПроцедуры

// Заполняет виды объектов, на которые роль формы дает права, и права на объекты первого вида.
//
// Возвращаемое значение:
//  Строка - вид, права на объекты которого показаны; пустая строка, если роль не дает прав
&НаСервере
Функция ЗаполнитьВидыПравРоли()

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	Виды = УИ_НавигаторПоМетаданным.ВидыОбъектовСПравамиРоли(Найденный, ПолноеИмяОбъекта);
	Картинки = КартинкиВидовМетаданных();
	ВидыПравРоли.Очистить();
	Для Каждого ОписаниеВида Из Виды Цикл
		НоваяСтрока = ВидыПравРоли.Добавить();
		НоваяСтрока.Вид = ОписаниеВида.Вид;
		НоваяСтрока.Представление = СтрШаблон("%1 (%2)", ОписаниеВида.Представление, ОписаниеВида.Количество);
		Картинка = Картинки[ОписаниеВида.Вид];
		Если Картинка <> Неопределено Тогда
			НоваяСтрока.Картинка = Картинка;
		КонецЕсли;
	КонецЦикла;

	ПоказанныйВид = "";
	ЕстьПрава = (ВидыПравРоли.Количество() > 0);
	Элементы.ГруппаПраваРоли.Видимость = ЕстьПрава;
	Элементы.ПраваРолиПояснение.Видимость = Не ЕстьПрава;
	Если ЕстьПрава Тогда
		Элементы.ВидыПравРоли.ТекущаяСтрока = ВидыПравРоли[0].ПолучитьИдентификатор();
		ПоказанныйВид = ВидыПравРоли[0].Вид;
		ЗаполнитьПраваРолиНаВид(ПоказанныйВид);
	Иначе
		Элементы.ПраваРолиПояснение.Заголовок = НСтр("ru = 'Роль не дает прав ни на один объект конфигурации.'");
	КонецЕсли;
	Возврат ПоказанныйВид;

КонецФункции

// Заполняет таблицу прав роли формы на объекты одного вида.
//
// Параметры:
//  Вид - Строка - вид объектов, см. УИ_НавигаторПоМетаданным.ВидыОбъектовСПравамиРоли
&НаСервере
Процедура ЗаполнитьПраваРолиНаВид(Вид)

	Найденный = НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций);
	ПраваОбъектов = УИ_НавигаторПоМетаданным.ПраваРолиНаОбъектыВида(Найденный, ПолноеИмяОбъекта, Вид);
	КолонкиПравРоли = УстановитьКолонкиПрав("ПраваРоли", ПраваОбъектов.Права, КолонкиПравРоли);

	ПраваРоли.Очистить();
	КартинкаВида = КартинкиВидовМетаданных()[Вид];
	Для Каждого СтрокаОбъекта Из ПраваОбъектов.Объекты Цикл
		НоваяСтрока = ПраваРоли.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбъекта);
		НоваяСтрока.Представление = ПредставлениеОбъектаПравРоли(СтрокаОбъекта.Объект);
		Если КартинкаВида <> Неопределено Тогда
			НоваяСтрока.Картинка = КартинкаВида;
		КонецЕсли;
	КонецЦикла;
	Элементы.ПраваРолиГруппаОграниченияУсловием.Видимость = ПраваОбъектов.ПроверяетсяОграничениеУсловием;

КонецПроцедуры

// Возвращает представление объекта в таблице прав роли: имена объекта и его владельцев без видов,
// например Валюты для Справочник.Валюты или Обмен.ПолучитьДанные для операции web-сервиса.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Строка - представление объекта
&НаСервереБезКонтекста
Функция ПредставлениеОбъектаПравРоли(ПолноеИмя)

	Имена = Новый Массив;
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Для Индекс = 0 По ЧастиИмени.ВГраница() Цикл
		Если Индекс % 2 = 1 Тогда
			Имена.Добавить(ЧастиИмени[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Представление = СтрСоединить(Имена, ".");
	Возврат Представление;

КонецФункции

// Пересоздает колонки прав в таблице прав. Набор прав зависит от вида объекта, поэтому колонки создаются
// при показе данных и остаются прежними, пока набор прав не изменится.
// У поля флажка нет свойства Ширина, поэтому каждая колонка права помещается в свою группу колонок,
// и ширина задается группе.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы формы и ее реквизита: ПраваРолей или ПраваРоли
//  Права - см. УИ_НавигаторПоМетаданным.ПраваРолейНаОбъект
//  ТекущиеКолонкиПрав - Строка - имена прав текущих колонок через запятую
//
// Возвращаемое значение:
//  Строка - имена прав новых колонок через запятую
&НаСервере
Функция УстановитьКолонкиПрав(ИмяТаблицы, Права, ТекущиеКолонкиПрав)

	ИменаПрав = Новый Массив;
	Для Каждого ОписаниеПрава Из Права Цикл
		ИменаПрав.Добавить(ОписаниеПрава.Имя);
	КонецЦикла;
	НовыеКолонкиПрав = СтрСоединить(ИменаПрав, ",");
	Если НовыеКолонкиПрав = ТекущиеКолонкиПрав Тогда
		Возврат НовыеКолонкиПрав;
	КонецЕсли;

	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ИмяПрава Из СтрРазделить(ТекущиеКолонкиПрав, ",", Ложь) Цикл
		Элементы.Удалить(Элементы[ИмяГруппыКолонкиПрава(ИмяТаблицы, ИмяПрава)]);
		УдаляемыеРеквизиты.Добавить(СтрШаблон("%1.%2", ИмяТаблицы, ИмяПрава));
	КонецЦикла;

	ДобавляемыеРеквизиты = Новый Массив;
	ТипБулево = Новый ОписаниеТипов("Булево");
	Для Каждого ОписаниеПрава Из Права Цикл
		НовыйРеквизит = Новый РеквизитФормы(ОписаниеПрава.Имя, ТипБулево, ИмяТаблицы, ОписаниеПрава.Представление);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);

	Таблица = Элементы[ИмяТаблицы];
	ВысотаШапки = Таблица.ВысотаШапки;
	Для Каждого ОписаниеПрава Из Права Цикл
		Группа = Элементы.Добавить(ИмяГруппыКолонкиПрава(ИмяТаблицы, ОписаниеПрава.Имя), Тип("ГруппаФормы"), Таблица);
		Группа.Вид = ВидГруппыФормы.ГруппаКолонок;
		Группа.Группировка = ГруппировкаКолонок.Горизонтальная;
		Группа.ОтображатьВШапке = Ложь;
		Группа.Ширина = ШиринаКолонкиПоЗаголовку(ОписаниеПрава.Представление, ВысотаШапки);
		Группа.РастягиватьПоГоризонтали = Ложь;

		Колонка = Элементы.Добавить(ИмяКолонкиПрава(ИмяТаблицы, ОписаниеПрава.Имя), Тип("ПолеФормы"), Группа);
		Колонка.Вид = ВидПоляФормы.ПолеФлажка;
		Колонка.ПутьКДанным = СтрШаблон("%1.%2", ИмяТаблицы, ОписаниеПрава.Имя);
		Колонка.Подсказка = ОписаниеПрава.Представление;
		Колонка.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Лево;
	КонецЦикла;
	Возврат НовыеКолонкиПрав;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяКолонкиПрава(ИмяТаблицы, ИмяПрава)

	ИмяКолонки = СтрШаблон("%1Право%2", ИмяТаблицы, ИмяПрава);
	Возврат ИмяКолонки;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяГруппыКолонкиПрава(ИмяТаблицы, ИмяПрава)

	ИмяГруппы = СтрШаблон("%1ГруппаПрава%2", ИмяТаблицы, ИмяПрава);
	Возврат ИмяГруппы;

КонецФункции

// Подбирает ширину колонки, при которой заголовок переносится по словам не более чем на заданное число строк.
//
// Параметры:
//  Заголовок - Строка - заголовок колонки
//  ВысотаШапки - Число - число строк в шапке таблицы
//
// Возвращаемое значение:
//  Число - ширина колонки в символах
&НаСервереБезКонтекста
Функция ШиринаКолонкиПоЗаголовку(Заголовок, ВысотаШапки)

	Слова = СтрРазделить(Заголовок, " ", Ложь);
	Ширина = 0;
	Для Каждого Слово Из Слова Цикл
		Ширина = Макс(Ширина, СтрДлина(Слово));
	КонецЦикла;
	Пока КоличествоСтрокЗаголовка(Слова, Ширина) > ВысотаШапки Цикл
		Ширина = Ширина + 1;
	КонецЦикла;

	// Запас на поля ячейки шапки.
	Ширина = Ширина + 1;
	Возврат Ширина;

КонецФункции

&НаСервереБезКонтекста
Функция КоличествоСтрокЗаголовка(Слова, Ширина)

	КоличествоСтрок = 0;
	ДлинаСтроки = 0;
	Для Каждого Слово Из Слова Цикл
		Если КоличествоСтрок > 0 И ДлинаСтроки + 1 + СтрДлина(Слово) <= Ширина Тогда
			ДлинаСтроки = ДлинаСтроки + 1 + СтрДлина(Слово);
		Иначе
			КоличествоСтрок = КоличествоСтрок + 1;
			ДлинаСтроки = СтрДлина(Слово);
		КонецЕсли;
	КонецЦикла;
	Возврат КоличествоСтрок;

КонецФункции

// Находит объект формы среди конфигураций, отмеченных в дереве отбора навигатора.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта формы
//  АдресДереваОтбораКонфигураций - Строка - адрес дерева отбора конфигураций во временном хранилище
//
// Возвращаемое значение:
//  см. УИ_НавигаторПоМетаданным.НайтиОбъектМетаданных
&НаСервереБезКонтекста
Функция НайтиОбъектМетаданныхФормы(ПолноеИмяОбъекта, АдресДереваОтбораКонфигураций)

	ДеревоОтбораКонфигураций = Неопределено;
	Если ЭтоАдресВременногоХранилища(АдресДереваОтбораКонфигураций) Тогда
		ДеревоОтбораКонфигураций = ПолучитьИзВременногоХранилища(АдресДереваОтбораКонфигураций);
	КонецЕсли;
	Найденный = УИ_НавигаторПоМетаданным.НайтиОбъектМетаданных(ПолноеИмяОбъекта, ДеревоОтбораКонфигураций);
	Возврат Найденный;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПредставлениеСостава(СтрокиСостава, Картинки)

	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		Если СтрокаСостава.ЭтоКоллекция Тогда
			СтрокаСостава.Представление = СтрШаблон("%1 (%2)", СтрокаСостава.Синоним, СтрокаСостава.Количество);
		Иначе
			СтрокаСостава.Представление = СтрокаСостава.Имя;
		КонецЕсли;

		ВидКартинкиУзла = СтрокаСостава.Вид;
		Если СтрокаСостава.ЭтоКоллекция И СтрокаСостава.Строки.Количество() > 0 Тогда
			// Коллекция показывается картинкой своих элементов.
			ВидКартинкиУзла = СтрокаСостава.Строки[0].Вид;
		КонецЕсли;
		Картинка = Картинки[ВидКартинкиУзла];
		Если Картинка <> Неопределено Тогда
			СтрокаСостава.Картинка = Картинка;
		КонецЕсли;

		ЗаполнитьПредставлениеСостава(СтрокаСостава.Строки, Картинки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьТекущийУзелКорень()

	Узлы = Состав.ПолучитьЭлементы();
	Если Узлы.Количество() > 0 Тогда
		Элементы.Состав.ТекущаяСтрока = Узлы[0].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	// Группы свойств выделяются жирным шрифтом.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.СвойстваИмя.Имя);
	ДобавитьПолеОформления(ЭлементОформления, Элементы.СвойстваЗначение.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Свойства.ЭтоГруппа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Значения со ссылками на объекты метаданных подчеркиваются: по двойному щелчку к ним можно перейти.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.СвойстваЗначение.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Свойства.Ссылки");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , , , Истина));

	// Группы обратных связей выделяются жирным шрифтом.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ОбратныеСвязиПредставление.Имя);
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ОбратныеСвязиСвойство.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОбратныеСвязи.ЭтоГруппа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Роли, которые дают права на объект, но ограничивают их на поле, выделяются цветом.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ПраваРолейПредставление.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПраваРолей.Ограничено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);

	// Объекты, у которых общий реквизит не используется, выводятся серым.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ЭлементыСоставаОбъект.Имя);
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ЭлементыСоставаИспользование.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементыСостава.Используется");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	// Группы данных базы выделяются жирным шрифтом.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ДанныеБазыИмя.Имя);
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ДанныеБазыЗначение.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеБазы.ЭтоГруппа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Расширения и коллекции в дереве расширений выделяются жирным шрифтом.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.РасширенияОбъектаПредставление.Имя);
	ДобавитьПолеОформления(ЭлементОформления, Элементы.РасширенияОбъектаПринадлежность.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РасширенияОбъекта.ЭтоГруппа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Элементы данных со ссылкой подчеркиваются: по двойному щелчку элемент открывается.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(ЭлементОформления, Элементы.ДанныеБазыЗначение.Имя);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеБазы.НавигационнаяСсылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , , , Истина));

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеОформления(ЭлементОформления, ИмяПоля)

	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);

