#Область ПрограммныйИнтерфейс

// Возвращает данные общего макета или макета объекта для показа на клиенте. Заполняется одно из свойств,
// в зависимости от типа макета.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя макета, например ОбщийМакет.Логотип или Справочник.Валюты.Макет.Классификатор
//  ЭтоТолстыйКлиент - Булево - географическую схему толстый клиент показывает сам, другие клиенты сохраняют ее в файл
//  ИдентификаторФормы - УникальныйИдентификатор - форма, с которой связываются данные во временном хранилище
//
// Возвращаемое значение:
//  Структура:
//   * АдресДвоичныхДанных - Строка, Неопределено - адрес двоичных данных макета для сохранения в файл
//   * РасширениеФайла - Строка, Неопределено - расширение файла для двоичных данных
//   * Макет - ТабличныйДокумент, ТекстовыйДокумент, ГеографическаяСхема, Неопределено - макет,
//       который показывается на клиенте
//   * ГрафическаяСхема - Строка, Неопределено - адрес во временном хранилище графической схемы, записанной
//       в поток: саму схему нельзя передать с сервера на клиент
//   * Текст - Строка, Неопределено - текст XML макета оформления компоновки данных
//   * СхемаКомпоновкиДанных - Строка, Неопределено - адрес схемы компоновки данных во временном хранилище
//   * HTMLДокумент - Строка, Неопределено - текст HTML-документа
//   * Отказ - Булево - Истина, если макет не удалось получить
Функция ДанныеОткрытияМакета(ПолноеИмя, ЭтоТолстыйКлиент, ИдентификаторФормы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("АдресДвоичныхДанных", Неопределено);
	Результат.Вставить("РасширениеФайла", Неопределено);
	Результат.Вставить("Макет", Неопределено);
	Результат.Вставить("ГрафическаяСхема", Неопределено);
	Результат.Вставить("Текст", Неопределено);
	Результат.Вставить("СхемаКомпоновкиДанных", Неопределено);
	Результат.Вставить("HTMLДокумент", Неопределено);
	Результат.Вставить("Отказ", Ложь);

	МетаданныеМакета = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаданныеМакета = Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не найден макет ""%1"".'"), ПолноеИмя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Результат.Отказ);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДанныеМакета = ЗначениеМакета(МетаданныеМакета);
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось получить макет ""%1"": %2'"), ПолноеИмя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Результат.Отказ);
		Возврат Результат;
	КонецПопытки;

	ТипыМакета = Метаданные.СвойстваОбъектов.ТипМакета;
	ТипМакета = МетаданныеМакета.ТипМакета;
	Если ТипМакета = ТипыМакета.ActiveDocument Тогда
		ДвоичныеДанныеМакета = МакетВДвоичныеДанные(ДанныеМакета);
		Результат.АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанныеМакета, ИдентификаторФормы);
		Результат.РасширениеФайла = "";
	ИначеЕсли ТипМакета = ТипыМакета.ДвоичныеДанные Или ТипМакета = ТипыМакета.ВнешняяКомпонента Тогда
		Результат.АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДанныеМакета, ИдентификаторФормы);
		Результат.РасширениеФайла = "";
	ИначеЕсли ТипМакета = ТипыМакета.ТабличныйДокумент Или ТипМакета = ТипыМакета.ТекстовыйДокумент Тогда
		Результат.Макет = ДанныеМакета;
	ИначеЕсли ТипМакета = ТипыМакета.ГрафическаяСхема Тогда
		ДанныеСхемы = ДвоичныеДанныеГрафическойСхемы(ДанныеМакета);
		Результат.ГрафическаяСхема = ПоместитьВоВременноеХранилище(ДанныеСхемы, ИдентификаторФормы);
	ИначеЕсли ТипМакета = ТипыМакета.МакетОформленияКомпоновкиДанных Тогда
		ТекстМакета = УИ_ОбщегоНазначения.ЗначениеВСтрокуXML(ДанныеМакета);
		Результат.Текст = ТекстМакета;
	ИначеЕсли ТипМакета = ТипыМакета.СхемаКомпоновкиДанных Тогда
		Результат.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(ДанныеМакета, ИдентификаторФормы);
	ИначеЕсли ТипМакета = ТипыМакета.ГеографическаяСхема Тогда
		Если ЭтоТолстыйКлиент Тогда
			Результат.Макет = ДанныеМакета;
		Иначе
			ДвоичныеДанныеМакета = МакетВДвоичныеДанные(ДанныеМакета);
			Результат.АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанныеМакета, ИдентификаторФормы);
		КонецЕсли;
		Результат.РасширениеФайла = "geo";
	ИначеЕсли ТипМакета = ТипыМакета.HTMLДокумент Тогда
		Результат.HTMLДокумент = ДанныеМакета.ПолучитьТекст();
	Иначе
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось обработать тип макета ""%1"".'"), ТипМакета);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Результат.Отказ);
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Помещает во временное хранилище карту маршрута бизнес-процесса, записанную в поток: графическую схему нельзя
// передать с сервера на клиент.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя бизнес-процесса, например БизнесПроцесс.Задание
//  ИдентификаторФормы - УникальныйИдентификатор - форма, с которой связываются данные во временном хранилище
//
// Возвращаемое значение:
//  Строка - адрес карты маршрута во временном хранилище. Пустая строка, если карту не удалось получить: тогда
//           пользователю выводится сообщение
Функция АдресКартыМаршрута(ПолноеИмя, ИдентификаторФормы) Экспорт

	Результат = "";
	БизнесПроцесс = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если БизнесПроцесс = Неопределено Или Не Метаданные.БизнесПроцессы.Содержит(БизнесПроцесс) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не найден бизнес-процесс ""%1"".'"), ПолноеИмя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		КартаМаршрута = БизнесПроцессы[БизнесПроцесс.Имя].ПолучитьКартуМаршрута();
		Результат = ПоместитьВоВременноеХранилище(ДвоичныеДанныеГрафическойСхемы(КартаМаршрута), ИдентификаторФормы);
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось получить карту маршрута ""%1"": %2'"), ПолноеИмя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает данные макета: общий макет получается по объекту метаданных, макет объекта - у менеджера владельца.
//
// Параметры:
//  МетаданныеМакета - ОбъектМетаданных - общий макет или макет объекта верхнего уровня
//
// Возвращаемое значение:
//  Произвольный - данные макета, тип зависит от типа макета
Функция ЗначениеМакета(МетаданныеМакета)

	Если Метаданные.ОбщиеМакеты.Содержит(МетаданныеМакета) Тогда
		ДанныеМакета = ПолучитьОбщийМакет(МетаданныеМакета);
	Иначе
		Менеджер = УИ_ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеМакета.Родитель().ПолноеИмя());
		ДанныеМакета = Менеджер.ПолучитьМакет(МетаданныеМакета.Имя);
	КонецЕсли;
	Возврат ДанныеМакета;

КонецФункции

// Записывает графическую схему в поток: на клиенте схема читается из этих данных.
//
// Параметры:
//  ГрафическаяСхема - ГрафическаяСхема - схема
//
// Возвращаемое значение:
//  ДвоичныеДанные - данные схемы
Функция ДвоичныеДанныеГрафическойСхемы(ГрафическаяСхема)

	Поток = Новый ПотокВПамяти;
	ГрафическаяСхема.Записать(Поток);
	ДанныеСхемы = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	Возврат ДанныеСхемы;

КонецФункции

Функция МакетВДвоичныеДанные(ДанныеМакета)

	ИмяФайла = ПолучитьИмяВременногоФайла();
	ДанныеМакета.Записать(ИмяФайла);
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Возврат ДвоичныеДанныеФайла;

КонецФункции

#КонецОбласти
