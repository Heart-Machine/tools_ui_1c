	ОписаниеВида.Вставить("Представление", Представление);
	Виды.Добавить(ОписаниеВида);

КонецПроцедуры

// Возвращает объекты вида, на которые роль дает хотя бы одно право, и права вида.
//
// Параметры:
//  ОписаниеВида - см. ВидыОбъектовСПравами
//  Роль - ОбъектМетаданныхРоль - роль
//
// Возвращаемое значение:
//  Структура:
//   * Объекты - Массив из ОбъектМетаданных, ОбъектМетаданныхКонфигурация - объекты в порядке метаданных
//   * ИменаПрав - Массив из Строка - права вида, которые есть в этой версии платформы
Функция ОбъектыСПравамиРоли(ОписаниеВида, Роль)

	Результат = Новый Структура("Объекты, ИменаПрав", Новый Массив, Новый Массив);
	ОбъектыВида = ОбъектыВидаСПравами(ОписаниеВида);
	Если ОбъектыВида.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ОбъектПроверки = Новый Структура("ОбъектМетаданных, ИмяСтандартного", ОбъектыВида[0], "");
	Результат.ИменаПрав = ПрименимыеПрава(ОбъектПроверки, ОписаниеВида.Вид);
	// Роль без корневого права не дает и зависящих от него прав, поэтому остальные права у нее не проверяются.
	КорневоеПраво = КорневоеПраво(Результат.ИменаПрав);
	Для Каждого ОбъектВида Из ОбъектыВида Цикл
		Если КорневоеПраво <> Неопределено Тогда
			ЕстьПрава = ПравоДоступаРоли(КорневоеПраво, ОбъектВида, Роль);
		Иначе
			ЕстьПрава = Ложь;
			Для Каждого ИмяПрава Из Результат.ИменаПрав Цикл
				Если ПравоДоступаРоли(ИмяПрава, ОбъектВида, Роль) Тогда
					ЕстьПрава = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ЕстьПрава Тогда
			Результат.Объекты.Добавить(ОбъектВида);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает объекты метаданных сеанса одного вида, которым роли задают права.
//
// Параметры:
//  ОписаниеВида - см. ВидыОбъектовСПравами
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных, ОбъектМетаданныхКонфигурация - объекты в порядке метаданных
Функция ОбъектыВидаСПравами(ОписаниеВида)

	Объекты = Новый Массив;
	Вид = ОписаниеВида.Вид;
	Если Вид = "Конфигурация" Тогда
		Объекты.Добавить(Метаданные);
		Возврат Объекты;
	КонецЕсли;

	// Коллекции, которых нет в этой версии платформы, остаются пустыми.
	Коллекции = Новый Структура(ОписаниеВида.Коллекция);
	ЗаполнитьЗначенияСвойств(Коллекции, Метаданные);
	Коллекция = Коллекции[ОписаниеВида.Коллекция];
	Если Коллекция = Неопределено Тогда
		Возврат Объекты;
	КонецЕсли;

	Если Вид = "Подсистема" Тогда
		ДобавитьПодсистемыСПравами(Объекты, Коллекция);
	ИначеЕсли Вид = "Операция" Тогда
		Для Каждого Сервис Из Коллекция Цикл
			ДобавитьОбъектыКоллекции(Объекты, Сервис.Операции);
		КонецЦикла;
	ИначеЕсли Вид = "Метод" Тогда
		Для Каждого Сервис Из Коллекция Цикл
			Для Каждого ШаблонURL Из Сервис.ШаблоныURL Цикл
				ДобавитьОбъектыКоллекции(Объекты, ШаблонURL.Методы);
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли Вид = "КаналСервисаИнтеграции" Тогда
		Для Каждого Сервис Из Коллекция Цикл
			ДобавитьОбъектыКоллекции(Объекты, Сервис.КаналыСервисаИнтеграции);
		КонецЦикла;
	Иначе
		ДобавитьОбъектыКоллекции(Объекты, Коллекция);
	КонецЕсли;
	Возврат Объекты;

КонецФункции

Процедура ДобавитьПодсистемыСПравами(Объекты, Подсистемы)

	Для Каждого Подсистема Из Подсистемы Цикл
		Объекты.Добавить(Подсистема);
		ДобавитьПодсистемыСПравами(Объекты, Подсистема.Подсистемы);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОбъектыКоллекции(Объекты, Коллекция)

	Для Каждого ОбъектКоллекции Из Коллекция Цикл
		Объекты.Добавить(ОбъектКоллекции);
	КонецЦикла;

КонецПроцедуры

// Проверяет право роли на объект метаданных. Право, которого нет у объекта или в этой версии платформы,
// считается не данным.
//
// Параметры:
//  ИмяПрава - Строка - имя права
//  ОбъектМетаданных - ОбъектМетаданных, ОбъектМетаданныхКонфигурация - объект
//  Роль - ОбъектМетаданныхРоль - роль
//
// Возвращаемое значение:
//  Булево - Истина, если роль дает право
Функция ПравоДоступаРоли(ИмяПрава, ОбъектМетаданных, Роль)

	Попытка
		Результат = ПравоДоступа(ИмяПрава, ОбъектМетаданных, Роль);
	Исключение
		// Такого права нет у этого объекта или в этой версии платформы.
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Проверяет, что у объектов вида права задаются как у полей: вместе с правами на объект, которому они принадлежат.
//
// Параметры:
//  Вид - Строка - вид объекта метаданных
//
// Возвращаемое значение:
//  Булево - Истина для реквизитов, табличных частей, измерений и других полей
Функция ЭтоВидПоляСПравами(Вид)

	Результат = (СписокИмен(ВидыПолейСПравами()).Найти(Вид) <> Неопределено);
	Возврат Результат;

КонецФункции

// Возвращает виды полей объектов, на которые роли задают права Просмотр и Редактирование.
//
// Возвращаемое значение:
//  Строка - виды через запятую
Функция ВидыПолейСПравами()

	Результат = "Реквизит, СтандартныйРеквизит, ТабличнаяЧасть, СтандартнаяТабличнаяЧасть, Измерение, Ресурс,
		|ПризнакУчета, ПризнакУчетаСубконто, РеквизитАдресации";
	Возврат Результат;

КонецФункции

// Возвращает право, от которого зависят остальные права объекта: права на данные зависят от права Чтение,
// права на отчеты и обработки - от права Использование.
//
// Параметры:
//  Права - Массив из Строка - права объекта
//
// Возвращаемое значение:
//  Строка, Неопределено - имя корневого права или Неопределено, если права объекта независимы
Функция КорневоеПраво(Права)

	Результат = Неопределено;
	Для Каждого ИмяПрава Из СписокИмен("Чтение, Использование") Цикл
		Если Права.Найти(ИмяПрава) <> Неопределено Тогда
			Результат = ИмяПрава;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает представление прав роли. Если роль дает большую часть прав объекта, перечисляются недостающие права.
//
// Параметры:
//  ПраваРоли - Массив из Строка - права, которые дает роль
//  Права - Массив из Строка - все права объекта
//
// Возвращаемое значение:
//  Строка - представление прав роли
Функция ПредставлениеПравРоли(ПраваРоли, Права)

	// Короткие наборы прав, например просмотр или получение и установка, выводятся без сокращения.
	МинимумПравДляСокращения = 4;
	Если Права.Количество() < МинимумПравДляСокращения Тогда
		Представление = СтрСоединить(ПраваРоли, ", ");
	ИначеЕсли ПраваРоли.Количество() = Права.Количество() Тогда
		Представление = НСтр("ru = 'Все права'");
	ИначеЕсли ПраваРоли.Количество() * 2 > Права.Количество() Тогда
		НедостающиеПрава = Новый Массив;
		Для Каждого ИмяПрава Из Права Цикл
			Если ПраваРоли.Найти(ИмяПрава) = Неопределено Тогда
				НедостающиеПрава.Добавить(ИмяПрава);
			КонецЕсли;
		КонецЦикла;
		Представление = СтрШаблон(НСтр("ru = 'Все права, кроме: %1'"), СтрСоединить(НедостающиеПрава, ", "));
	Иначе
		Представление = СтрСоединить(ПраваРоли, ", ");
	КонецЕсли;
	Возврат Представление;

КонецФункции

#КонецОбласти

#Область ДанныеБазы

Функция НовоеДеревоДанныхБазы()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Имя", ТипСтрока);
	Дерево.Колонки.Добавить("Значение", ТипСтрока);
	Дерево.Колонки.Добавить("НавигационнаяСсылка", ТипСтрока);
	Дерево.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Возврат Дерево;

КонецФункции

// Добавляет строку данных базы.
//
// Параметры:
//  Родитель - ДеревоЗначений, СтрокаДереваЗначений - дерево или строка, в которую добавляется строка
//  Имя - Строка - имя группы или показателя
//  Значение - Строка - представление значения
//  ЭтоГруппа - Булево - строка группирует данные
//
// Возвращаемое значение:
//  СтрокаДереваЗначений - добавленная строка
Функция ДобавитьСтрокуДанныхБазы(Родитель, Имя, Значение = "", ЭтоГруппа = Ложь)

	НоваяСтрока = Родитель.Строки.Добавить();
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Значение = Значение;
	НоваяСтрока.ЭтоГруппа = ЭтоГруппа;
	Возврат НоваяСтрока;

КонецФункции

Процедура ДобавитьОшибкуДанныхБазы(Родитель, ИнформацияОбОшибке)

	ДобавитьСтрокуДанныхБазы(Родитель, НСтр("ru = 'Ошибка'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Возвращает менеджер объекта метаданных текущего сеанса для видов, у которых данные базы читаются менеджером.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных
//  Вид - Строка - вид объекта, см. ВидОбъектаМетаданных
//
// Возвращаемое значение:
//  Произвольный - менеджер объекта, например СправочникМенеджер или РегистрНакопленияМенеджер
Функция МенеджерОбъекта(ОбъектМетаданных, Вид)

	Менеджеры = Новый Структура;
	Менеджеры.Вставить("Справочник", Справочники);
	Менеджеры.Вставить("ПланВидовХарактеристик", ПланыВидовХарактеристик);
	Менеджеры.Вставить("ПланСчетов", ПланыСчетов);
	Менеджеры.Вставить("ПланВидовРасчета", ПланыВидовРасчета);
	Менеджеры.Вставить("РегистрСведений", РегистрыСведений);
	Менеджеры.Вставить("РегистрНакопления", РегистрыНакопления);
	Менеджеры.Вставить("РегистрБухгалтерии", РегистрыБухгалтерии);
	Менеджер = Менеджеры[Вид][ОбъектМетаданных.Имя];
	Возврат Менеджер;

КонецФункции

// Добавляет предопределенные элементы из базы: имя предопределенных данных и ссылку на элемент.
Процедура ДобавитьПредопределенныеЭлементы(Дерево, ОбъектМетаданных, Вид)

	Если СписокИмен("Справочник, ПланВидовХарактеристик, ПланСчетов, ПланВидовРасчета").Найти(Вид) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Группа = ДобавитьСтрокуДанныхБазы(Дерево, НСтр("ru = 'Предопределенные элементы'"), , Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.ИмяПредопределенныхДанных КАК Имя,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление
		|ИЗ
		|	%1 КАК Т
		|ГДЕ
		|	Т.Предопределенный", ОбъектМетаданных.ПолноеИмя());
	Попытка
		Менеджер = МенеджерОбъекта(ОбъектМетаданных, Вид);
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Предопределенные данные инициализированы'"),
			ПредставлениеБулево(Менеджер.ПолучитьИнициализациюПредопределенныхДанных()));
		ПредопределенныеЭлементы = Запрос.Выполнить().Выгрузить();
	Исключение
		ДобавитьОшибкуДанныхБазы(Группа, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ПредопределенныеЭлементы.Сортировать("Имя");
	Для Каждого Элемент Из ПредопределенныеЭлементы Цикл
		СтрокаЭлемента = ДобавитьСтрокуДанныхБазы(Группа, Элемент.Имя, Элемент.Представление);
		СтрокаЭлемента.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Элемент.Ссылка);
	КонецЦикла;
	Группа.Значение = Формат(ПредопределенныеЭлементы.Количество(), "ЧН=0; ЧГ=0");

КонецПроцедуры

// Добавляет настройки итогов регистра в текущей базе.
Процедура ДобавитьУправлениеИтогами(Дерево, ОбъектМетаданных, Вид)

	Возможности = ВозможностиУправленияИтогами(ОбъектМетаданных, Вид);
	Если Не Возможности.ЕстьИтоги Тогда
		Возврат;
	КонецЕсли;

	Группа = ДобавитьСтрокуДанныхБазы(Дерево, НСтр("ru = 'Итоги'"), , Истина);
	Попытка
		Менеджер = МенеджерОбъекта(ОбъектМетаданных, Вид);
		// В режиме агрегатов регистр оборотов использует агрегаты вместо итогов.
		Если Возможности.ЕстьАгрегаты И Менеджер.ПолучитьРежимАгрегатов() Тогда
			ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Использование итогов'"),
				НСтр("ru = 'Регистр в режиме агрегатов'"));
			Возврат;
		КонецЕсли;

		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Использование итогов'"),
			ПредставлениеБулево(Менеджер.ПолучитьИспользованиеИтогов()));
		Если Возможности.ЕстьТекущиеИтоги Тогда
			ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Использование текущих итогов'"),
				ПредставлениеБулево(Менеджер.ПолучитьИспользованиеТекущихИтогов()));
			ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Период рассчитанных итогов'"),
				ПредставлениеДатыДанныхБазы(Менеджер.ПолучитьМаксимальныйПериодРассчитанныхИтогов()));
			ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Минимальный период рассчитанных итогов'"),
				ПредставлениеДатыДанныхБазы(Менеджер.ПолучитьМинимальныйПериодРассчитанныхИтогов()));
		КонецЕсли;
		Если Возможности.ЕстьРазделениеИтогов Тогда
			ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Разделение итогов'"),
				ПредставлениеБулево(Менеджер.ПолучитьРежимРазделенияИтогов()));
		КонецЕсли;
	Исключение
		ДобавитьОшибкуДанныхБазы(Группа, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Добавляет режим и список агрегатов регистра оборотов в текущей базе.
Процедура ДобавитьАгрегаты(Дерево, ОбъектМетаданных, Вид)

	Если Вид <> "РегистрНакопления"
		Или ОбъектМетаданных.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
		Возврат;
	КонецЕсли;

	Группа = ДобавитьСтрокуДанныхБазы(Дерево, НСтр("ru = 'Агрегаты'"), , Истина);
	Попытка
		Менеджер = МенеджерОбъекта(ОбъектМетаданных, Вид);
		РежимАгрегатов = Менеджер.ПолучитьРежимАгрегатов();
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Режим агрегатов'"), ПредставлениеБулево(РежимАгрегатов));
		Если Не РежимАгрегатов Тогда
			Возврат;
		КонецЕсли;

		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Использование агрегатов'"),
			ПредставлениеБулево(Менеджер.ПолучитьИспользованиеАгрегатов()));
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Агрегаты заполнены'"),
			ПредставлениеБулево(Менеджер.АгрегатыЗаполнены()));

		Информация = Менеджер.ПолучитьАгрегаты();
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Дата построения списка'"),
			ПредставлениеДатыДанныхБазы(Информация.ДатаПостроения));
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Эффект'"), Формат(Информация.Эффект, "ЧН=0; ЧГ=0"));
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Размер'"), Формат(Информация.Размер, "ЧН=0"));
		ДобавитьСтрокуДанныхБазы(Группа, НСтр("ru = 'Ограничение размера, %'"),
			Формат(Информация.ОграничениеРазмера, "ЧН=0; ЧГ=0"));

		Для Каждого Агрегат Из Информация.Агрегаты Цикл
			Измерения = СтрСоединить(Агрегат.Измерения, ", ");
			ИмяАгрегата = ?(ПустаяСтрока(Измерения), Строка(Агрегат.Периодичность),
				СтрШаблон("%1: %2", Агрегат.Периодичность, Измерения));
			ЗначениеАгрегата = СтрШаблон(НСтр("ru = 'Используется: %1; размер: %2'"),
				ПредставлениеБулево(Агрегат.Использование), Формат(Агрегат.Размер, "ЧН=0"));
			Если ЗначениеЗаполнено(Агрегат.НачалоПериода) Или ЗначениеЗаполнено(Агрегат.КонецПериода) Тогда
				ЗначениеАгрегата = СтрШаблон(НСтр("ru = '%1; период: %2 - %3'"), ЗначениеАгрегата,
					ПредставлениеДатыДанныхБазы(Агрегат.НачалоПериода), ПредставлениеДатыДанныхБазы(Агрегат.КонецПериода));
			КонецЕсли;
			ДобавитьСтрокуДанныхБазы(Группа, ИмяАгрегата, ЗначениеАгрегата);
		КонецЦикла;
	Исключение
		ДобавитьОшибкуДанныхБазы(Группа, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Функция ПредставлениеДатыДанныхБазы(Дата)

	Если ЗначениеЗаполнено(Дата) Тогда
		Представление = Формат(Дата, "ДЛФ=D");
	Иначе
		Представление = НСтр("ru = 'не задан'");
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Добавляет структуру хранения: у объекта - все его таблицы с полями и индексами, у табличной части - ее таблицы,
// у реквизита и общего реквизита - поля таблиц, в которых он хранится.
//
// Параметры:
//  Дерево - см. НовоеДеревоДанныхБазы
//  ОбъектМетаданных - ОбъектМетаданных - объект верхнего уровня узла
//  Вид - Строка - вид объекта верхнего уровня
//  КлючУзла - Строка - ключ узла состава
Процедура ДобавитьСтруктуруХранения(Дерево, ОбъектМетаданных, Вид, КлючУзла)

	ОписаниеУзла = ОписаниеУзлаХранения(ОбъектМетаданных, Вид, КлючУзла);
	// Пустой массив объектов вернул бы структуру хранения всей базы.
	Если ОписаниеУзла = Неопределено Или ОписаниеУзла.ОбъектыХранения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Группа = ДобавитьСтрокуДанныхБазы(Дерево, НСтр("ru = 'Структура хранения'"), , Истина);
	Попытка
		СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(ОписаниеУзла.ОбъектыХранения, Истина);
	Исключение
		ДобавитьОшибкуДанныхБазы(Группа, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Для Каждого Таблица Из СтруктураХранения Цикл
		ИмяТаблицы = ПредставлениеТаблицыХранения(Таблица);
		Если ОписаниеУзла.ЭтоОбъект Тогда
			ДобавитьТаблицуХранения(Группа, Таблица, ИмяТаблицы);
		ИначеЕсли ЭтоТаблицаУзлаХранения(Таблица, ОписаниеУзла) Тогда
			ДобавитьТаблицуХранения(Группа, Таблица, ИмяТаблицы);
		ИначеЕсли ОписаниеУзла.ЭтоПоле Тогда
			Для Каждого Поле Из Таблица.Поля Цикл
				Если ЭтоПолеУзлаХранения(Таблица, Поле, ОписаниеУзла) Тогда
					ДобавитьСтрокуДанныхБазы(Группа, ИмяТаблицы,
						СтрШаблон("%1.%2", Таблица.ИмяТаблицыХранения, Поле.ИмяПоляХранения));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Группа.Строки.Количество() = 0 Тогда
		Дерево.Строки.Удалить(Группа);
	КонецЕсли;

КонецПроцедуры

// Возвращает, что искать в структуре хранения для узла состава.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект верхнего уровня узла
//  Вид - Строка - вид объекта верхнего уровня
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если у узла нет данных в базе:
//   * ОбъектыХранения - Массив из ОбъектМетаданных - объекты, структуру хранения которых нужно получить
//   * ЭтоОбъект - Булево - выводятся все таблицы объектов хранения
//   * ЭтоПоле - Булево - выводятся поля, в которых хранится узел
//   * ПолноеИмя - Строка - полное имя объекта метаданных узла, у стандартных реквизитов и табличных частей пусто
//   * ИмяТаблицы - Строка - имя таблицы узла-табличной части или таблицы, в которой ищется стандартный реквизит
//   * ИмяПоля - Строка - имя стандартного реквизита
Функция ОписаниеУзлаХранения(ОбъектМетаданных, Вид, КлючУзла)

	ВидыСХранением = СписокИмен(
		"Константа, Справочник, Документ, Последовательность, Перечисление, ПланОбмена, ПланВидовХарактеристик,
		|ПланСчетов, ПланВидовРасчета, РегистрСведений, РегистрНакопления, РегистрБухгалтерии, РегистрРасчета,
		|БизнесПроцесс, Задача");

	ОписаниеУзла = Новый Структура;
	ОписаниеУзла.Вставить("ОбъектыХранения", Новый Массив);
	ОписаниеУзла.Вставить("ЭтоОбъект", Ложь);
	ОписаниеУзла.Вставить("ЭтоПоле", Ложь);
	ОписаниеУзла.Вставить("ПолноеИмя", "");
	ОписаниеУзла.Вставить("ИмяТаблицы", "");
	ОписаниеУзла.Вставить("ИмяПоля", "");

	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	ВидУзла = ВидПоПолномуИмени(КлючУзла);
	Если Вид = "ОбщийРеквизит" Тогда
		// Общий реквизит хранится в таблицах объектов, у которых он используется.
		ОписаниеУзла.ЭтоПоле = Истина;
		ОписаниеУзла.ПолноеИмя = ПолноеИмяОбъекта;
		Для Каждого Элемент Из ОбъектМетаданных.Состав Цикл
			Если Элемент.Метаданные <> Неопределено И ЭлементСоставаОбщегоРеквизитаИспользуется(Элемент, ОбъектМетаданных) Тогда
				ОписаниеУзла.ОбъектыХранения.Добавить(Элемент.Метаданные);
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ВидыСХранением.Найти(Вид) = Неопределено Тогда
		ОписаниеУзла = Неопределено;

	ИначеЕсли КлючУзла = ПолноеИмяОбъекта Тогда
		ОписаниеУзла.ЭтоОбъект = Истина;

	ИначеЕсли ВидУзла = "ТабличнаяЧасть" Или ВидУзла = "Перерасчет" Тогда
		ОписаниеУзла.ПолноеИмя = КлючУзла;
		ОписаниеУзла.ИмяТаблицы = СтрШаблон("%1.%2", ПолноеИмяОбъекта, СтрРазделить(КлючУзла, ".")[3]);

	ИначеЕсли ВидУзла = "СтандартнаяТабличнаяЧасть" Тогда
		ОписаниеУзла.ИмяТаблицы = СтрШаблон("%1.%2", ПолноеИмяОбъекта, СтрРазделить(КлючУзла, ".")[3]);

	ИначеЕсли ЭтоВидПоляСПравами(ВидУзла) Тогда
		ОписаниеУзла.ЭтоПоле = Истина;
		ЧастиИмени = СтрРазделить(КлючУзла, ".");
		Если ВидУзла = "СтандартныйРеквизит" Тогда
			// Стандартный реквизит ищется по имени в таблице владельца: объекта или стандартной табличной части.
			ОписаниеУзла.ИмяПоля = ЧастиИмени[ЧастиИмени.ВГраница()];
			Если ЧастиИмени.Количество() > 4 Тогда
				ОписаниеУзла.ИмяТаблицы = СтрШаблон("%1.%2", ПолноеИмяОбъекта, ЧастиИмени[3]);
			Иначе
				ОписаниеУзла.ИмяТаблицы = ПолноеИмяОбъекта;
			КонецЕсли;
		Иначе
			ОписаниеУзла.ПолноеИмя = КлючУзла;
		КонецЕсли;

	Иначе
		ОписаниеУзла = Неопределено;
	КонецЕсли;

	Если ОписаниеУзла <> Неопределено И Вид <> "ОбщийРеквизит" Тогда
		ОписаниеУзла.ОбъектыХранения.Добавить(ОбъектМетаданных);
	КонецЕсли;
	Возврат ОписаниеУзла;

КонецФункции

// Проверяет, что таблица хранения - таблица узла-табличной части.
Функция ЭтоТаблицаУзлаХранения(Таблица, ОписаниеУзла)

	ЭтоТаблицаУзла = Не ОписаниеУзла.ЭтоПоле
		И (ЗначениеЗаполнено(ОписаниеУзла.ПолноеИмя) И Таблица.Метаданные = ОписаниеУзла.ПолноеИмя
			Или Таблица.ИмяТаблицы = ОписаниеУзла.ИмяТаблицы);
	Возврат ЭтоТаблицаУзла;

КонецФункции

// Проверяет, что поле таблицы хранения хранит узел-реквизит.
Функция ЭтоПолеУзлаХранения(Таблица, Поле, ОписаниеУзла)

	Если ЗначениеЗаполнено(ОписаниеУзла.ПолноеИмя) Тогда
		ЭтоПолеУзла = (Поле.Метаданные = ОписаниеУзла.ПолноеИмя);
	Иначе
		ЭтоПолеУзла = (Таблица.ИмяТаблицы = ОписаниеУзла.ИмяТаблицы И Поле.ИмяПоля = ОписаниеУзла.ИмяПоля);
	КонецЕсли;
	Возврат ЭтоПолеУзла;

КонецФункции

Функция ПредставлениеТаблицыХранения(Таблица)

	// У части служебных таблиц нет имени в языке запросов, тогда выводится полное имя объекта метаданных.
	ИмяТаблицы = ?(ПустаяСтрока(Таблица.ИмяТаблицы), Таблица.Метаданные, Таблица.ИмяТаблицы);
	Если ПустаяСтрока(Таблица.Назначение) Тогда
		Представление = ИмяТаблицы;
	ИначеЕсли ПустаяСтрока(ИмяТаблицы) Тогда
		Представление = Таблица.Назначение;
	Иначе
		Представление = СтрШаблон("%1 (%2)", ИмяТаблицы, Таблица.Назначение);
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Добавляет таблицу хранения с полями и индексами.
//
// Параметры:
//  Группа - СтрокаДереваЗначений - строка, в которую добавляется таблица
//  Таблица - СтрокаТаблицыЗначений - строка структуры хранения, см. ПолучитьСтруктуруХраненияБазыДанных
//  ИмяТаблицы - Строка - представление таблицы
Процедура ДобавитьТаблицуХранения(Группа, Таблица, ИмяТаблицы)

	СтрокаТаблицы = ДобавитьСтрокуДанныхБазы(Группа, ИмяТаблицы, Таблица.ИмяТаблицыХранения, Истина);
	Для Каждого Поле Из Таблица.Поля Цикл
		ИмяПоля = ?(ПустаяСтрока(Поле.ИмяПоля), Поле.ИмяПоляХранения, Поле.ИмяПоля);
		ДобавитьСтрокуДанныхБазы(СтрокаТаблицы, ИмяПоля, Поле.ИмяПоляХранения);
	КонецЦикла;

	Если Таблица.Индексы.Количество() > 0 Тогда
		СтрокаИндексов = ДобавитьСтрокуДанныхБазы(СтрокаТаблицы, НСтр("ru = 'Индексы'"), , Истина);
		Для Каждого Индекс Из Таблица.Индексы Цикл
			ПоляИндекса = Новый Массив;
			Для Каждого Поле Из Индекс.Поля Цикл
				ПоляИндекса.Добавить(Поле.ИмяПоляХранения);
			КонецЦикла;
			ДобавитьСтрокуДанныхБазы(СтрокаИндексов, Индекс.ИмяИндексаХранения, СтрСоединить(ПоляИндекса, ", "));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область УправлениеИтогами

// Возвращает возможности управления итогами регистра, по умолчанию - никаких.
//
// Возвращаемое значение:
//  Структура:
//   * ЕстьИтоги - Булево - итогами регистра можно управлять
//   * ЕстьТекущиеИтоги - Булево - у регистра есть текущие итоги и период рассчитанных итогов:
//       это регистр остатков или регистр бухгалтерии
//   * ЕстьРазделениеИтогов - Булево - это регистр накопления или бухгалтерии
//   * ЕстьАгрегаты - Булево - это регистр оборотов, у него есть режим агрегатов
//   * ЕстьПересчетЗаПериод - Булево - это регистр накопления или бухгалтерии
Функция НовыеВозможностиУправленияИтогами()

	Возможности = Новый Структура;
	Возможности.Вставить("ЕстьИтоги", Ложь);
	Возможности.Вставить("ЕстьТекущиеИтоги", Ложь);
	Возможности.Вставить("ЕстьРазделениеИтогов", Ложь);
	Возможности.Вставить("ЕстьАгрегаты", Ложь);
	Возможности.Вставить("ЕстьПересчетЗаПериод", Ложь);
	Возврат Возможности;

КонецФункции

// Возвращает возможности управления итогами регистра по его виду.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных
//  Вид - Строка - вид объекта, см. ВидОбъектаМетаданных
//
// Возвращаемое значение:
//  см. НовыеВозможностиУправленияИтогами
Функция ВозможностиУправленияИтогами(ОбъектМетаданных, Вид)

	Возможности = НовыеВозможностиУправленияИтогами();
	Если Вид = "РегистрНакопления" Или Вид = "РегистрБухгалтерии" Тогда
		ЭтоРегистрОборотов = (Вид = "РегистрНакопления"
			И ОбъектМетаданных.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
		Возможности.ЕстьИтоги = Истина;
		Возможности.ЕстьТекущиеИтоги = Не ЭтоРегистрОборотов;
		Возможности.ЕстьРазделениеИтогов = Истина;
		Возможности.ЕстьАгрегаты = ЭтоРегистрОборотов;
		Возможности.ЕстьПересчетЗаПериод = Истина;
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возможности.ЕстьИтоги = (ОбъектМетаданных.РазрешитьИтогиСрезПервых
			Или ОбъектМетаданных.РазрешитьИтогиСрезПоследних);
	КонецЕсли;
	Возврат Возможности;

КонецФункции

// Возвращает регистр метаданных текущего сеанса, итогами которого можно управлять.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если итогами объекта управлять нельзя:
//   * ОбъектМетаданных - ОбъектМетаданных - регистр
//   * Менеджер - РегистрНакопленияМенеджер, РегистрБухгалтерииМенеджер, РегистрСведенийМенеджер - менеджер регистра
//   * Возможности - см. НовыеВозможностиУправленияИтогами
Функция РегистрУправленияИтогами(НайденныйОбъект, ПолноеИмя)

	Регистр = Неопределено;
	// Итоги есть только у объектов верхнего уровня.
	Если СтрРазделить(ПолноеИмя, ".").Количество() <> 2 Тогда
		Возврат Регистр;
	КонецЕсли;
	ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Регистр;
	КонецЕсли;

	Вид = ВидПоПолномуИмени(ПолноеИмя);
	Возможности = ВозможностиУправленияИтогами(ОбъектМетаданных, Вид);
	Если Возможности.ЕстьИтоги Тогда
		Регистр = Новый Структура;
		Регистр.Вставить("ОбъектМетаданных", ОбъектМетаданных);
		Регистр.Вставить("Менеджер", МенеджерОбъекта(ОбъектМетаданных, Вид));
		Регистр.Вставить("Возможности", Возможности);
	КонецЕсли;
	Возврат Регистр;

КонецФункции

// Возвращает регистр, итоги которого пользователь может изменять. Если изменять их нельзя,
// пользователю выводится сообщение.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя регистра
//
// Возвращаемое значение:
//  см. РегистрУправленияИтогами
Функция РегистрДляИзмененияИтогов(НайденныйОбъект, ПолноеИмя)

	Регистр = РегистрУправленияИтогами(НайденныйОбъект, ПолноеИмя);
	ТекстОшибки = "";
	Если Регистр = Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Итогами объекта ""%1"" управлять нельзя.'"), ПолноеИмя);
	ИначеЕсли Не ЕстьПравоУправленияИтогами(Регистр.ОбъектМетаданных) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Нет права ""Управление итогами"" на регистр ""%1"".'"), ПолноеИмя);
		Регистр = Неопределено;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	Возврат Регистр;

КонецФункции

// Проверяет право текущего пользователя "Управление итогами" на регистр.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - регистр
//
// Возвращаемое значение:
//  Булево - Истина, если право есть
Функция ЕстьПравоУправленияИтогами(ОбъектМетаданных)

	Попытка
		ЕстьПраво = ПравоДоступа("УправлениеИтогами", ОбъектМетаданных);
	Исключение
		// Право применимо не ко всем регистрам и не во всех версиях платформы.
		ЕстьПраво = Ложь;
	КонецПопытки;
	Возврат ЕстьПраво;

КонецФункции

// Заполняет настройки итогов текущими значениями из базы.
//
// Параметры:
//  Настройки - см. НовыеНастройкиИтогов
//  Регистр - см. РегистрУправленияИтогами
Процедура ЗаполнитьНастройкиИтогов(Настройки, Регистр)

	Менеджер = Регистр.Менеджер;
	Возможности = Регистр.Возможности;
	Если Возможности.ЕстьАгрегаты Тогда
		Настройки.РежимАгрегатов = Менеджер.ПолучитьРежимАгрегатов();
		Если Настройки.РежимАгрегатов Тогда
			Настройки.ИспользованиеАгрегатов = Менеджер.ПолучитьИспользованиеАгрегатов();
		КонецЕсли;
	КонецЕсли;
	// В режиме агрегатов регистр оборотов использует агрегаты вместо итогов.
	Если Не Настройки.РежимАгрегатов Тогда
		Настройки.ИспользованиеИтогов = Менеджер.ПолучитьИспользованиеИтогов();
	КонецЕсли;
	Если Возможности.ЕстьТекущиеИтоги Тогда
		Настройки.ИспользованиеТекущихИтогов = Менеджер.ПолучитьИспользованиеТекущихИтогов();
		Настройки.МинимальныйПериодРассчитанныхИтогов = Менеджер.ПолучитьМинимальныйПериодРассчитанныхИтогов();
		Настройки.МаксимальныйПериодРассчитанныхИтогов = Менеджер.ПолучитьМаксимальныйПериодРассчитанныхИтогов();
	КонецЕсли;
	Если Возможности.ЕстьРазделениеИтогов Тогда
		Настройки.РежимРазделенияИтогов = Менеджер.ПолучитьРежимРазделенияИтогов();
	КонецЕсли;

КонецПроцедуры

// Устанавливает настройки итогов, которые отличаются от текущих в базе. Сначала устанавливается режим агрегатов:
// от него зависит, какие из остальных настроек применимы. Периоды рассчитанных итогов сравниваются по дням:
// в форме они вводятся без времени.
//
// Параметры:
//  Регистр - см. РегистрУправленияИтогами
//  Настройки - см. НовыеНастройкиИтогов
Процедура УстановитьИзмененныеНастройкиИтогов(Регистр, Настройки)

	Менеджер = Регистр.Менеджер;
	Возможности = Регистр.Возможности;
	Текущие = НовыеНастройкиИтогов();
	ЗаполнитьНастройкиИтогов(Текущие, Регистр);

	Если Возможности.ЕстьАгрегаты И Настройки.РежимАгрегатов <> Текущие.РежимАгрегатов Тогда
		Менеджер.УстановитьРежимАгрегатов(Настройки.РежимАгрегатов);
		ЗаполнитьНастройкиИтогов(Текущие, Регистр);
	КонецЕсли;

	Если Настройки.РежимАгрегатов Тогда
		Если Настройки.ИспользованиеАгрегатов <> Текущие.ИспользованиеАгрегатов Тогда
			Менеджер.УстановитьИспользованиеАгрегатов(Настройки.ИспользованиеАгрегатов);
		КонецЕсли;
	ИначеЕсли Настройки.ИспользованиеИтогов <> Текущие.ИспользованиеИтогов Тогда
		Менеджер.УстановитьИспользованиеИтогов(Настройки.ИспользованиеИтогов);
	КонецЕсли;

	Если Возможности.ЕстьТекущиеИтоги Тогда
		Если Настройки.ИспользованиеТекущихИтогов <> Текущие.ИспользованиеТекущихИтогов Тогда
			Менеджер.УстановитьИспользованиеТекущихИтогов(Настройки.ИспользованиеТекущихИтогов);
		КонецЕсли;
		Если НачалоДня(Настройки.МаксимальныйПериодРассчитанныхИтогов)
			<> НачалоДня(Текущие.МаксимальныйПериодРассчитанныхИтогов) Тогда
			Менеджер.УстановитьМаксимальныйПериодРассчитанныхИтогов(Настройки.МаксимальныйПериодРассчитанныхИтогов);
		КонецЕсли;
		Если НачалоДня(Настройки.МинимальныйПериодРассчитанныхИтогов)
			<> НачалоДня(Текущие.МинимальныйПериодРассчитанныхИтогов) Тогда
			Менеджер.УстановитьМинимальныйПериодРассчитанныхИтогов(Настройки.МинимальныйПериодРассчитанныхИтогов);
		КонецЕсли;
	КонецЕсли;

	Если Возможности.ЕстьРазделениеИтогов И Настройки.РежимРазделенияИтогов <> Текущие.РежимРазделенияИтогов Тогда
		Менеджер.УстановитьРежимРазделенияИтогов(Настройки.РежимРазделенияИтогов);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВнешниеИсточникиДанных

// Возвращает внешний источник данных метаданных текущего сеанса.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если объект - не внешний источник данных текущего сеанса:
//   * ОбъектМетаданных - ОбъектМетаданных - внешний источник данных
//   * Менеджер - Произвольный - менеджер внешнего источника данных из ВнешниеИсточникиДанных
Функция ВнешнийИсточникДанныхСеанса(НайденныйОбъект, ПолноеИмя)

	Источник = Неопределено;
	// Подключением управляют у самого источника, а не у его таблиц и кубов.
	Если СтрРазделить(ПолноеИмя, ".").Количество() <> 2 Или ВидПоПолномуИмени(ПолноеИмя) <> "ВнешнийИсточникДанных" Тогда
		Возврат Источник;
	КонецЕсли;
	ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмя);
	Если ОбъектМетаданных <> Неопределено Тогда
		Источник = Новый Структура("ОбъектМетаданных, Менеджер", ОбъектМетаданных,
			ВнешниеИсточникиДанных[ОбъектМетаданных.Имя]);
	КонецЕсли;
	Возврат Источник;

КонецФункции

// Возвращает внешний источник данных, подключением которого управляют. Если объект - не внешний источник данных
// текущего сеанса, пользователю выводится сообщение.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя внешнего источника данных
//
// Возвращаемое значение:
//  см. ВнешнийИсточникДанныхСеанса
Функция ВнешнийИсточникДляУправленияПодключением(НайденныйОбъект, ПолноеИмя)

	Источник = ВнешнийИсточникДанныхСеанса(НайденныйОбъект, ПолноеИмя);
	Если Источник = Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Подключением объекта ""%1"" управлять нельзя.'"), ПолноеИмя);
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	Возврат Источник;

КонецФункции

// Читает параметры соединения внешнего источника данных.
//
// Параметры:
//  Менеджер - Произвольный - менеджер внешнего источника данных из ВнешниеИсточникиДанных
//  ВидПараметров - Строка - "Общие", "Сеанса" или "Пользователя"
//  ПользовательИБ - Строка - имя пользователя информационной базы для параметров пользователя
//
// Возвращаемое значение:
//  ПараметрыСоединенияВнешнегоИсточникаДанных - параметры соединения
Функция ПараметрыСоединенияИсточника(Менеджер, ВидПараметров, ПользовательИБ)

	Если ВидПараметров = "Общие" Тогда
		ПараметрыСоединения = Менеджер.ПолучитьОбщиеПараметрыСоединения();
	ИначеЕсли ВидПараметров = "Сеанса" Тогда
		ПараметрыСоединения = Менеджер.ПолучитьПараметрыСоединенияСеанса();
	ИначеЕсли ВидПараметров = "Пользователя" Тогда
		ПараметрыСоединения = Менеджер.ПолучитьПараметрыСоединенияПользователя(ПользовательИБ);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид параметров соединения ""%1"".'"), ВидПараметров);
	КонецЕсли;
	Возврат ПараметрыСоединения;

КонецФункции

// Устанавливает параметры соединения внешнего источника данных.
//
// Параметры:
//  Менеджер - Произвольный - менеджер внешнего источника данных из ВнешниеИсточникиДанных
//  ВидПараметров - Строка - "Общие", "Сеанса" или "Пользователя"
//  ПользовательИБ - Строка - имя пользователя информационной базы для параметров пользователя
//  ПараметрыСоединения - ПараметрыСоединенияВнешнегоИсточникаДанных - параметры соединения
Процедура УстановитьПараметрыСоединенияИсточника(Менеджер, ВидПараметров, ПользовательИБ, ПараметрыСоединения)

	Если ВидПараметров = "Общие" Тогда
		Менеджер.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
	ИначеЕсли ВидПараметров = "Сеанса" Тогда
		Менеджер.УстановитьПараметрыСоединенияСеанса(ПараметрыСоединения);
	ИначеЕсли ВидПараметров = "Пользователя" Тогда
		Менеджер.УстановитьПараметрыСоединенияПользователя(ПользовательИБ, ПараметрыСоединения);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид параметров соединения ""%1"".'"), ВидПараметров);
	КонецЕсли;

КонецПроцедуры

// Проверяет, что текущий пользователь может изменять параметры соединения внешнего источника данных этого вида.
// Общие параметры и параметры любого пользователя изменяют с правом "Администрирование", свои параметры
// стандартной аутентификации - с правом "Изменение стандартной аутентификации", параметры сеанса - с правами
// изменения аутентификации сеанса. Какие именно параметры можно изменить, проверяет платформа при записи.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - внешний источник данных
//  ВидПараметров - Строка - "Общие", "Сеанса" или "Пользователя"
//  ПользовательИБ - Строка - имя пользователя информационной базы для параметров пользователя
//
// Возвращаемое значение:
//  Булево - Истина, если право есть
Функция ЕстьПравоИзмененияПараметровСоединения(ОбъектМетаданных, ВидПараметров, ПользовательИБ)

	Если ЕстьПравоНаВнешнийИсточник("Администрирование", ОбъектМетаданных) Тогда
		ЕстьПраво = Истина;
	ИначеЕсли ВидПараметров = "Сеанса" Тогда
		ЕстьПраво = ЕстьПравоНаВнешнийИсточник("ИзменениеСтандартнойАутентификацииСеанса", ОбъектМетаданных)
			Или ЕстьПравоНаВнешнийИсточник("ИзменениеАутентификацииОССеанса", ОбъектМетаданных);
	ИначеЕсли ВидПараметров = "Пользователя" Тогда
		ЕстьПраво = ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь().Имя
			И ЕстьПравоНаВнешнийИсточник("ИзменениеСтандартнойАутентификации", ОбъектМетаданных);
	Иначе
		ЕстьПраво = Ложь;
	КонецЕсли;
	Возврат ЕстьПраво;

КонецФункции

// Проверяет право текущего пользователя на внешний источник данных.
//
// Параметры:
//  ИмяПрава - Строка - имя права, например "Администрирование"
//  ОбъектМетаданных - ОбъектМетаданных - внешний источник данных
//
// Возвращаемое значение:
//  Булево - Истина, если право есть
Функция ЕстьПравоНаВнешнийИсточник(ИмяПрава, ОбъектМетаданных)

	Попытка
		ЕстьПраво = ПравоДоступа(ИмяПрава, ОбъектМетаданных);
	Исключение
		// Права изменения аутентификации есть не во всех версиях платформы.
		ЕстьПраво = Ложь;
	КонецПопытки;
	Возврат ЕстьПраво;

КонецФункции

