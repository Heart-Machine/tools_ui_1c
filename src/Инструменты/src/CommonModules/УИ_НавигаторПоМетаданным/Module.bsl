КонецФункции

Процедура ДобавитьГруппуСвойств(Группы, Имя, Представление, Свойства)

	ОписаниеГруппы = Новый Структура;
	ОписаниеГруппы.Вставить("Имя", Имя);
	ОписаниеГруппы.Вставить("Представление", Представление);
	ОписаниеГруппы.Вставить("Свойства", СписокИмен(Свойства));
	Группы.Добавить(ОписаниеГруппы);

КонецПроцедуры

// Возвращает свойства-коллекции, каждый элемент которых выводится отдельным свойством в группе свойств
// с именем коллекции, см. ДобавитьЭлементыКоллекцийСвойств.
//
// Возвращаемое значение:
//  Массив из Структура - описания групп, см. ГруппыСвойств; список свойств группы пустой
Функция КоллекцииСвойств()

	Коллекции = Новый Массив;
	ДобавитьГруппуСвойств(Коллекции, "ДополнительныеИндексы", НСтр("ru = 'Дополнительные индексы'"), "");
	ДобавитьГруппуСвойств(Коллекции, "Агрегаты", НСтр("ru = 'Агрегаты'"), "");
	ДобавитьГруппуСвойств(Коллекции, "Характеристики", НСтр("ru = 'Характеристики'"), "");
	Возврат Коллекции;

КонецФункции

// Разбирает список имен, перечисленных через запятую и перенос строки.
//
// Параметры:
//  СписокСтрокой - Строка - список имен
//
// Возвращаемое значение:
//  Массив из Строка - имена
Функция СписокИмен(СписокСтрокой)

	Имена = Новый Массив;
	Для Каждого ЧастьСписка Из СтрРазделить(СтрЗаменить(СписокСтрокой, Символы.ПС, ","), ",", Ложь) Цикл
		Имя = СокрЛП(ЧастьСписка);
		Если ЗначениеЗаполнено(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Возвращает имена свойств объектов метаданных, значения которых могут ссылаться на другие объекты метаданных:
// объект метаданных, коллекция объектов, описание типов, имя процедуры общего модуля.
// Список общий для всех видов: у конкретного объекта читаются только те свойства, которые у него есть.
//
// Возвращаемое значение:
//  Массив из Строка - имена свойств
Функция ИменаСсылочныхСвойств()

	Имена = СписокИмен(
		"Тип, Владельцы, ВводитсяНаОсновании, Состав, Движения, Документы, РегистрируемыеДокументы, Ссылки, Нумератор,
		|Источник, Обработчик, ИмяМетода, Хранение, Использование, ТипПараметраКоманды, Группа, ФормаВыбора,
		|ПланСчетов, ВидыСубконто, ПланВидовРасчета, График, ЗначениеГрафика, ДатаГрафика, БазовыеВидыРасчета,
		|ДополнительныеЗначенияХарактеристик, ИзмерениеРегистра, ДанныеВедущихРегистров, СоответствиеДвижениям,
		|СоответствиеДокументам, ПризнакУчета, ПризнакУчетаСубконто, Задача, Адресация, ОсновнойРеквизитАдресации,
		|ТекущийИсполнитель, ИзмерениеАдресации, ПакетыXDTO, ЗначениеРазделенияДанных, ИспользованиеРазделенияДанных,
		|ОсновнойЯзык, ОсновнойСтиль, ОсновнойИнтерфейс, ОсновныеРоли,
		|ХранилищеОбщихНастроек, ХранилищеПользовательскихНастроекОтчетов, ХранилищеВариантовОтчетов,
		|ХранилищеНастроекДанныхФорм, ХранилищеПользовательскихНастроекДинамическихСписков,
		|ХранилищеВнешнихДанныхНавигационныхСсылок, ХранилищеВариантов, ХранилищеНастроек,
		|ОсновнаяФормаОбъекта, ОсновнаяФормаГруппы, ОсновнаяФормаСписка, ОсновнаяФормаДляВыбора,
		|ОсновнаяФормаДляВыбораГруппы, ОсновнаяФормаЗаписи, ОсновнаяФорма, ОсновнаяФормаНастроек, ОсновнаяФормаВарианта,
		|ОсновнаяФормаСохранения, ОсновнаяФормаЗагрузки, ОсновнаяФормаКонстант, ОсновнаяФормаОтчета,
		|ОсновнаяФормаНастроекОтчета, ОсновнаяФормаВариантаОтчета, ОсновнаяФормаПоиска,
		|ОсновнаяФормаНастроекДинамическогоСписка, ОсновнаяФормаВыбораПользователейСистемыВзаимодействия,
		|ОсновнаяФормаИсторииИзмененийИсторииДанных, ОсновнаяФормаДанныхВерсииИсторииДанных,
		|ОсновнаяФормаРазличийВерсийИсторииДанных,
		|ДополнительнаяФормаОбъекта, ДополнительнаяФормаГруппы, ДополнительнаяФормаСписка, ДополнительнаяФормаДляВыбора,
		|ДополнительнаяФормаДляВыбораГруппы, ДополнительнаяФормаЗаписи, ДополнительнаяФорма,
		|ДополнительнаяФормаНастроек, ДополнительнаяФормаВарианта, ДополнительнаяФормаСохранения,
		|ДополнительнаяФормаЗагрузки, ДополнительнаяФормаКонстант, ДополнительнаяФормаОтчета,
		|ДополнительнаяФормаНастроекОтчета, ДополнительнаяФормаВариантаОтчета,
		|ДополнительнаяФормаНастроекДинамическогоСписка, ДополнительнаяФормаВыбораПользователейСистемыВзаимодействия,
		|ДополнительнаяФормаИсторииИзмененийИсторииДанных, ДополнительнаяФормаДанныхВерсииИсторииДанных,
		|ДополнительнаяФормаРазличийВерсийИсторииДанных, ОсновнаяСхемаКомпоновкиДанных, ОсновнойМакетОформленияОтчета");
	Возврат Имена;

КонецФункции

// Возвращает имена коллекций объектов конфигурации верхнего уровня. Вложенные подсистемы обходятся
// через коллекцию Подсистемы самих подсистем. Отсутствующие в версии платформы коллекции пропускаются.
//
// Возвращаемое значение:
//  Массив из Строка - имена свойств-коллекций конфигурации
Функция ИменаКоллекцийКонфигурации()

	Имена = СписокИмен(
		"Подсистемы, ОбщиеМодули, ПараметрыСеанса, Роли, ОбщиеРеквизиты, ПланыОбмена, КритерииОтбора,
		|ПодпискиНаСобытия, РегламентныеЗадания, Боты, ФункциональныеОпции, ПараметрыФункциональныхОпций,
		|ОпределяемыеТипы, ХранилищаНастроек, ОбщиеКоманды, ГруппыКоманд, ОбщиеФормы, ОбщиеМакеты, ОбщиеКартинки,
		|ПакетыXDTO, WebСервисы, HTTPСервисы, WSСсылки, WebSocketКлиенты, СервисыИнтеграции, ЦветаПалитры,
		|ЭлементыСтиля, Стили, Языки, Константы, Справочники, Документы, НумераторыДокументов, Последовательности,
		|ЖурналыДокументов, Перечисления, Отчеты, Обработки, ПланыВидовХарактеристик, ПланыСчетов, ПланыВидовРасчета,
