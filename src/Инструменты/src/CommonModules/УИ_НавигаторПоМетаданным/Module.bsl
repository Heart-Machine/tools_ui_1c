КонецФункции

Процедура ДобавитьГруппуОбратныхСвязей(Группы, Имя, Представление, КлючиСвязей)

	ОписаниеГруппы = Новый Структура;
	ОписаниеГруппы.Вставить("Имя", Имя);
	ОписаниеГруппы.Вставить("Представление", Представление);
	ОписаниеГруппы.Вставить("Порядок", Группы.Количество());
	Для Каждого КлючСвязи Из СписокИмен(КлючиСвязей) Цикл
		Группы.Вставить(КлючСвязи, ОписаниеГруппы);
	КонецЦикла;

КонецПроцедуры

// Возвращает коллекции подчиненных объектов в порядке вывода в составе.
// Список общий для всех видов: у конкретного объекта выводятся только те коллекции, которые у него есть.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка - имя свойства-коллекции объекта метаданных
//   * Представление - Строка - представление коллекции
//   * ВидЭлемента - Строка - вид элементов, если они не объекты метаданных (стандартные реквизиты и табличные части)
Функция КоллекцииСостава()

	Коллекции = Новый Массив;
	ДобавитьКоллекциюСостава(Коллекции, "СтандартныеРеквизиты", НСтр("ru = 'Стандартные реквизиты'"), "СтандартныйРеквизит");
	ДобавитьКоллекциюСостава(Коллекции, "Измерения", НСтр("ru = 'Измерения'"));
	ДобавитьКоллекциюСостава(Коллекции, "Ресурсы", НСтр("ru = 'Ресурсы'"));
	ДобавитьКоллекциюСостава(Коллекции, "Реквизиты", НСтр("ru = 'Реквизиты'"));
	ДобавитьКоллекциюСостава(Коллекции, "РеквизитыАдресации", НСтр("ru = 'Реквизиты адресации'"));
