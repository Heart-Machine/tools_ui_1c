Процедура ДобавитьКоллекциюСостава(Коллекции, Имя, Представление, ВидЭлемента = "")

	ОписаниеКоллекции = Новый Структура;
	ОписаниеКоллекции.Вставить("Имя", Имя);
	ОписаниеКоллекции.Вставить("Представление", Представление);
	ОписаниеКоллекции.Вставить("ВидЭлемента", ВидЭлемента);
	Коллекции.Добавить(ОписаниеКоллекции);

КонецПроцедуры

