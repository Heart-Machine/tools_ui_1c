КонецФункции

Функция НоваяТаблицаЭлементовСостава()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Объект", ТипСтрока);
	Таблица.Колонки.Добавить("Вид", ТипСтрока);
	Таблица.Колонки.Добавить("Использование", ТипСтрока);
	Таблица.Колонки.Добавить("Используется", ТипБулево);
	Таблица.Колонки.Добавить("УсловноеРазделение", ТипСтрока);
	Таблица.Колонки.Добавить("Авторегистрация", ТипБулево);
	Возврат Таблица;

КонецФункции

Процедура ДобавитьУзелОбъекта(Контекст, СтрокиРодителя, Объект, Вид, Ключ)

	Узел = СтрокиРодителя.Добавить();
	Узел.Ключ = Ключ;
	Узел.Вид = Вид;
	Если ТипЗнч(Объект) = Тип("ОбъектМетаданных") Тогда
		Узел.ПолноеИмя = Объект.ПолноеИмя();
	КонецЕсли;

	Значения = ДобавитьСвойстваОбъекта(Контекст, Объект, Ключ);
	Узел.Имя = ЗначениеСвойстваСтрокой(Контекст, Значения, "Имя");
	Узел.Синоним = ЗначениеСвойстваСтрокой(Контекст, Значения, "Синоним");
	ЗаполнитьЗначенияСвойств(Узел, ПризнакиРасширений(Объект, Контекст.КлючКэша));

	// Состав самой конфигурации показывает дерево навигатора.
	Если Вид <> "Конфигурация" Тогда
		Если Вид = "Подсистема" Тогда
			ДобавитьСоставПодсистемы(Контекст, Узел, Объект, Ключ);
		КонецЕсли;
		ДобавитьКоллекцииСостава(Контекст, Узел, Объект, Ключ);
	КонецЕсли;

КонецПроцедуры

// Добавляет узел "Состав" с объектами, которые входят в подсистему. Объекты состава - узлы-ссылки на объекты
// верхнего уровня: ключ узла - полное имя объекта, а свойства и состав объекта при построении не читаются,
// иначе большая подсистема долго открывалась бы. Свойства узла-ссылки читаются при его показе, см. СвойстваОбъекта.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Узел - СтрокаДереваЗначений - узел подсистемы
//  Подсистема - ОбъектМетаданных - подсистема
//  Ключ - Строка - ключ узла подсистемы
Процедура ДобавитьСоставПодсистемы(Контекст, Узел, Подсистема, Ключ)

	УзелСостава = Узел.Строки.Добавить();
	УзелСостава.Ключ = СтрШаблон("%1/Состав", Ключ);
	УзелСостава.Имя = "Состав";
	УзелСостава.Синоним = НСтр("ru = 'Состав'");
	УзелСостава.Вид = "Состав";
	УзелСостава.ЭтоКоллекция = Истина;

	Для Каждого ОбъектСостава Из Подсистема.Состав Цикл
		УзелОбъекта = УзелСостава.Строки.Добавить();
		УзелОбъекта.ПолноеИмя = ОбъектСостава.ПолноеИмя();
		УзелОбъекта.Ключ = УзелОбъекта.ПолноеИмя;
		УзелОбъекта.Вид = ВидОбъектаМетаданных(ОбъектСостава);
		УзелОбъекта.Имя = ОбъектСостава.Имя;
		УзелОбъекта.Синоним = ОбъектСостава.Синоним;
		УзелОбъекта.ЭтоСсылка = Истина;
		ЗаполнитьЗначенияСвойств(УзелОбъекта, ПризнакиРасширений(ОбъектСостава, Контекст.КлючКэша));
	КонецЦикла;

	УзелСостава.Количество = УзелСостава.Строки.Количество();
	Если УзелСостава.Количество = 0 Тогда
		Узел.Строки.Удалить(УзелСостава);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКоллекцииСостава(Контекст, Узел, Объект, Ключ)

	Коллекции = Новый Структура(Контекст.ШаблонКоллекций);
	ЗаполнитьЗначенияСвойств(Коллекции, Объект);

	Для Каждого ОписаниеКоллекции Из Контекст.КоллекцииСостава Цикл
		Коллекция = Коллекции[ОписаниеКоллекции.Имя];
		Если Коллекция = Контекст.Маркер Тогда
			Продолжить;
		КонецЕсли;

		УзелКоллекции = Узел.Строки.Добавить();
		УзелКоллекции.Ключ = СтрШаблон("%1/%2", Ключ, ОписаниеКоллекции.Имя);
		УзелКоллекции.Имя = ОписаниеКоллекции.Имя;
		УзелКоллекции.Синоним = ОписаниеКоллекции.Представление;
		УзелКоллекции.Вид = ОписаниеКоллекции.Имя;
		УзелКоллекции.ЭтоКоллекция = Истина;

		Для Каждого Элемент Из Коллекция Цикл
			Если ЗначениеЗаполнено(ОписаниеКоллекции.ВидЭлемента) Тогда
				// Описания стандартных реквизитов и табличных частей - не объекты метаданных, полного имени у них нет.
				ВидЭлемента = ОписаниеКоллекции.ВидЭлемента;
				КлючЭлемента = СтрШаблон("%1.%2.%3", Ключ, ВидЭлемента, Элемент.Имя);
			Иначе
				ВидЭлемента = ВидОбъектаМетаданных(Элемент);
				КлючЭлемента = Элемент.ПолноеИмя();
			КонецЕсли;
			ДобавитьУзелОбъекта(Контекст, УзелКоллекции.Строки, Элемент, ВидЭлемента, КлючЭлемента);
		КонецЦикла;

		// У коллекции ОписанияСтандартныхТабличныхЧастей (планы счетов и планы видов расчета) нет метода Количество,
		// поэтому количество элементов берется по добавленным узлам.
		УзелКоллекции.Количество = УзелКоллекции.Строки.Количество();
		Если УзелКоллекции.Количество = 0 Тогда
			Узел.Строки.Удалить(УзелКоллекции);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСвойств

// Добавляет в таблицу свойств все свойства объекта из групп свойств.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Объект - ОбъектМетаданных, ОписаниеСтандартногоРеквизита, ОписаниеСтандартнойТабличнойЧасти - объект
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Структура - прочитанные значения свойств; у отсутствующих свойств значение равно маркеру контекста
Функция ДобавитьСвойстваОбъекта(Контекст, Объект, КлючУзла)

	Значения = Новый Структура(Контекст.ШаблонСвойств);
	ЗаполнитьЗначенияСвойств(Значения, Объект);

	Для Каждого Группа Из Контекст.ГруппыСвойств Цикл
		Для Каждого ИмяСвойства Из Группа.Свойства Цикл
			Значение = Значения[ИмяСвойства];
			Если Значение = Контекст.Маркер Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоСоставОбщегоРеквизитаИлиПланаОбмена(Значение) Тогда
				// Состав общего реквизита и плана обмена выводится отдельной таблицей.
				ДобавитьЭлементыСостава(Контекст, Значение, Объект);
				Продолжить;
			КонецЕсли;
			Ссылки = Новый Массив;
			Представление = ПредставлениеЗначенияСвойства(Контекст, Значение, Объект, Ссылки);
			ДобавитьСвойство(Контекст, КлючУзла, Группа, ИмяСвойства, Представление, Ссылки);
		КонецЦикла;

		Если Группа.Имя = "Основные" Тогда
			ДобавитьСлужебныеСвойства(Контекст, Объект, КлючУзла, Группа);
		КонецЕсли;
	КонецЦикла;

	ДобавитьЭлементыКоллекцийСвойств(Контекст, Объект, КлючУзла);

	Возврат Значения;

КонецФункции

// Добавляет свойства-коллекции, каждый элемент которых выводится отдельным свойством своей группы,
// см. КоллекцииСвойств.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Объект - ОбъектМетаданных, ОписаниеСтандартногоРеквизита, ОписаниеСтандартнойТабличнойЧасти - объект
//  КлючУзла - Строка - ключ узла состава
Процедура ДобавитьЭлементыКоллекцийСвойств(Контекст, Объект, КлючУзла)

	Коллекции = Новый Структура(Контекст.ШаблонКоллекцийСвойств);
	ЗаполнитьЗначенияСвойств(Коллекции, Объект);

	Для Каждого Группа Из Контекст.КоллекцииСвойств Цикл
		Коллекция = Коллекции[Группа.Имя];
		Если Коллекция = Контекст.Маркер Или Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Группа.Имя = "ДополнительныеИндексы" Тогда
			Для Каждого Индекс Из Коллекция Цикл
				ДобавитьСвойство(Контекст, КлючУзла, Группа, Индекс.Имя, ПредставлениеДополнительногоИндекса(Индекс));
			КонецЦикла;
		ИначеЕсли Группа.Имя = "Агрегаты" Тогда
			Для Каждого Агрегат Из Коллекция Цикл
				ДобавитьСвойство(Контекст, КлючУзла, Группа, Строка(Агрегат.Периодичность), ПредставлениеАгрегата(Агрегат));
			КонецЦикла;
		ИначеЕсли Группа.Имя = "Характеристики" Тогда
			ДобавитьСвойстваХарактеристик(Контекст, Коллекция, Объект, КлючУзла, Группа);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет описания характеристик: каждое описание выводится своей группой свойств.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Характеристики - ОписанияХарактеристик - описания характеристик объекта
//  Владелец - ОбъектМетаданных - объект с характеристиками
//  КлючУзла - Строка - ключ узла состава
//  ГруппаХарактеристик - Структура - описание группы, см. КоллекцииСвойств
Процедура ДобавитьСвойстваХарактеристик(Контекст, Характеристики, Владелец, КлючУзла, ГруппаХарактеристик)

	ИменаСвойств = СписокИмен(
		"ВидыХарактеристик, ПолеКлюча, ПолеОтбораВидов, ЗначениеОтбораВидов, ПолеПутиКДанным,
		|ЗначенияХарактеристик, ПолеОбъекта, ПолеВида, ПолеЗначения, ПолеИспользованияМножественныхЗначений,
		|ПолеКлючаМножественныхЗначений, ПолеПорядкаМножественныхЗначений");

	Номер = 0;
	Для Каждого Описание Из Характеристики Цикл
		Номер = Номер + 1;
		Группа = ГруппаХарактеристик;
		Если Характеристики.Количество() > 1 Тогда
			Группа = Новый Структура("Имя, Представление",
				СтрШаблон("%1%2", ГруппаХарактеристик.Имя, Номер),
				СтрШаблон("%1 (%2)", ГруппаХарактеристик.Представление, Номер));
		КонецЕсли;

		Значения = Новый Структура(СтрСоединить(ИменаСвойств, ","));
		ЗаполнитьЗначенияСвойств(Значения, Описание);
		Для Каждого ИмяСвойства Из ИменаСвойств Цикл
			Значение = Значения[ИмяСвойства];
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Ссылки = Новый Массив;
			Если ТипЗнч(Значение) = Тип("ОбъектМетаданных") Тогда
				Представление = ПредставлениеЗначенияСвойства(Контекст, Значение, Владелец, Ссылки);
			ИначеЕсли ИмяСвойства = "ЗначениеОтбораВидов" Тогда
				Представление = Строка(Значение);
			Иначе
				Представление = ИмяПоля(Значение);
			КонецЕсли;
			ДобавитьСвойство(Контекст, КлючУзла, Группа, ИмяСвойства, Представление, Ссылки);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоСоставОбщегоРеквизитаИлиПланаОбмена(Значение)

	ТипЗначения = ТипЗнч(Значение);
	ЭтоСостав = (ТипЗначения = Тип("СоставОбщегоРеквизита") Или ТипЗначения = Тип("СоставПланаОбмена"));
	Возврат ЭтоСостав;

КонецФункции

// Добавляет состав общего реквизита или плана обмена в таблицу элементов состава.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Состав - СоставОбщегоРеквизита, СоставПланаОбмена - состав
//  Владелец - ОбъектМетаданных - общий реквизит или план обмена
Процедура ДобавитьЭлементыСостава(Контекст, Состав, Владелец)

	ЭтоСоставОбщегоРеквизита = (ТипЗнч(Состав) = Тип("СоставОбщегоРеквизита"));
	Для Каждого Элемент Из Состав Цикл
		Если Элемент.Метаданные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Контекст.ЭлементыСостава.Добавить();
		НоваяСтрока.Объект = Элемент.Метаданные.ПолноеИмя();
		НоваяСтрока.Вид = ВидОбъектаМетаданных(Элемент.Метаданные);
		Если ЭтоСоставОбщегоРеквизита Тогда
			НоваяСтрока.Используется = ЭлементСоставаОбщегоРеквизитаИспользуется(Элемент, Владелец);
			НоваяСтрока.Использование = ПредставлениеИспользованияОбщегоРеквизита(Элемент.Использование,
																				   НоваяСтрока.Используется);
			Если ТипЗнч(Элемент.УсловноеРазделение) = Тип("ОбъектМетаданных") Тогда
				НоваяСтрока.УсловноеРазделение = Элемент.УсловноеРазделение.ПолноеИмя();
			КонецЕсли;
		Иначе
			НоваяСтрока.Используется = Истина;
			НоваяСтрока.Авторегистрация = (Элемент.АвтоРегистрация = АвтоРегистрацияИзменений.Разрешить);
		КонецЕсли;
	КонецЦикла;

	// Объекты, у которых общий реквизит используется, выводятся первыми.
	Контекст.ЭлементыСостава.Сортировать("Используется Убыв, Объект");

КонецПроцедуры

Функция ПредставлениеИспользованияОбщегоРеквизита(Использование, Используется)

	Если Использование <> Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто Тогда
		Представление = Строка(Использование);
	ИначеЕсли Используется Тогда
		Представление = НСтр("ru = 'Авто (используется)'");
	Иначе
		Представление = НСтр("ru = 'Авто (не используется)'");
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Свойства, которые читаются методами объекта метаданных, а не его свойствами.
Процедура ДобавитьСлужебныеСвойства(Контекст, Объект, КлючУзла, Группа)

	Если ТипЗнч(Объект) <> Тип("ОбъектМетаданных") Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСвойство(Контекст, КлючУзла, Группа, "ПолноеИмя", Объект.ПолноеИмя());

	Попытка
		Расширение = Объект.РасширениеКонфигурации();
		ЕстьИзменения = Объект.ЕстьИзмененияРасширениямиКонфигурации();
	Исключение
		// Методов нет в старых версиях платформы и у части метаданных, загруженных из файла.
		Возврат;
	КонецПопытки;

	Если Расширение <> Неопределено Тогда
		ДобавитьСвойство(Контекст, КлючУзла, Группа, "РасширениеКонфигурации", Расширение.Имя);
	КонецЕсли;
	ДобавитьСвойство(Контекст, КлючУзла, Группа, "ЕстьИзмененияРасширениямиКонфигурации", ПредставлениеБулево(ЕстьИзменения));

КонецПроцедуры

Процедура ДобавитьСвойство(Контекст, КлючУзла, Группа, Имя, Значение, Ссылки = Неопределено)

	НоваяСтрока = Контекст.Свойства.Добавить();
	НоваяСтрока.КлючУзла = КлючУзла;
	НоваяСтрока.ИмяГруппы = Группа.Имя;
	НоваяСтрока.Группа = Группа.Представление;
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Значение = Значение;
	Если Ссылки <> Неопределено Тогда
		НоваяСтрока.Ссылки = СтрСоединить(Ссылки, Символы.ПС);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСвойстваСтрокой(Контекст, Значения, ИмяСвойства)

	Значение = Значения[ИмяСвойства];
	Если Значение = Контекст.Маркер Или Значение = Неопределено Тогда
		ЗначениеСтрокой = "";
	Иначе
		ЗначениеСтрокой = Строка(Значение);
	КонецЕсли;
	Возврат ЗначениеСтрокой;

КонецФункции

#КонецОбласти

#Область ПредставлениеЗначений

// Возвращает представление значения свойства объекта метаданных.
//
// Параметры:
//  Контекст - см. НовыйКонтекстЗаполнения
//  Значение - Произвольный - значение свойства
//  Владелец - ОбъектМетаданных, ОписаниеСтандартногоРеквизита, ОписаниеСтандартнойТабличнойЧасти - объект со свойством
//  Ссылки - Массив из Строка - сюда добавляются полные имена объектов метаданных из значения
//
// Возвращаемое значение:
//  Строка - представление значения
Функция ПредставлениеЗначенияСвойства(Контекст, Значение, Владелец, Ссылки)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Представление = "";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Представление = ПредставлениеБулево(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Представление = Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Представление = Значение;
	ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
		Представление = ПредставлениеОписанияТипов(Контекст, Значение, Ссылки);
	ИначеЕсли ТипЗначения = Тип("ОбъектМетаданных") Тогда
		Представление = Значение.ПолноеИмя();
		Ссылки.Добавить(Представление);
	ИначеЕсли ЭтоКоллекцияЗначений(ТипЗначения) Тогда
		// Состав общего реквизита и плана обмена сюда не попадает: он выводится отдельной таблицей.
		Представления = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Представления.Добавить(ПредставлениеЗначенияСвойства(Контекст, Элемент, Владелец, Ссылки));
		КонецЦикла;
		Представление = СтрСоединить(Представления, ", ");
	ИначеЕсли ТипЗначения = Тип("ПараметрВыбора") Тогда
		Представление = СтрШаблон("%1 = %2", Значение.Имя, Значение.Значение);
	ИначеЕсли ТипЗначения = Тип("СвязьПараметраВыбора") Тогда
		Представление = СтрШаблон("%1 = %2", Значение.Имя, Значение.ПутьКДанным);
	ИначеЕсли ТипЗначения = Тип("СвязьПоТипу") Тогда
		Представление = Значение.ПутьКДанным;
	Иначе
		Представление = Строка(Значение);
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Возвращает представление дополнительного индекса: таблица, индексируемые и дополнительные поля.
//
// Параметры:
//  Индекс - ДополнительныйИндекс - индекс
//
// Возвращаемое значение:
//  Строка - представление индекса
Функция ПредставлениеДополнительногоИндекса(Индекс)

	Представление = СтрСоединить(ИменаПолей(Индекс.ИндексируемыеПоля), ", ");
	ДополнительныеПоля = ИменаПолей(Индекс.ДополнительныеПоля);
	Если ДополнительныеПоля.Количество() > 0 Тогда
		Представление = СтрШаблон(НСтр("ru = '%1; дополнительные поля: %2'"), Представление,
								  СтрСоединить(ДополнительныеПоля, ", "));
	КонецЕсли;
	Если ЗначениеЗаполнено(Индекс.Таблица) Тогда
		Представление = СтрШаблон(НСтр("ru = 'Таблица %1: %2'"), Индекс.Таблица, Представление);
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Возвращает представление агрегата регистра накопления из метаданных: измерения и использование.
//
// Параметры:
//  Агрегат - АгрегатРегистраНакопления - агрегат
//
// Возвращаемое значение:
//  Строка - представление агрегата
Функция ПредставлениеАгрегата(Агрегат)

	Измерения = ИменаПолей(Агрегат.Измерения);
	Если Измерения.Количество() = 0 Тогда
		ПредставлениеИзмерений = НСтр("ru = 'без измерений'");
	Иначе
		ПредставлениеИзмерений = СтрСоединить(Измерения, ", ");
	КонецЕсли;
	Представление = СтрШаблон(НСтр("ru = '%1; использование: %2'"), ПредставлениеИзмерений, Агрегат.Использование);
	Возврат Представление;

КонецФункции

// Возвращает имена полей из коллекции полей индекса, агрегата и т. п.
//
// Параметры:
//  Поля - Произвольный - коллекция полей: строк, объектов метаданных или описаний полей; Неопределено, если полей нет
//
// Возвращаемое значение:
//  Массив из Строка - имена полей
Функция ИменаПолей(Поля)

	Имена = Новый Массив;
	Если Поля <> Неопределено Тогда
		Для Каждого Поле Из Поля Цикл
			Имена.Добавить(ИмяПоля(Поле));
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Возвращает имя поля: у строки - саму строку, у объектов метаданных и описаний полей - значение свойства Имя.
//
// Параметры:
//  Поле - Произвольный - поле
//
// Возвращаемое значение:
//  Строка - имя поля
Функция ИмяПоля(Поле)

	Если Поле = Неопределено Тогда
		Имя = "";
	ИначеЕсли ТипЗнч(Поле) = Тип("Строка") Тогда
		Имя = Поле;
	Иначе
		СвойстваПоля = Новый Структура("Имя");
		ЗаполнитьЗначенияСвойств(СвойстваПоля, Поле);
		Имя = ?(СвойстваПоля.Имя = Неопределено, Строка(Поле), Строка(СвойстваПоля.Имя));
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ЭлементСоставаОбщегоРеквизитаИспользуется(Элемент, ОбщийРеквизит)

	ИспользованиеОбщегоРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита;
	Если Элемент.Использование = ИспользованиеОбщегоРеквизита.Авто Тогда
		АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
		Используется = (ОбщийРеквизит.АвтоИспользование = АвтоИспользование);
	Иначе
		Используется = (Элемент.Использование = ИспользованиеОбщегоРеквизита.Использовать);
	КонецЕсли;
	Возврат Используется;

КонецФункции

Функция ЭтоКоллекцияЗначений(ТипЗначения)

	ЭтоКоллекция = (ТипЗначения = Тип("КоллекцияОбъектовМетаданных")
		Или ТипЗначения = Тип("СоставОбщегоРеквизита")
		Или ТипЗначения = Тип("СоставПланаОбмена")
		Или ТипЗначения = Тип("ФиксированныйМассив")
		Или ТипЗначения = Тип("Массив"));
	Возврат ЭтоКоллекция;

КонецФункции

Функция ПредставлениеОписанияТипов(Контекст, ОписаниеТипов, Ссылки)

	Представления = Новый Массив;
	Для Каждого ТекущийТип Из ОписаниеТипов.Типы() Цикл
		ОбъектТипа = Контекст.МетаданныеКонфигурации.НайтиПоТипу(ТекущийТип);
		Если ОбъектТипа = Неопределено Тогда
			Представления.Добавить(ПредставлениеПримитивногоТипа(ТекущийТип, ОписаниеТипов));
		Иначе
			ПолноеИмя = ОбъектТипа.ПолноеИмя();
			Ссылки.Добавить(ПолноеИмя);
			Представления.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Представление = СтрСоединить(Представления, ", ");
	Возврат Представление;

КонецФункции

Функция ПредставлениеПримитивногоТипа(ТекущийТип, ОписаниеТипов)

	Если ТекущийТип = Тип("Строка") Тогда
		Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
		Если Длина = 0 Тогда
			Представление = НСтр("ru = 'Строка (неограниченная)'");
		Иначе
			Представление = СтрШаблон(НСтр("ru = 'Строка (%1)'"), Формат(Длина, "ЧГ=0"));
		КонецЕсли;

	ИначеЕсли ТекущийТип = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Если Квалификаторы.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный Тогда
			ШаблонПредставления = НСтр("ru = 'Число (%1, %2), неотрицательное'");
		Иначе
			ШаблонПредставления = НСтр("ru = 'Число (%1, %2)'");
		КонецЕсли;
		Представление = СтрШаблон(ШаблонПредставления,
								  Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=0"),
								  Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=0"));

	ИначеЕсли ТекущийТип = Тип("Дата") Тогда
		Представление = СтрШаблон(НСтр("ru = 'Дата (%1)'"), ОписаниеТипов.КвалификаторыДаты.ЧастиДаты);

	Иначе
		Представление = Строка(ТекущийТип);
	КонецЕсли;
	Возврат Представление;

КонецФункции

Функция ПредставлениеБулево(Значение)

	Представление = ?(Значение, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
	Возврат Представление;

КонецФункции

#КонецОбласти

#Область ОбратныеСвязи

Функция НовыйКонтекстИндекса(МетаданныеКонфигурации)

	Маркер = Новый УникальныйИдентификатор;

	ШаблонСвойств = Новый Структура;
	Для Каждого ИмяСвойства Из ИменаСсылочныхСвойств() Цикл
		ШаблонСвойств.Вставить(ИмяСвойства, Маркер);
	КонецЦикла;

	// Стандартные реквизиты и табличные части не обходятся: их типы задает платформа.
	КоллекцииСостава = Новый Массив;
	ШаблонКоллекций = Новый Структура;
	Для Каждого ОписаниеКоллекции Из КоллекцииСостава() Цикл
		Если ПустаяСтрока(ОписаниеКоллекции.ВидЭлемента) Тогда
			КоллекцииСостава.Добавить(ОписаниеКоллекции);
			ШаблонКоллекций.Вставить(ОписаниеКоллекции.Имя, Маркер);
		КонецЕсли;
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("МетаданныеКонфигурации", МетаданныеКонфигурации);
	Контекст.Вставить("Маркер", Маркер);
	Контекст.Вставить("ШаблонСвойств", Новый ФиксированнаяСтруктура(ШаблонСвойств));
	Контекст.Вставить("КоллекцииСостава", КоллекцииСостава);
	Контекст.Вставить("ШаблонКоллекций", Новый ФиксированнаяСтруктура(ШаблонКоллекций));
	Контекст.Вставить("ОписанияВидов", Новый Соответствие);
	Контекст.Вставить("ПолныеИменаТипов", Новый Соответствие);
	Контекст.Вставить("Связи", Новый Соответствие);
	Возврат Контекст;

КонецФункции

// Добавляет в индекс ссылки объекта на другие объекты и обходит его подчиненные объекты.
// Читаются только те ссылочные свойства и коллекции, которые есть у вида объекта, см. НовоеОписаниеВидаДляИндекса.
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  Объект - ОбъектМетаданных, ОбъектМетаданныхКонфигурация - объект
//  ОписаниеВида - см. НовоеОписаниеВидаДляИндекса
//  Ключ - Строка - полное имя объекта
Процедура ДобавитьСвязиУзла(Контекст, Объект, ОписаниеВида, Ключ)

	Вид = ОписаниеВида.Вид;
	Связи = Контекст.Связи;
	Для Каждого ИмяСвойства Из ОписаниеВида.Свойства Цикл
		Значение = Объект[ИмяСвойства];
		// Незаполненные ссылки и пустые строки встречаются чаще всего, а ссылок на объекты не содержат.
		Если Значение = Неопределено Или Значение = "" Тогда
			Продолжить;
		КонецЕсли;

		ПолныеИменаЦелей = ПолныеИменаИзЗначения(Контекст, Значение, Объект, Вид, ИмяСвойства);
		// Связь через свойство одинакова для всех объектов, на которые оно ссылается, поэтому создается один раз.
		Связь = Неопределено;
		Для Каждого ПолноеИмяЦели Из ПолныеИменаЦелей Цикл
			Если ПолноеИмяЦели = Ключ Тогда
				Продолжить;
			КонецЕсли;
			Если Связь = Неопределено Тогда
				Связь = Новый ФиксированнаяСтруктура("Объект, Вид, Свойство", Ключ, Вид, ИмяСвойства);
			КонецЕсли;
			СвязиЦели = Связи[ПолноеИмяЦели];
			Если СвязиЦели = Неопределено Тогда
				СвязиЦели = Новый Массив;
				Связи.Вставить(ПолноеИмяЦели, СвязиЦели);
			КонецЕсли;
			СвязиЦели.Добавить(Связь);
		КонецЦикла;
	КонецЦикла;

	Для Каждого ОписаниеКоллекции Из ОписаниеВида.Коллекции Цикл
		Если Не ОписаниеКоллекции.БезСвязей Тогда
			Коллекция = Объект[ОписаниеКоллекции.Имя];
			ДобавитьСвязиКоллекции(Контекст, Коллекция, ОписаниеКоллекции, ОписаниеВида.Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет в индекс связи элементов коллекции: объектов конфигурации одного вида или подчиненных объектов.
// Все элементы коллекции одного вида, поэтому описание вида определяется по первому элементу и запоминается
// в описании коллекции. Если элементам нечего добавить в индекс (у их вида нет ни ссылочных свойств,
// ни подчиненных коллекций), коллекция помечается и больше не обходится ни у одного владельца этого вида.
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  Коллекция - КоллекцияОбъектовМетаданных - элементы коллекции
//  ОписаниеКоллекции - см. НовоеОписаниеКоллекцииДляИндекса
//  КлючВидаВладельца - Строка - ключ вида владельца коллекции, для коллекций конфигурации пустая строка
Процедура ДобавитьСвязиКоллекции(Контекст, Коллекция, ОписаниеКоллекции, КлючВидаВладельца)

	ОписаниеВида = ОписаниеКоллекции.ОписаниеВидаЭлементов;
	Для Каждого Элемент Из Коллекция Цикл
		ПолноеИмяЭлемента = Элемент.ПолноеИмя();
		Если ОписаниеВида = Неопределено Тогда
			ВидЭлемента = ВидПоПолномуИмени(ПолноеИмяЭлемента);
			ОписаниеВида = ОписаниеВидаДляИндекса(Контекст, Элемент, ВидЭлемента, КлючВидаВладельца);
			ОписаниеКоллекции.ОписаниеВидаЭлементов = ОписаниеВида;
			Если ОписаниеВида.БезСвязей Тогда
				ОписаниеКоллекции.БезСвязей = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСвязиУзла(Контекст, Элемент, ОписаниеВида, ПолноеИмяЭлемента);
	КонецЦикла;

КонецПроцедуры

// Возвращает описание вида объекта для обхода индекса, при первом обращении к виду создает его.
// Одноименные подчиненные объекты бывают разных классов в зависимости от владельца: реквизиты справочника
// и его табличной части, измерения регистра и его перерасчета. Поэтому вид определяется цепочкой видов
// от объекта верхнего уровня, например "Справочник.ТабличнаяЧасть.Реквизит".
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  Объект - ОбъектМетаданных, ОбъектМетаданныхКонфигурация - первый объект вида
//  Вид - Строка - вид объекта
//  КлючВидаВладельца - Строка - ключ вида владельца, для объектов верхнего уровня пустая строка
//
// Возвращаемое значение:
//  см. НовоеОписаниеВидаДляИндекса
Функция ОписаниеВидаДляИндекса(Контекст, Объект, Вид, КлючВидаВладельца)

	Если ПустаяСтрока(КлючВидаВладельца) Тогда
		КлючВида = Вид;
	Иначе
		КлючВида = СтрШаблон("%1.%2", КлючВидаВладельца, Вид);
	КонецЕсли;

	ОписаниеВида = Контекст.ОписанияВидов[КлючВида];
	Если ОписаниеВида = Неопределено Тогда
		ОписаниеВида = НовоеОписаниеВидаДляИндекса(Контекст, Объект, КлючВида, Вид);
		Контекст.ОписанияВидов.Вставить(КлючВида, ОписаниеВида);
	КонецЕсли;
	Возврат ОписаниеВида;

КонецФункции

// Определяет по первому объекту вида, какие из ссылочных свойств и коллекций состава у вида есть.
// Набор свойств задается классом объекта метаданных, поэтому у всех объектов вида он одинаковый.
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  Объект - ОбъектМетаданных, ОбъектМетаданныхКонфигурация - первый объект вида
//  КлючВида - Строка - цепочка видов от объекта верхнего уровня до объекта
//  Вид - Строка - вид объекта
//
// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка - цепочка видов от объекта верхнего уровня до объекта
//   * Вид - Строка - вид объекта
//   * Свойства - Массив из Строка - имена ссылочных свойств вида
//   * Коллекции - Массив из см. НовоеОписаниеКоллекцииДляИндекса - коллекции подчиненных объектов вида
//   * БезСвязей - Булево - у вида нет ни ссылочных свойств, ни коллекций подчиненных объектов
Функция НовоеОписаниеВидаДляИндекса(Контекст, Объект, КлючВида, Вид)

	Свойства = Новый Массив;
	Значения = Новый Структура(Контекст.ШаблонСвойств);
	ЗаполнитьЗначенияСвойств(Значения, Объект);
	Для Каждого Свойство Из Значения Цикл
		Если Свойство.Значение <> Контекст.Маркер Тогда
			Свойства.Добавить(Свойство.Ключ);
		КонецЕсли;
	КонецЦикла;

	// Объекты самой конфигурации обходятся по ее коллекциям, см. ИндексОбратныхСвязей.
	Коллекции = Новый Массив;
	Если Вид <> "Конфигурация" Тогда
		ЗначенияКоллекций = Новый Структура(Контекст.ШаблонКоллекций);
		ЗаполнитьЗначенияСвойств(ЗначенияКоллекций, Объект);
		Для Каждого ОписаниеКоллекцииСостава Из Контекст.КоллекцииСостава Цикл
			Если ЗначенияКоллекций[ОписаниеКоллекцииСостава.Имя] <> Контекст.Маркер Тогда
				Коллекции.Добавить(НовоеОписаниеКоллекцииДляИндекса(ОписаниеКоллекцииСостава.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ОписаниеВида = Новый Структура;
	ОписаниеВида.Вставить("Ключ", КлючВида);
	ОписаниеВида.Вставить("Вид", Вид);
	ОписаниеВида.Вставить("Свойства", Свойства);
	ОписаниеВида.Вставить("Коллекции", Коллекции);
	ОписаниеВида.Вставить("БезСвязей", Свойства.Количество() = 0 И Коллекции.Количество() = 0);
	Возврат ОписаниеВида;

КонецФункции

// Возвращает описание коллекции для обхода индекса. Описание вида элементов заполняется по первому элементу,
// см. ДобавитьСвязиКоллекции.
//
// Параметры:
//  Имя - Строка - имя свойства-коллекции
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя свойства-коллекции
//   * ОписаниеВидаЭлементов - Неопределено, Структура - см. НовоеОписаниеВидаДляИндекса описание вида элементов
//   * БезСвязей - Булево - элементам коллекции нечего добавить в индекс
Функция НовоеОписаниеКоллекцииДляИндекса(Имя)

	ОписаниеКоллекции = Новый Структура;
	ОписаниеКоллекции.Вставить("Имя", Имя);
	ОписаниеКоллекции.Вставить("ОписаниеВидаЭлементов", Неопределено);
	ОписаниеКоллекции.Вставить("БезСвязей", Ложь);
	Возврат ОписаниеКоллекции;

КонецФункции

// Возвращает полные имена объектов метаданных, на которые ссылается значение свойства.
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  Значение - Произвольный - значение свойства
//  Владелец - ОбъектМетаданных - объект со свойством
//  ВидВладельца - Строка - вид объекта со свойством
//  ИмяСвойства - Строка - имя свойства
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов метаданных
Функция ПолныеИменаИзЗначения(Контекст, Значение, Владелец, ВидВладельца, ИмяСвойства)

	ПолныеИмена = Новый Массив;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("ОбъектМетаданных") Тогда
		ПолныеИмена.Добавить(Значение.ПолноеИмя());

	ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
		ПолныеИменаТипов = Контекст.ПолныеИменаТипов;
		Для Каждого ТекущийТип Из Значение.Типы() Цикл
			// Почти все типы уже есть в кэше, поэтому объект метаданных ищется только при первой встрече типа.
			ПолноеИмяТипа = ПолныеИменаТипов[ТекущийТип];
			Если ПолноеИмяТипа = Неопределено Тогда
				ПолноеИмяТипа = ПолноеИмяОбъектаТипа(Контекст, ТекущийТип);
			КонецЕсли;
			Если ПолноеИмяТипа <> "" Тогда
				ПолныеИмена.Добавить(ПолноеИмяТипа);
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ЭтоКоллекцияЗначений(ТипЗначения) Тогда
		Для Каждого Элемент Из Значение Цикл
			ПолноеИмяЭлемента = ПолноеИмяЭлементаКоллекции(Элемент, Владелец);
			Если ЗначениеЗаполнено(ПолноеИмяЭлемента) Тогда
				ПолныеИмена.Добавить(ПолноеИмяЭлемента);
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ТипЗначения = Тип("Строка") И ЭтоИмяПроцедурыОбщегоМодуля(ВидВладельца, ИмяСвойства) Тогда
		// Обработчик подписки и метод регламентного задания задаются строкой "ИмяМодуля.ИмяПроцедуры".
		ЧастиИмени = СтрРазделить(Значение, ".", Ложь);
		Если ЧастиИмени.Количество() > 1 Тогда
			ПолныеИмена.Добавить(СтрШаблон("ОбщийМодуль.%1", ЧастиИмени[0]));
		КонецЕсли;
	КонецЕсли;
	Возврат ПолныеИмена;

КонецФункции

// Находит полное имя объекта метаданных по типу и запоминает его в кэше контекста.
//
// Параметры:
//  Контекст - см. НовыйКонтекстИндекса
//  ТекущийТип - Тип - тип из описания типов
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных, для типов вне конфигурации пустая строка
Функция ПолноеИмяОбъектаТипа(Контекст, ТекущийТип)

	ОбъектТипа = Контекст.МетаданныеКонфигурации.НайтиПоТипу(ТекущийТип);
	Если ОбъектТипа = Неопределено Тогда
		ПолноеИмя = "";
	Иначе
		ПолноеИмя = ОбъектТипа.ПолноеИмя();
	КонецЕсли;
	Контекст.ПолныеИменаТипов.Вставить(ТекущийТип, ПолноеИмя);
	Возврат ПолноеИмя;

КонецФункции

Функция ПолноеИмяЭлементаКоллекции(Элемент, Владелец)

	ПолноеИмя = "";
	ТипЭлемента = ТипЗнч(Элемент);
	Если ТипЭлемента = Тип("ОбъектМетаданных") Тогда
		ПолноеИмя = Элемент.ПолноеИмя();
	ИначеЕсли ТипЭлемента = Тип("ЭлементСоставаОбщегоРеквизита") Тогда
		Если ЭлементСоставаОбщегоРеквизитаИспользуется(Элемент, Владелец) Тогда
			ПолноеИмя = Элемент.Метаданные.ПолноеИмя();
		КонецЕсли;
	ИначеЕсли ТипЭлемента = Тип("ЭлементСоставаПланаОбмена") Тогда
		ПолноеИмя = Элемент.Метаданные.ПолноеИмя();
	КонецЕсли;
	Возврат ПолноеИмя;

КонецФункции

Функция ЭтоИмяПроцедурыОбщегоМодуля(ВидВладельца, ИмяСвойства)

	ЭтоИмяПроцедуры = (ВидВладельца = "ПодпискаНаСобытие" И ИмяСвойства = "Обработчик")
		Или (ВидВладельца = "РегламентноеЗадание" И ИмяСвойства = "ИмяМетода");
	Возврат ЭтоИмяПроцедуры;

КонецФункции

Функция НоваяТаблицаОбратныхСвязей()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КлючУзла", ТипСтрока);
	Таблица.Колонки.Добавить("ИмяГруппы", ТипСтрока);
	Таблица.Колонки.Добавить("Группа", ТипСтрока);
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Объект", ТипСтрока);
	Таблица.Колонки.Добавить("Вид", ТипСтрока);
	Таблица.Колонки.Добавить("Свойство", ТипСтрока);
	Возврат Таблица;

КонецФункции

// Возвращает группу обратной связи: сначала по виду объекта и свойству, затем по свойству, затем по началу
// имени свойства. Связи через свойства, не описанные в ГруппыОбратныхСвязей, попадают в группу по имени свойства.
//
// Параметры:
//  Группы - см. ГруппыОбратныхСвязей
//  Вид - Строка - вид объекта, который ссылается
//  Свойство - Строка - имя свойства, через которое он ссылается
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Представление - Строка
//   * Порядок - Число
Функция ГруппаОбратнойСвязи(Группы, Вид, Свойство)

	Группа = Группы[СтрШаблон("%1.%2", Вид, Свойство)];
	Если Группа = Неопределено Тогда
		Группа = Группы[Свойство];
	КонецЕсли;
	Если Группа = Неопределено Тогда
		Для Каждого Префикс Из СтрРазделить("ОсновнаяФорма,ДополнительнаяФорма,Хранилище", ",") Цикл
			Если СтрНачинаетсяС(Свойство, Префикс) Тогда
				Группа = Группы[СтрШаблон("%1*", Префикс)];
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Группа = Неопределено Тогда
		Группа = Новый Структура;
		Группа.Вставить("Имя", Свойство);
		Группа.Вставить("Представление", СтрШаблон(НСтр("ru = 'Свойство %1'"), Свойство));
		Группа.Вставить("Порядок", 1000);
	КонецЕсли;
	Возврат Группа;

КонецФункции

#КонецОбласти

#Область ПраваРолей

// Возвращает роли, которые дают права на узел состава, и добавляет в результат права узла, колонки прав
// таблицы пользователей и пояснение, если ролей с правами нет. Для роли возвращается она сама, без прав.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//  Результат - см. ПраваПользователейНаОбъект
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - полное имя роли
//   * Значение - СтрокаТаблицыЗначений, Булево - права роли, см. ПраваРолейНаОбъектСеанса; у самой роли - Истина
Функция РолиСПравамиНаУзел(НайденныйОбъект, КлючУзла, Результат)

	РолиСПравами = Новый Соответствие;
	Если ВидПоПолномуИмени(КлючУзла) = "Роль" Тогда
		Если ОбъектМетаданныхСеанса(НайденныйОбъект, КлючУзла) = Неопределено Тогда
			Результат.Пояснение = НСтр("ru = 'Пользователей можно посмотреть только у ролей текущего сеанса.'");
		Иначе
			РолиСПравами.Вставить(КлючУзла, Истина);
		КонецЕсли;
		Возврат РолиСПравами;
	КонецЕсли;

	// Права ролей общие для сеанса: описания прав переносятся в результат, а сами не изменяются.
	ПраваРолей = ПраваРолейНаОбъект(НайденныйОбъект, КлючУзла);
	ТипБулево = Новый ОписаниеТипов("Булево");
	Для Каждого ОписаниеПрава Из ПраваРолей.Права Цикл
		Результат.Права.Добавить(ОписаниеПрава);
		Результат.Пользователи.Колонки.Добавить(ОписаниеПрава.Имя, ТипБулево, ОписаниеПрава.Представление);
	КонецЦикла;
	// Роль поля, ограниченная на этом поле, прав на него не дает.
	Для Каждого СтрокаРоли Из ПраваРолей.Роли Цикл
		Для Каждого ОписаниеПрава Из ПраваРолей.Права Цикл
			Если СтрокаРоли[ОписаниеПрава.Имя] Тогда
				РолиСПравами.Вставить(СтрокаРоли.Роль, СтрокаРоли);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если РолиСПравами.Количество() = 0 Тогда
		Результат.Пояснение = ПраваРолей.Пояснение;
		Если ПустаяСтрока(Результат.Пояснение) Тогда
			Результат.Пояснение = НСтр("ru = 'Ни одна роль не дает прав на этот объект.'");
		КонецЕсли;
	КонецЕсли;
	Возврат РолиСПравами;

КонецФункции

// Добавляет пользователя в таблицу пользователей с правами, если права ему дает хотя бы одна из его ролей.
//
// Параметры:
//  ТаблицаПользователей - ТаблицаЗначений - пользователи с правами, см. ПраваПользователейНаОбъект
//  ПользовательИБ - ПользовательИнформационнойБазы - пользователь
//  РолиСПравами - см. РолиСПравамиНаУзел
//  Права - Массив из Структура - права узла, см. ПраваПользователейНаОбъект
Процедура ДобавитьПраваПользователя(ТаблицаПользователей, ПользовательИБ, РолиСПравами, Права)

	СтрокаПользователя = Неопределено;
	ИменаРолей = Новый Массив;
	Для Каждого Роль Из ПользовательИБ.Роли Цикл
		ПраваРоли = РолиСПравами[Роль.ПолноеИмя()];
		Если ПраваРоли = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПользователя = Неопределено Тогда
			СтрокаПользователя = ТаблицаПользователей.Добавить();
			СтрокаПользователя.Имя = ПользовательИБ.Имя;
			СтрокаПользователя.ПолноеИмя = ПользовательИБ.ПолноеИмя;
			СтрокаПользователя.Идентификатор = Строка(ПользовательИБ.УникальныйИдентификатор);
		КонецЕсли;
		ИменаРолей.Добавить(Роль.Имя);
		Для Каждого ОписаниеПрава Из Права Цикл
			Если ПраваРоли[ОписаниеПрава.Имя] Тогда
				СтрокаПользователя[ОписаниеПрава.Имя] = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если СтрокаПользователя <> Неопределено Тогда
		СтрокаПользователя.Роли = СтрСоединить(ИменаРолей, ", ");
	КонецЕсли;

КонецПроцедуры

// Возвращает объект метаданных текущего сеанса, у которого можно проверить права ролей.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  ОбъектМетаданных, ОбъектМетаданныхКонфигурация, Неопределено - объект метаданных сеанса или Неопределено,
//    если объект не из метаданных сеанса
Функция ОбъектМетаданныхСеанса(НайденныйОбъект, КлючУзла)

	ОбъектМетаданных = Неопределено;
	Если НайденныйОбъект.КлючКэша = "" Тогда
		ОбъектМетаданных = НайтиВКонфигурации(Метаданные, КлючУзла);
	ИначеЕсли НайденныйОбъект.КлючКэша <> Неопределено И ВидПоПолномуИмени(КлючУзла) <> "Конфигурация" Тогда
		// Объекты активного расширения входят в метаданные сеанса, а прав на само расширение роли не задают.
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(КлючУзла);
	КонецЕсли;
	Возврат ОбъектМетаданных;

КонецФункции

// Возвращает описание объекта, права на который проверяются функцией ПравоДоступа. Стандартные реквизиты
// и стандартные табличные части - не объекты метаданных: права на них проверяются у владельца по имени.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если объект не из метаданных текущего сеанса:
//   * ОбъектМетаданных - ОбъектМетаданных, ОбъектМетаданныхКонфигурация - объект метаданных сеанса
//   * ИмяСтандартного - Строка - имя стандартного реквизита или стандартной табличной части для функции
//       ПравоДоступа, например ВидыСубконто.ВидСубконто; пустая строка для объектов метаданных
Функция ОбъектПроверкиПрав(НайденныйОбъект, КлючУзла)

	// Части ключа: вид и имя объекта верхнего уровня, затем пары вида и имени подчиненных объектов.
	ЧастиИмени = СтрРазделить(КлючУзла, ".");
	КлючВладельца = КлючУзла;
	ИменаСтандартных = Новый Массив;
	Для Индекс = 2 По ЧастиИмени.ВГраница() - 1 Цикл
		Если Индекс % 2 = 1 Тогда
			Продолжить;
		КонецЕсли;
		ВидЧасти = ЧастиИмени[Индекс];
		Если ИменаСтандартных.Количество() > 0 Тогда
			ИменаСтандартных.Добавить(ЧастиИмени[Индекс + 1]);
		ИначеЕсли ВидЧасти = "СтандартныйРеквизит" Или ВидЧасти = "СтандартнаяТабличнаяЧасть" Тогда
			ЧастиВладельца = Новый Массив;
			Для ИндексВладельца = 0 По Индекс - 1 Цикл
				ЧастиВладельца.Добавить(ЧастиИмени[ИндексВладельца]);
			КонецЦикла;
			КлючВладельца = СтрСоединить(ЧастиВладельца, ".");
			ИменаСтандартных.Добавить(ЧастиИмени[Индекс + 1]);
		КонецЕсли;
	КонецЦикла;

	Результат = Неопределено;
	ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, КлючВладельца);
	Если ОбъектМетаданных <> Неопределено Тогда
		Результат = Новый Структура("ОбъектМетаданных, ИмяСтандартного", ОбъектМетаданных,
			СтрСоединить(ИменаСтандартных, "."));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет право роли на объект проверки прав.
//
// Параметры:
//  ИмяПрава - Строка - имя права
//  ОбъектПроверки - см. ОбъектПроверкиПрав
//  Роль - ОбъектМетаданныхРоль - роль
//
// Возвращаемое значение:
//  Булево - Истина, если роль дает право
Функция ПравоДоступаКОбъектуПроверки(ИмяПрава, ОбъектПроверки, Роль)

	Если ПустаяСтрока(ОбъектПроверки.ИмяСтандартного) Тогда
		Результат = ПравоДоступа(ИмяПрава, ОбъектПроверки.ОбъектМетаданных, Роль);
	Иначе
		Результат = ПравоДоступа(ИмяПрава, ОбъектПроверки.ОбъектМетаданных, Роль, ОбъектПроверки.ИмяСтандартного);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает права вида объекта, которые можно проверить у объекта. Набор прав зависит от версии платформы:
// проверка права, которого в ней нет, вызывает исключение, и такое право пропускается. Так же пропускаются
// права подчиненных объектов, у которых платформа права не проверяет, например у стандартных реквизитов
// табличных частей.
//
// Параметры:
//  ОбъектПроверки - см. ОбъектПроверкиПрав
//  Вид - Строка - вид объекта метаданных
//
// Возвращаемое значение:
//  Массив из Строка - имена прав в порядке вывода
Функция ПрименимыеПрава(ОбъектПроверки, Вид)

	Результат = Новый Массив;
	ИменаПрав = ПраваВидовОбъектов()[Вид];
	Если ИменаПрав = Неопределено Или Метаданные.Роли.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПерваяРоль = Метаданные.Роли[0];
	Для Каждого ИмяПрава Из ИменаПрав Цикл
		ПравоПрименимо = Истина;
		Попытка
			ПравоДоступаКОбъектуПроверки(ИмяПрава, ОбъектПроверки, ПерваяРоль);
		Исключение
			// Такого права нет в этой версии платформы или у этого объекта.
			ПравоПрименимо = Ложь;
		КонецПопытки;
		Если ПравоПрименимо Тогда
			Результат.Добавить(ИмяПрава);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заполняет права ролей на объект, у которого свои права: объект верхнего уровня, команду, операцию и т.п.
//
// Параметры:
//  Роли - см. ПраваРолейНаОбъект
//  ИменаПрав - Массив из Строка - права объекта
//  ОбъектПроверки - см. ОбъектПроверкиПрав
Процедура ЗаполнитьПраваРолейНаОбъект(Роли, ИменаПрав, ОбъектПроверки)

	// Роль без корневого права не дает и зависящих от него прав, поэтому остальные права у нее не проверяются.
	КорневоеПраво = КорневоеПраво(ИменаПрав);
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если КорневоеПраво <> Неопределено И Не ПравоДоступаКОбъектуПроверки(КорневоеПраво, ОбъектПроверки, Роль) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРоли = Неопределено;
		Для Каждого ИмяПрава Из ИменаПрав Цикл
			Если Не ПравоДоступаКОбъектуПроверки(ИмяПрава, ОбъектПроверки, Роль) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаРоли = Неопределено Тогда
				СтрокаРоли = Роли.Добавить();
				СтрокаРоли.Роль = Роль.ПолноеИмя();
			КонецЕсли;
			СтрокаРоли[ИмяПрава] = Истина;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Заполняет права ролей на поле объекта: реквизит, табличную часть, измерение и т.п. Право на поле действует
// вместе с таким же правом на объект и на табличную часть, в которую входит поле: роль дает его, только если
// дает их все. У отчетов и обработок нет права Редактирование, его заменяет право Использование.
// Выводятся роли, которые дают права на поле или ограничивают на поле права, которые дают на объект.
//
// Параметры:
//  Роли - см. ПраваРолейНаОбъект
//  ИменаПрав - Массив из Строка - права поля
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - полное имя поля
Процедура ЗаполнитьПраваРолейНаПоле(Роли, ИменаПрав, НайденныйОбъект, КлючУзла)

	ЧастиИмени = СтрРазделить(КлючУзла, ".");
	КлючОбъекта = СтрШаблон("%1.%2", ЧастиИмени[0], ЧастиИмени[1]);
	ОбъектПроверки = ОбъектПроверкиПрав(НайденныйОбъект, КлючОбъекта);
	Если ОбъектПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПраваОбъекта = ПрименимыеПрава(ОбъектПроверки, ВидПоПолномуИмени(КлючОбъекта));
	КорневоеПраво = КорневоеПраво(ПраваОбъекта);
	ПраваОбъектаДляПоля = Новый Соответствие;
	Для Каждого ИмяПрава Из ИменаПрав Цикл
		Если ПраваОбъекта.Найти(ИмяПрава) <> Неопределено Тогда
			ПраваОбъектаДляПоля.Вставить(ИмяПрава, ИмяПрава);
		Иначе
			ПраваОбъектаДляПоля.Вставить(ИмяПрава, КорневоеПраво);
		КонецЕсли;
	КонецЦикла;

	// Поле и табличные части, в которые оно входит, от верхнего уровня к полю.
	ОбъектыПроверкиПоля = Новый Массив;
	КлючЧасти = КлючОбъекта;
	Для Индекс = 2 По ЧастиИмени.ВГраница() - 1 Цикл
		Если Индекс % 2 = 1 Тогда
			Продолжить;
		КонецЕсли;
		КлючЧасти = СтрШаблон("%1.%2.%3", КлючЧасти, ЧастиИмени[Индекс], ЧастиИмени[Индекс + 1]);
		Если ЭтоВидПоляСПравами(ЧастиИмени[Индекс]) Тогда
			ОбъектПроверкиЧасти = ОбъектПроверкиПрав(НайденныйОбъект, КлючЧасти);
			Если ОбъектПроверкиЧасти <> Неопределено Тогда
				ОбъектыПроверкиПоля.Добавить(ОбъектПроверкиЧасти);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Роль Из Метаданные.Роли Цикл
		Если КорневоеПраво <> Неопределено И Не ПравоДоступаКОбъектуПроверки(КорневоеПраво, ОбъектПроверки, Роль) Тогда
			Продолжить;
		КонецЕсли;

		ПраваРоли = Новый Структура;
		ЕстьПрава = Ложь;
		Ограничено = Ложь;
		Для Каждого ИмяПрава Из ИменаПрав Цикл
			ПравоОбъекта = ПраваОбъектаДляПоля[ИмяПрава];
			ПравоНаОбъект = (ПравоОбъекта = Неопределено
				Или ПравоДоступаКОбъектуПроверки(ПравоОбъекта, ОбъектПроверки, Роль));
			ПравоНаПоле = ПравоНаОбъект И ПравоДоступаКПолю(ИмяПрава, ОбъектыПроверкиПоля, Роль);
			ПраваРоли.Вставить(ИмяПрава, ПравоНаПоле);
			ЕстьПрава = ЕстьПрава Или ПравоНаПоле;
			Ограничено = Ограничено Или (ПравоНаОбъект И Не ПравоНаПоле);
		КонецЦикла;
		Если Не ЕстьПрава И Не Ограничено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРоли = Роли.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРоли, ПраваРоли);
		СтрокаРоли.Роль = Роль.ПолноеИмя();
		СтрокаРоли.Ограничено = Ограничено;
	КонецЦикла;

КонецПроцедуры

// Проверяет право роли на поле и на все табличные части, в которые оно входит.
//
// Параметры:
//  ИмяПрава - Строка - имя права
//  ОбъектыПроверкиПоля - Массив из см. ОбъектПроверкиПрав - поле и табличные части, в которые оно входит
//  Роль - ОбъектМетаданныхРоль - роль
//
// Возвращаемое значение:
//  Булево - Истина, если роль дает право на поле и на все табличные части
Функция ПравоДоступаКПолю(ИмяПрава, ОбъектыПроверкиПоля, Роль)

	Результат = Истина;
	Для Каждого ОбъектПроверки Из ОбъектыПроверкиПоля Цикл
		Если Не ПравоДоступаКОбъектуПроверки(ИмяПрава, ОбъектПроверки, Роль) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заполняет в таблице прав ролей признак ограничения доступа к данным условием. Признак проверяется функцией
// ПараметрыДоступа по правам Чтение, Добавление, Изменение и Удаление на объект, которому принадлежит узел:
// для поля верхнего уровня - на само поле, для объекта и полей табличных частей - на ключевое поле таблицы,
// см. КлючевоеПолеОграниченияУсловием. Роль ограничивает доступ, если хотя бы одно из этих прав она дает
// с ограничением условием.
//
// Параметры:
//  Роли - см. ПраваРолейНаОбъект
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - полное имя объекта или поля
//  ЭтоПоле - Булево - Истина, если узел - поле объекта
//
// Возвращаемое значение:
//  Булево - Истина, если объекту можно задать ограничение условием и признак заполнен
Функция ЗаполнитьОграниченияУсловием(Роли, НайденныйОбъект, КлючУзла, ЭтоПоле)

	Результат = Ложь;
	ЧастиИмени = СтрРазделить(КлючУзла, ".");
	ВидОбъекта = ЧастиИмени[0];
	ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, СтрШаблон("%1.%2", ВидОбъекта, ЧастиИмени[1]));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	КлючевоеПоле = КлючевоеПолеОграниченияУсловием(ОбъектМетаданных, ВидОбъекта);
	Если ПустаяСтрока(КлючевоеПоле) Тогда
		Возврат Результат;
	КонецЕсли;

	ПраваОбъекта = ПраваВидовОбъектов()[ВидОбъекта];
	ПраваСОграничением = Новый Массив;
	Для Каждого ИмяПрава Из СписокИмен("Чтение, Добавление, Изменение, Удаление") Цикл
		Если ПраваОбъекта.Найти(ИмяПрава) <> Неопределено Тогда
			ПраваСОграничением.Добавить(ИмяПрава);
		КонецЕсли;
	КонецЦикла;

	// Ограничение можно задать отдельному полю таблицы, поля табличных частей проверяются по ключевому полю.
	ПолеПроверки = КлючевоеПоле;
	Если ЭтоПоле И ЧастиИмени.Количество() = 4 Тогда
		ПолеПроверки = ЧастиИмени[3];
	КонецЕсли;

	Для Каждого СтрокаРоли Из Роли Цикл
		Роль = Метаданные.НайтиПоПолномуИмени(СтрокаРоли.Роль);
		Для Каждого ИмяПрава Из ПраваСОграничением Цикл
			Если ОграничениеУсловием(ИмяПрава, ОбъектМетаданных, ПолеПроверки, КлючевоеПоле, Роль) Тогда
				СтрокаРоли.ОграничениеУсловием = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Истина;
	Возврат Результат;

КонецФункции

// Возвращает поле таблицы объекта, по которому функция ПараметрыДоступа проверяет общее ограничение доступа
// условием: ссылку, регистратор или первое измерение регистра сведений.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект верхнего уровня
//  Вид - Строка - вид объекта метаданных
//
// Возвращаемое значение:
//  Строка - имя поля; пустая строка, если объекту нельзя задать ограничение условием
Функция КлючевоеПолеОграниченияУсловием(ОбъектМетаданных, Вид)

	Результат = "";
	ВидыСоСсылкой = СписокИмен("Справочник, Документ, ЖурналДокументов, ПланВидовХарактеристик, ПланСчетов,
		|ПланВидовРасчета, ПланОбмена, БизнесПроцесс, Задача");
	Если ВидыСоСсылкой.Найти(Вид) <> Неопределено Тогда
		Результат = "Ссылка";
	ИначеЕсли Вид = "РегистрНакопления" Или Вид = "РегистрБухгалтерии" Или Вид = "РегистрРасчета" Тогда
		Результат = "Регистратор";
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Если ОбъектМетаданных.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
			Результат = "Регистратор";
		ИначеЕсли ОбъектМетаданных.Измерения.Количество() > 0 Тогда
			Результат = ОбъектМетаданных.Измерения[0].Имя;
		ИначеЕсли ОбъектМетаданных.Ресурсы.Количество() > 0 Тогда
			Результат = ОбъектМетаданных.Ресурсы[0].Имя;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет, что роль дает право на поле объекта с ограничением доступа условием.
//
// Параметры:
//  ИмяПрава - Строка - имя права
//  ОбъектМетаданных - ОбъектМетаданных - объект верхнего уровня
//  ПолеПроверки - Строка - имя поля, для которого проверяется ограничение
//  КлючевоеПоле - Строка - поле, которое проверяется, если ПолеПроверки функция ПараметрыДоступа не принимает
//  Роль - ОбъектМетаданныхРоль - роль
//
// Возвращаемое значение:
//  Булево - Истина, если роль дает право и доступ ограничен условием
Функция ОграничениеУсловием(ИмяПрава, ОбъектМетаданных, ПолеПроверки, КлючевоеПоле, Роль)

	Попытка
		ПараметрыДоступаРоли = ПараметрыДоступа(ИмяПрава, ОбъектМетаданных, ПолеПроверки, Роль);
	Исключение
		// Не каждое поле объекта можно передать в ПараметрыДоступа, например табличную часть.
		ПараметрыДоступаРоли = ПараметрыДоступа(ИмяПрава, ОбъектМетаданных, КлючевоеПоле, Роль);
	КонецПопытки;
	Результат = ПараметрыДоступаРоли.Доступность И ПараметрыДоступаРоли.ОграничениеУсловием;
	Возврат Результат;

КонецФункции

// Возвращает пустое дерево расширений объекта.
//
// Возвращаемое значение:
//  ДеревоЗначений - расширения и подчиненные объекты, которые они заимствуют или добавляют:
//   * Имя - Строка - имя расширения или объекта
//   * Представление - Строка - представление строки
//   * Вид - Строка - вид объекта, см. ВидОбъектаМетаданных; "Расширение" у строк расширений,
//       имя коллекции у строк коллекций
//   * ПолноеИмя - Строка - полное имя объекта метаданных; пусто у строк расширений и коллекций
//   * Принадлежность - Строка - "Добавлен" или "Заимствован"
//   * ЭтоГруппа - Булево - строка расширения или коллекции
Функция НовоеДеревоРасширенийОбъекта()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Имя", ТипСтрока);
	Дерево.Колонки.Добавить("Представление", ТипСтрока);
	Дерево.Колонки.Добавить("Вид", ТипСтрока);
	Дерево.Колонки.Добавить("ПолноеИмя", ТипСтрока);
	Дерево.Колонки.Добавить("Принадлежность", ТипСтрока);
	Дерево.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Возврат Дерево;

КонецФункции

// Добавляет в дерево расширений подчиненные объекты, которые расширение заимствует или добавляет в объект,
// по коллекциям. В метаданных расширения есть только такие подчиненные объекты.
//
// Параметры:
//  СтрокиРодителя - КоллекцияСтрокДереваЗначений - строки дерева расширений
//  ОбъектРасширения - ОбъектМетаданных - объект из метаданных расширения
//  КоллекцииСостава - Массив из см. КоллекцииСостава - коллекции подчиненных объектов метаданных
Процедура ДобавитьИзмененияРасширения(СтрокиРодителя, ОбъектРасширения, КоллекцииСостава)

	// Коллекции, которых нет у объекта, остаются маркером.
	Маркер = Новый УникальныйИдентификатор;
	Коллекции = Новый Структура;
	Для Каждого ОписаниеКоллекции Из КоллекцииСостава Цикл
		Коллекции.Вставить(ОписаниеКоллекции.Имя, Маркер);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Коллекции, ОбъектРасширения);

	Для Каждого ОписаниеКоллекции Из КоллекцииСостава Цикл
		Коллекция = Коллекции[ОписаниеКоллекции.Имя];
		Если Коллекция = Маркер Тогда
			Продолжить;
		КонецЕсли;

		УзелКоллекции = СтрокиРодителя.Добавить();
		УзелКоллекции.Имя = ОписаниеКоллекции.Имя;
		УзелКоллекции.Вид = ОписаниеКоллекции.Имя;
		УзелКоллекции.ЭтоГруппа = Истина;
		Для Каждого Элемент Из Коллекция Цикл
			СтрокаЭлемента = УзелКоллекции.Строки.Добавить();
			СтрокаЭлемента.Имя = Элемент.Имя;
			СтрокаЭлемента.Представление = Элемент.Имя;
			СтрокаЭлемента.Вид = ВидОбъектаМетаданных(Элемент);
			СтрокаЭлемента.ПолноеИмя = Элемент.ПолноеИмя();
			СтрокаЭлемента.Принадлежность = ПредставлениеПринадлежности(Элемент);
			ДобавитьИзмененияРасширения(СтрокаЭлемента.Строки, Элемент, КоллекцииСостава);
		КонецЦикла;

		КоличествоЭлементов = УзелКоллекции.Строки.Количество();
		Если КоличествоЭлементов = 0 Тогда
			СтрокиРодителя.Удалить(УзелКоллекции);
		Иначе
			УзелКоллекции.Представление = СтрШаблон("%1 (%2)", ОписаниеКоллекции.Представление, КоличествоЭлементов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет заимствованные объекты коллекций владельца и их заимствованные подчиненные объекты.
// У собственного объекта расширения все подчиненные объекты тоже собственные, поэтому они не обходятся.
//
// Параметры:
//  ЗаимствованныеОбъекты - Соответствие из КлючИЗначение - найденные объекты:
//   * Ключ - Строка - полное имя заимствованного объекта метаданных
//   * Значение - Соответствие из КлючИЗначение - расширения, которые заимствуют объект:
//     ** Ключ - Строка - имя расширения
//     ** Значение - Булево - см. ЕстьПодчиненныеОбъектыРасширения
//  ИмяРасширения - Строка - имя расширения, метаданные которого обходятся
//  Владелец - ОбъектМетаданныхКонфигурация, ОбъектМетаданных - метаданные расширения или их объект
//  ИменаКоллекций - Массив из Строка - коллекции владельца, которые нужно обойти
//  КоллекцииОбъекта - Массив из Строка - коллекции подчиненных объектов, см. КоллекцииСостава
Процедура ДобавитьЗаимствованныеОбъекты(ЗаимствованныеОбъекты, ИмяРасширения, Владелец, ИменаКоллекций,
	КоллекцииОбъекта)

	// Коллекции, которых нет у владельца, остаются маркером.
	Маркер = Новый УникальныйИдентификатор;
	Коллекции = Новый Структура;
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Коллекции.Вставить(ИмяКоллекции, Маркер);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Коллекции, Владелец);

	Заимствованный = Метаданные.СвойстваОбъектов.ПринадлежностьОбъекта.Заимствованный;
	Для Каждого Коллекция Из Коллекции Цикл
		Если Коллекция.Значение = Маркер Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Коллекция.Значение Цикл
			Если Элемент.ПринадлежностьОбъекта = Заимствованный Тогда
				ПолноеИмя = Элемент.ПолноеИмя();
				РасширенияОбъекта = ЗаимствованныеОбъекты[ПолноеИмя];
				Если РасширенияОбъекта = Неопределено Тогда
					РасширенияОбъекта = Новый Соответствие;
					ЗаимствованныеОбъекты.Вставить(ПолноеИмя, РасширенияОбъекта);
				КонецЕсли;
				РасширенияОбъекта.Вставить(ИмяРасширения, ЕстьПодчиненныеОбъектыРасширения(Элемент, КоллекцииОбъекта));
				ДобавитьЗаимствованныеОбъекты(ЗаимствованныеОбъекты, ИмяРасширения, Элемент, КоллекцииОбъекта,
					КоллекцииОбъекта);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Определяет, есть ли в заимствованном объекте расширения подчиненные объекты или состав. В метаданных расширения
// они есть, только если расширение их добавляет, заимствует или включает в состав: по ним видно, что расширение
// меняет объект, см. ОбъектИзмененРасширением.
//
// Параметры:
//  ОбъектРасширения - ОбъектМетаданных - заимствованный объект из метаданных расширения
//  КоллекцииОбъекта - Массив из Строка - коллекции подчиненных объектов, см. КоллекцииСостава
//
// Возвращаемое значение:
//  Булево - Истина, если подчиненные объекты или состав есть
Функция ЕстьПодчиненныеОбъектыРасширения(ОбъектРасширения, КоллекцииОбъекта)

	// Коллекции, которых нет у объекта, остаются маркером. Состав есть у подсистем, планов обмена и т.п.
	Маркер = Новый УникальныйИдентификатор;
	Коллекции = Новый Структура("Состав", Маркер);
	Для Каждого ИмяКоллекции Из КоллекцииОбъекта Цикл
		Коллекции.Вставить(ИмяКоллекции, Маркер);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Коллекции, ОбъектРасширения);

	ЕстьОбъекты = Ложь;
	Для Каждого Коллекция Из Коллекции Цикл
		Если Коллекция.Значение <> Маркер И Коллекция.Значение.Количество() > 0 Тогда
			ЕстьОбъекты = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьОбъекты;

КонецФункции

// Определяет, меняет ли объект конфигурации расширение, которое его заимствует. Платформа сообщает только,
// что объект изменен расширениями, но не какими. Если объект заимствует одно расширение, изменения - его.
// Если несколько, изменения относятся к тем, у которых в объекте есть подчиненные объекты или состав.
// Изменения модулей по метаданным не видны, поэтому если подчиненных объектов нет ни у одного расширения,
// изменившими считаются все.
//
// Параметры:
//  РасширенияОбъекта - ФиксированноеСоответствие из КлючИЗначение - расширения, которые заимствуют объект,
//                      см. ЗаимствованныеОбъектыРасширенийСеанса
//  ИмяРасширения - Строка - имя расширения, которое заимствует объект
//
// Возвращаемое значение:
//  Булево - Истина, если изменения объекта относятся к расширению
Функция ОбъектИзмененРасширением(РасширенияОбъекта, ИмяРасширения)

	Изменен = Истина;
	Если РасширенияОбъекта.Получить(ИмяРасширения) <> Истина Тогда
		Для Каждого ОписаниеРасширения Из РасширенияОбъекта Цикл
			Если ОписаниеРасширения.Значение = Истина Тогда
				// Подчиненные объекты есть у другого расширения: изменения - его.
				Изменен = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Изменен;

КонецФункции

// Возвращает представление принадлежности объекта метаданных расширения.
//
// Параметры:
//  ОбъектРасширения - ОбъектМетаданных - объект из метаданных расширения
//
// Возвращаемое значение:
//  Строка - "Добавлен", если объект собственный в расширении, иначе "Заимствован"
Функция ПредставлениеПринадлежности(ОбъектРасширения)

	Если ОбъектРасширения.ПринадлежностьОбъекта = Метаданные.СвойстваОбъектов.ПринадлежностьОбъекта.Собственный Тогда
		Представление = НСтр("ru = 'Добавлен'");
	Иначе
		Представление = НСтр("ru = 'Заимствован'");
	КонецЕсли;
	Возврат Представление;

КонецФункции

// Возвращает представление расширения: синоним или имя и версию.
//
// Параметры:
//  ОписаниеРасширения - см. ОписанияРасширенийСеанса
//
// Возвращаемое значение:
//  Строка - представление расширения
Функция ПредставлениеРасширения(ОписаниеРасширения)

	Представление = ?(ПустаяСтрока(ОписаниеРасширения.Синоним), ОписаниеРасширения.Имя, ОписаниеРасширения.Синоним);
	Если Не ПустаяСтрока(ОписаниеРасширения.Версия) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1, версия %2'"), Представление, ОписаниеРасширения.Версия);
	КонецЕсли;
	Возврат Представление;

КонецФункции

