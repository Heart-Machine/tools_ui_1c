#Область ПрограммныйИнтерфейс

// Находит объект метаданных среди конфигураций, отмеченных в дереве отбора конфигураций навигатора.
// Конфигурации перебираются так же, как при построении дерева навигатора: если отмечена конфигурация целиком,
// поиск идет в ней, иначе - в каждом отмеченном расширении. Если объект не найден, он ищется в текущей конфигурации.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//  ДеревоОтбораКонфигураций - ДеревоЗначений, Неопределено - дерево отбора конфигураций навигатора
//                             с колонками Имя, Пометка, АдресМетаданных, ЭтоТекущаяБазаДанных
//
// Возвращаемое значение:
//  Структура:
//   * ОбъектМетаданных - ОбъектМетаданных, Неопределено - найденный объект
//   * МетаданныеКонфигурации - ОбъектМетаданныхКонфигурация - конфигурация, в которой найден объект
//   * КлючКэша - Строка, Неопределено - ключ конфигурации для кэша обратных связей:
//                пустая строка - текущая конфигурация, имя - активное расширение текущего сеанса,
//                Неопределено - конфигурация не из текущей базы, ее связи не кэшируются
Функция НайтиОбъектМетаданных(ПолноеИмя, ДеревоОтбораКонфигураций = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ОбъектМетаданных", Неопределено);
	Результат.Вставить("МетаданныеКонфигурации", Метаданные);
	Результат.Вставить("КлючКэша", "");

	Для Каждого ОписаниеКонфигурации Из КонфигурацииОтбора(ДеревоОтбораКонфигураций) Цикл
		ОбъектМетаданных = НайтиВКонфигурации(ОписаниеКонфигурации.МетаданныеКонфигурации, ПолноеИмя);
		Если ОбъектМетаданных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат, ОписаниеКонфигурации);
			Результат.ОбъектМетаданных = ОбъектМетаданных;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Результат.ОбъектМетаданных = Неопределено Тогда
		Результат.ОбъектМетаданных = НайтиВКонфигурации(Метаданные, ПолноеИмя);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает вид объекта метаданных так, как он записывается в полном имени:
// "Справочник", "Реквизит", "ТабличнаяЧасть", "Измерение" и т. д.
// Для описаний стандартных реквизитов и стандартных табличных частей возвращает
// "СтандартныйРеквизит" и "СтандартнаяТабличнаяЧасть".
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных, ОписаниеСтандартногоРеквизита, ОписаниеСтандартнойТабличнойЧасти - объект
//
// Возвращаемое значение:
//  Строка - вид объекта метаданных
Функция ВидОбъектаМетаданных(ОбъектМетаданных) Экспорт

	ТипОбъекта = ТипЗнч(ОбъектМетаданных);
	Если ТипОбъекта = Тип("ОписаниеСтандартногоРеквизита") Тогда
		Вид = "СтандартныйРеквизит";
	ИначеЕсли ТипОбъекта = Тип("ОписаниеСтандартнойТабличнойЧасти") Тогда
		Вид = "СтандартнаяТабличнаяЧасть";
	Иначе
		Вид = ВидПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
	КонецЕсли;
	Возврат Вид;

КонецФункции

// Возвращает обратные связи узлов состава: какие объекты метаданных ссылаются на узлы и через какие свойства.
// Связи берутся из индекса обратных связей конфигурации; индекс текущей конфигурации и активных расширений
// кэшируется на время сеанса.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючиУзлов - Массив из Строка - ключи узлов состава (полные имена объектов метаданных)
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * КлючУзла - Строка - ключ узла, на который ссылаются
//   * ИмяГруппы - Строка - имя группы связей
//   * Группа - Строка - представление группы связей
//   * Порядок - Число - порядок группы
//   * Объект - Строка - полное имя объекта метаданных, который ссылается на узел
//   * Вид - Строка - вид этого объекта, см. ВидОбъектаМетаданных
//   * Свойство - Строка - имя свойства, через которое он ссылается
Функция ОбратныеСвязиУзлов(НайденныйОбъект, КлючиУзлов) Экспорт

	Если НайденныйОбъект.КлючКэша = Неопределено Тогда
		Индекс = ИндексОбратныхСвязей(НайденныйОбъект.МетаданныеКонфигурации);
	Иначе
		Индекс = УИ_НавигаторПоМетаданнымПовтИсп.ИндексОбратныхСвязей(НайденныйОбъект.КлючКэша);
	КонецЕсли;

	ГруппыСвязей = ГруппыОбратныхСвязей();
	Результат = НоваяТаблицаОбратныхСвязей();
	Для Каждого КлючУзла Из КлючиУзлов Цикл
		СвязиУзла = Индекс.Получить(КлючУзла);
		Если СвязиУзла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Связь Из СвязиУзла Цикл
			Группа = ГруппаОбратнойСвязи(ГруппыСвязей, Связь.Вид, Связь.Свойство);
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Связь);
			НоваяСтрока.КлючУзла = КлючУзла;
			НоваяСтрока.ИмяГруппы = Группа.Имя;
			НоваяСтрока.Группа = Группа.Представление;
			НоваяСтрока.Порядок = Группа.Порядок;
		КонецЦикла;
	КонецЦикла;
	Результат.Сортировать("КлючУзла, Порядок, ИмяГруппы, Объект, Свойство");
	Возврат Результат;

КонецФункции

// Возвращает роли текущего сеанса, которые дают права на узел состава, в том же виде, что и обратные связи:
// в колонке Свойство - права роли. Для полей объектов роли не возвращаются: роли с доступом к объекту
// по умолчанию дают права и на его поля, и список повторял бы роли объекта.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  см. ОбратныеСвязиУзлов
Функция ПраваРолейУзла(НайденныйОбъект, КлючУзла) Экспорт

	Результат = НоваяТаблицаОбратныхСвязей();
	Если ЭтоВидПоляСПравами(ВидПоПолномуИмени(КлючУзла)) Тогда
		Возврат Результат;
	КонецЕсли;

	ПраваРолей = ПраваРолейНаОбъект(НайденныйОбъект, КлючУзла);
	ИменаПрав = Новый Массив;
	Для Каждого ОписаниеПрава Из ПраваРолей.Права Цикл
		ИменаПрав.Добавить(ОписаниеПрава.Имя);
	КонецЦикла;

	Группа = ГруппыОбратныхСвязей()["Роль.Права"];
	Для Каждого СтрокаРоли Из ПраваРолей.Роли Цикл
		ПраваРоли = Новый Массив;
		Для Каждого ИмяПрава Из ИменаПрав Цикл
			Если СтрокаРоли[ИмяПрава] Тогда
				ПраваРоли.Добавить(ИмяПрава);
			КонецЕсли;
		КонецЦикла;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.КлючУзла = КлючУзла;
		НоваяСтрока.ИмяГруппы = Группа.Имя;
		НоваяСтрока.Группа = Группа.Представление;
		НоваяСтрока.Порядок = Группа.Порядок;
		НоваяСтрока.Объект = СтрокаРоли.Роль;
		НоваяСтрока.Вид = "Роль";
		НоваяСтрока.Свойство = ПредставлениеПравРоли(ПраваРоли, ИменаПрав);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает права ролей текущего сеанса на узел состава: какие права объекта дает каждая роль.
// Права кэшируются на время сеанса в УИ_НавигаторПоМетаданнымПовтИсп.ПраваРолейНаОбъект, потому что проверка
// всех ролей занимает время, а права одного узла нужны и вкладке "Роли", и вкладке "Используется в" формы свойств.
// Результат общий для всех вызовов в сеансе, изменять его нельзя.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Структура - см. ПраваРолейНаОбъектСеанса
Функция ПраваРолейНаОбъект(НайденныйОбъект, КлючУзла) Экспорт

	ПраваРолей = УИ_НавигаторПоМетаданнымПовтИсп.ПраваРолейНаОбъект(НайденныйОбъект.КлючКэша, КлючУзла);
	Возврат ПраваРолей;

КонецФункции

// Возвращает пользователей информационной базы, которым роли дают права на узел состава: право есть
// у пользователя, если его дает хотя бы одна из ролей пользователя. Для роли возвращаются пользователи,
// которым она назначена. Права ролей берутся из кэша сеанса, см. ПраваРолейНаОбъект, а пользователи читаются
// при каждом вызове: их роли могут измениться во время сеанса.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Структура:
//   * Права - Массив из Структура - права объекта в порядке вывода, см. ПраваРолейНаОбъектСеанса;
//       у роли - пустой массив
//   * Пользователи - ТаблицаЗначений - пользователи по возрастанию имени. Кроме колонок ниже в таблице есть
//     колонка типа Булево на каждое право из Права: имя колонки - имя права, заголовок - представление права:
//     ** Имя - Строка - имя пользователя
//     ** ПолноеИмя - Строка - полное имя пользователя
//     ** Идентификатор - Строка - уникальный идентификатор пользователя
//     ** Роли - Строка - имена ролей пользователя, которые дают права, через запятую
//   * Пояснение - Строка - почему пользователей нет
Функция ПраваПользователейНаОбъект(НайденныйОбъект, КлючУзла) Экспорт

	Права = Новый Массив;
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТаблицаПользователей = Новый ТаблицаЗначений;
	ТаблицаПользователей.Колонки.Добавить("Имя", ТипСтрока);
	ТаблицаПользователей.Колонки.Добавить("ПолноеИмя", ТипСтрока);
	ТаблицаПользователей.Колонки.Добавить("Идентификатор", ТипСтрока);
	ТаблицаПользователей.Колонки.Добавить("Роли", ТипСтрока);
	Результат = Новый Структура("Права, Пользователи, Пояснение", Права, ТаблицаПользователей, "");

	РолиСПравами = РолиСПравамиНаУзел(НайденныйОбъект, КлючУзла, Результат);
	Если РолиСПравами.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Результат.Пояснение = НСтр("ru = 'Список пользователей информационной базы доступен только администратору.'");
		Возврат Результат;
	КонецЕсли;

	ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Для Каждого ПользовательИБ Из ПользователиИБ Цикл
		ДобавитьПраваПользователя(ТаблицаПользователей, ПользовательИБ, РолиСПравами, Права);
	КонецЦикла;
	ТаблицаПользователей.Сортировать("Имя");

	Если ПользователиИБ.Количество() = 0 Тогда
		Результат.Пояснение = НСтр("ru = 'В информационной базе нет пользователей.'");
	ИначеЕсли ТаблицаПользователей.Количество() = 0 И ВидПоПолномуИмени(КлючУзла) = "Роль" Тогда
		Результат.Пояснение = НСтр("ru = 'Роль не назначена ни одному пользователю.'");
	ИначеЕсли ТаблицаПользователей.Количество() = 0 Тогда
		Результат.Пояснение = НСтр("ru = 'Ни одному пользователю роли не дают прав на этот объект.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет права ролей текущего сеанса на узел состава: какие права объекта дает каждая роль.
// Права проверяются функцией ПравоДоступа, поэтому только у объектов метаданных текущего сеанса:
// для конфигураций, загруженных из файла, права не возвращаются.
// Права на поле (реквизит, табличную часть, измерение и т.п.) возвращаются с учетом прав на объект:
// поле доступно роли, только если ей доступен и объект, см. ЗаполнитьПраваРолейНаПоле.
// Для кэширования на время сеанса используйте ПраваРолейНаОбъект.
//
// Параметры:
//  КлючКэша - Строка, Неопределено - чья это конфигурация, см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Структура:
//   * Права - Массив из Структура - права объекта в порядке вывода:
//     ** Имя - Строка - имя права для функции ПравоДоступа
//     ** Представление - Строка - представление права, например "Интерактивное добавление"
//   * Роли - ТаблицаЗначений - роли, которые дают хотя бы одно право, по возрастанию полного имени.
//     Кроме колонок Роль, Ограничено, ОграничениеУсловием и признаков расширений в таблице есть колонка
//     типа Булево на каждое право из Права: имя колонки - имя права, заголовок - представление права:
//     ** Роль - Строка - полное имя роли
//     ** Ограничено - Булево - роль дает право на объект, но не на поле
//     ** ОграничениеУсловием - Булево - роль ограничивает доступ к данным условием, см. ЗаполнитьОграниченияУсловием
//     ** ДобавленРасширением - Булево - роль добавлена расширением, см. ПризнакиРасширений
//     ** ЗаимствованРасширением - Булево - роль заимствована расширением, см. ПризнакиРасширений
//     ** ИзмененРасширением - Булево - роль изменена расширениями, см. ПризнакиРасширений
//   * ПроверяетсяОграничениеУсловием - Булево - объекту можно задать ограничение доступа условием,
//       колонка ОграничениеУсловием заполнена
//   * Пояснение - Строка - почему прав нет или как читать права на поле
Функция ПраваРолейНаОбъектСеанса(КлючКэша, КлючУзла) Экспорт

	// Объект метаданных сеанса определяется только по ключу кэша, см. ОбъектМетаданныхСеанса.
	НайденныйОбъект = Новый Структура("КлючКэша", КлючКэша);

	Права = Новый Массив;
	Роли = Новый ТаблицаЗначений;
	Роли.Колонки.Добавить("Роль", Новый ОписаниеТипов("Строка"));
	Роли.Колонки.Добавить("Ограничено", Новый ОписаниеТипов("Булево"));
	Роли.Колонки.Добавить("ОграничениеУсловием", Новый ОписаниеТипов("Булево"));
	Роли.Колонки.Добавить("ДобавленРасширением", Новый ОписаниеТипов("Булево"));
	Роли.Колонки.Добавить("ЗаимствованРасширением", Новый ОписаниеТипов("Булево"));
	Роли.Колонки.Добавить("ИзмененРасширением", Новый ОписаниеТипов("Булево"));

	Результат = Новый Структура;
	Результат.Вставить("Права", Права);
	Результат.Вставить("Роли", Роли);
	Результат.Вставить("ПроверяетсяОграничениеУсловием", Ложь);
	Результат.Вставить("Пояснение", "");

	ОбъектПроверки = ОбъектПроверкиПрав(НайденныйОбъект, КлючУзла);
	Если ОбъектПроверки = Неопределено Тогда
		Результат.Пояснение = НСтр("ru = 'Права ролей можно посмотреть только у объектов метаданных текущего сеанса.'");
		Возврат Результат;
	КонецЕсли;

	Вид = ВидПоПолномуИмени(КлючУзла);
	ИменаПрав = ПрименимыеПрава(ОбъектПроверки, Вид);
	Если ИменаПрав.Количество() = 0 Тогда
		Результат.Пояснение = НСтр("ru = 'Права ролей на объекты этого вида не выводятся.'");
		Возврат Результат;
	КонецЕсли;

	ТипБулево = Новый ОписаниеТипов("Булево");
	Для Каждого ИмяПрава Из ИменаПрав Цикл
		ОписаниеПрава = Новый Структура("Имя, Представление", ИмяПрава, ПредставлениеПрава(ИмяПрава));
		Права.Добавить(ОписаниеПрава);
		Роли.Колонки.Добавить(ИмяПрава, ТипБулево, ОписаниеПрава.Представление);
	КонецЦикла;

	ЭтоПоле = ЭтоВидПоляСПравами(Вид);
	Если ЭтоПоле Тогда
		ЗаполнитьПраваРолейНаПоле(Роли, ИменаПрав, НайденныйОбъект, КлючУзла);
	Иначе
		ЗаполнитьПраваРолейНаОбъект(Роли, ИменаПрав, ОбъектПроверки);
	КонецЕсли;
	// Ограничение условием задается правам на данные объекта верхнего уровня и его полей.
	Если ЭтоПоле Или СтрРазделить(КлючУзла, ".").Количество() = 2 Тогда
		Результат.ПроверяетсяОграничениеУсловием = ЗаполнитьОграниченияУсловием(Роли, НайденныйОбъект, КлючУзла, ЭтоПоле);
	КонецЕсли;
	Роли.Сортировать("Роль");
	// Права проверяются только у объектов метаданных сеанса, поэтому и роли - из метаданных сеанса.
	Для Каждого СтрокаРоли Из Роли Цикл
		ЗаполнитьЗначенияСвойств(СтрокаРоли, ПризнакиРасширений(Метаданные.НайтиПоПолномуИмени(СтрокаРоли.Роль), ""));
	КонецЦикла;

	Если Роли.Количество() = 0 Тогда
		Результат.Пояснение = НСтр("ru = 'Ни одна роль не дает прав на этот объект.'");
	ИначеЕсли ЭтоПоле Тогда
		Результат.Пояснение = НСтр("ru = 'Права на поле показаны с учетом прав на объект.
			|Выделены роли, которые дают права на объект, но ограничивают их на этом поле.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет, что найденный объект входит в метаданные текущего сеанса: его можно открыть в режиме
// 1С:Предприятие. Объекты конфигураций, загруженных из файла, в метаданные сеанса не входят.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Булево - Истина, если объект из метаданных текущего сеанса
Функция ЭтоОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмя) Экспорт

	Результат = (ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмя) <> Неопределено);
	Возврат Результат;

КонецФункции

// Возвращает признаки изменения объекта метаданных расширениями конфигурации текущего сеанса.
// Признаки берутся у объекта метаданных сеанса: в нем учтены все активные расширения. Объект из метаданных
// расширения ищется в метаданных сеанса по полному имени, и у него учитывается только это расширение.
// У конфигураций, загруженных из файла, признаки не определяются.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных, ОписаниеСтандартногоРеквизита, ОписаниеСтандартнойТабличнойЧасти - объект
//  КлючКэша - Строка, Неопределено - чья это конфигурация, см. НайтиОбъектМетаданных: пустая строка - текущая
//             конфигурация со всеми расширениями, имя - расширение текущей базы
//
// Возвращаемое значение:
//  Структура:
//   * ДобавленРасширением - Булево - объект добавлен расширением и принадлежит ему
//   * ЗаимствованРасширением - Булево - объект конфигурации заимствован расширением, даже если расширение
//       его не меняет, см. ЗаимствованныеОбъектыРасширенийСеанса
//   * ИзмененРасширением - Булево - объект конфигурации изменен расширением, например расширение заимствует его
//       и добавляет реквизиты или формы, см. ОбъектИзмененРасширением. У объекта, добавленного расширением,
//       признак не ставится
Функция ПризнакиРасширений(ОбъектМетаданных, КлючКэша) Экспорт

	Результат = Новый Структура("ДобавленРасширением, ЗаимствованРасширением, ИзмененРасширением", Ложь, Ложь, Ложь);
	Если ТипЗнч(ОбъектМетаданных) <> Тип("ОбъектМетаданных") Или КлючКэша = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	ЭтоТекущаяКонфигурация = (КлючКэша = "");
	Если ЭтоТекущаяКонфигурация Тогда
		ОбъектСеанса = ОбъектМетаданных;
	Иначе
		ОбъектСеанса = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	КонецЕсли;
	Если ОбъектСеанса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// У фиксированного соответствия обращение по отсутствующему ключу вызывает исключение, поэтому - Получить.
	РасширенияОбъекта = УИ_НавигаторПоМетаданнымПовтИсп.ЗаимствованныеОбъектыРасширений().Получить(ПолноеИмя);
	Если РасширенияОбъекта <> Неопределено Тогда
		Результат.ЗаимствованРасширением = (ЭтоТекущаяКонфигурация Или РасширенияОбъекта.Получить(КлючКэша) <> Неопределено);
	КонецЕсли;

	Попытка
		РасширениеОбъекта = ОбъектСеанса.РасширениеКонфигурации();
		Если РасширениеОбъекта <> Неопределено Тогда
			Результат.ДобавленРасширением = (ЭтоТекущаяКонфигурация Или РасширениеОбъекта.Имя = КлючКэша);
		ИначеЕсли ЭтоТекущаяКонфигурация Или Результат.ЗаимствованРасширением Тогда
			// Сюда доходит только ОбъектМетаданных, но система типов выводит из вызовов и корень конфигурации.
			//@skip-check bsl-legacy-check-dynamic-feature-access
			Результат.ИзмененРасширением = ОбъектСеанса.ЕстьИзмененияРасширениямиКонфигурации();
		КонецЕсли;
	Исключение
		// Методов нет в старых версиях платформы.
		Результат.ДобавленРасширением = Ложь;
		Результат.ИзмененРасширением = Ложь;
	КонецПопытки;

	// Платформа сообщает, что объект изменен расширениями, но не какими.
	Если Результат.ИзмененРасширением И Не ЭтоТекущаяКонфигурация Тогда
		Результат.ИзмененРасширением = ОбъектИзмененРасширением(РасширенияОбъекта, КлючКэша);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает активные расширения текущего сеанса, в которых есть объект узла: расширение заимствует объект
// или добавляет его. Под строкой расширения - подчиненные объекты, которые расширение заимствует или добавляет
// в объект: реквизиты, табличные части, формы, команды и т.п. Изменения модулей по метаданным не видны.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Структура:
//   * Дерево - см. НовоеДеревоРасширенийОбъекта
//   * Пояснение - Строка - почему расширений нет
Функция РасширенияОбъекта(НайденныйОбъект, КлючУзла) Экспорт

	Результат = Новый Структура("Дерево, Пояснение", НовоеДеревоРасширенийОбъекта(), "");
	Вид = ВидПоПолномуИмени(КлючУзла);
	Если НайденныйОбъект.КлючКэша = Неопределено Тогда
		Результат.Пояснение = НСтр("ru = 'Расширения можно посмотреть только у объектов метаданных текущей базы.'");
		Возврат Результат;
	ИначеЕсли Вид = "СтандартныйРеквизит" Или Вид = "СтандартнаяТабличнаяЧасть" Тогда
		Результат.Пояснение = НСтр("ru = 'Стандартные реквизиты и табличные части расширения заимствуют вместе с объектом.'");
		Возврат Результат;
	КонецЕсли;

	ЭтоКонфигурация = (Вид = "Конфигурация");
	КоллекцииСостава = Новый Массив;
	Для Каждого ОписаниеКоллекции Из КоллекцииСостава() Цикл
		// Стандартные реквизиты и табличные части есть у заимствованного объекта всегда.
		Если ПустаяСтрока(ОписаниеКоллекции.ВидЭлемента) Тогда
			КоллекцииСостава.Добавить(ОписаниеКоллекции);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ОписаниеРасширения Из УИ_НавигаторПоМетаданнымПовтИсп.РасширенияСеанса() Цикл
		Если ЭтоКонфигурация Тогда
			ОбъектРасширения = ОписаниеРасширения.Метаданные;
		Иначе
			ОбъектРасширения = ОписаниеРасширения.Метаданные.НайтиПоПолномуИмени(КлючУзла);
		КонецЕсли;
		Если ОбъектРасширения = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРасширения = Результат.Дерево.Строки.Добавить();
		СтрокаРасширения.Имя = ОписаниеРасширения.Имя;
		СтрокаРасширения.Вид = "Расширение";
		СтрокаРасширения.Представление = ПредставлениеРасширения(ОписаниеРасширения);
		СтрокаРасширения.ЭтоГруппа = Истина;
		// Конфигурацию расширяет каждое расширение, поэтому у нее выводится только список расширений.
		Если Не ЭтоКонфигурация Тогда
			СтрокаРасширения.Принадлежность = ПредставлениеПринадлежности(ОбъектРасширения);
			ДобавитьИзмененияРасширения(СтрокаРасширения.Строки, ОбъектРасширения, КоллекцииСостава);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Дерево.Строки.Количество() = 0 Тогда
		Результат.Пояснение = НСтр("ru = 'Ни одно активное расширение не заимствует и не добавляет этот объект.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает виды объектов, на которые роль дает права, в порядке списка объектов конфигурации.
// Права проверяются функцией ПравоДоступа, поэтому только у ролей текущего сеанса. Права на реквизиты,
// табличные части и команды объектов не проверяются: они действуют вместе с правами на объект.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмяРоли - Строка - полное имя роли
//
// Возвращаемое значение:
//  ТаблицаЗначений - виды, у которых есть объекты с правами роли:
//   * Вид - Строка - вид объектов, см. ВидОбъектаМетаданных
//   * Представление - Строка - представление вида во множественном числе, например "Справочники"
//   * Количество - Число - количество объектов вида, на которые роль дает хотя бы одно право
Функция ВидыОбъектовСПравамиРоли(НайденныйОбъект, ПолноеИмяРоли) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Роль = ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмяРоли);
	Если Роль = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ОписаниеВида Из ВидыОбъектовСПравами() Цикл
		ОбъектыСПравами = ОбъектыСПравамиРоли(ОписаниеВида, Роль);
		Если ОбъектыСПравами.Объекты.Количество() > 0 Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеВида);
			НоваяСтрока.Количество = ОбъектыСПравами.Объекты.Количество();
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает права роли на объекты одного вида: объекты, на которые роль дает хотя бы одно право,
// и все права вида. У объектов, которым можно задать ограничение доступа условием, проверяется и оно.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмяРоли - Строка - полное имя роли
//  Вид - Строка - вид объектов, см. ВидыОбъектовСПравамиРоли
//
// Возвращаемое значение:
//  Структура:
//   * Права - Массив из Структура - права вида в порядке вывода:
//     ** Имя - Строка - имя права для функции ПравоДоступа
//     ** Представление - Строка - представление права, например "Интерактивное добавление"
//   * Объекты - ТаблицаЗначений - объекты в порядке метаданных. Кроме колонок Объект, ОграничениеУсловием
//     и признаков расширений в таблице есть колонка типа Булево на каждое право из Права:
//     ** Объект - Строка - полное имя объекта метаданных
//     ** ОграничениеУсловием - Булево - роль ограничивает доступ к данным объекта условием
//     ** ДобавленРасширением - Булево - объект добавлен расширением, см. ПризнакиРасширений
//     ** ЗаимствованРасширением - Булево - объект заимствован расширением, см. ПризнакиРасширений
//     ** ИзмененРасширением - Булево - объект изменен расширениями, см. ПризнакиРасширений
//   * ПроверяетсяОграничениеУсловием - Булево - объектам вида можно задать ограничение доступа условием
Функция ПраваРолиНаОбъектыВида(НайденныйОбъект, ПолноеИмяРоли, Вид) Экспорт

	Права = Новый Массив;
	Объекты = Новый ТаблицаЗначений;
	Объекты.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Объекты.Колонки.Добавить("ОграничениеУсловием", Новый ОписаниеТипов("Булево"));
	Объекты.Колонки.Добавить("ДобавленРасширением", Новый ОписаниеТипов("Булево"));
	Объекты.Колонки.Добавить("ЗаимствованРасширением", Новый ОписаниеТипов("Булево"));
	Объекты.Колонки.Добавить("ИзмененРасширением", Новый ОписаниеТипов("Булево"));

	Результат = Новый Структура;
	Результат.Вставить("Права", Права);
	Результат.Вставить("Объекты", Объекты);
	Результат.Вставить("ПроверяетсяОграничениеУсловием", Ложь);

	Роль = ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмяРоли);
	ОписаниеВида = Неопределено;
	Для Каждого ОписаниеВидаСПравами Из ВидыОбъектовСПравами() Цикл
		Если ОписаниеВидаСПравами.Вид = Вид Тогда
			ОписаниеВида = ОписаниеВидаСПравами;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Роль = Неопределено Или ОписаниеВида = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ОбъектыСПравами = ОбъектыСПравамиРоли(ОписаниеВида, Роль);
	ТипБулево = Новый ОписаниеТипов("Булево");
	Для Каждого ИмяПрава Из ОбъектыСПравами.ИменаПрав Цикл
		ОписаниеПрава = Новый Структура("Имя, Представление", ИмяПрава, ПредставлениеПрава(ИмяПрава));
		Права.Добавить(ОписаниеПрава);
		Объекты.Колонки.Добавить(ИмяПрава, ТипБулево, ОписаниеПрава.Представление);
	КонецЦикла;

	ПраваСОграничением = Новый Массив;
	Для Каждого ИмяПрава Из СписокИмен("Чтение, Добавление, Изменение, Удаление") Цикл
		Если ОбъектыСПравами.ИменаПрав.Найти(ИмяПрава) <> Неопределено Тогда
			ПраваСОграничением.Добавить(ИмяПрава);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ОбъектВида Из ОбъектыСПравами.Объекты Цикл
		СтрокаОбъекта = Объекты.Добавить();
		СтрокаОбъекта.Объект = ОбъектВида.ПолноеИмя();
		ЗаполнитьЗначенияСвойств(СтрокаОбъекта, ПризнакиРасширений(ОбъектВида, ""));
		Для Каждого ИмяПрава Из ОбъектыСПравами.ИменаПрав Цикл
			СтрокаОбъекта[ИмяПрава] = ПравоДоступаРоли(ИмяПрава, ОбъектВида, Роль);
		КонецЦикла;

		КлючевоеПоле = КлючевоеПолеОграниченияУсловием(ОбъектВида, Вид);
		Если ПустаяСтрока(КлючевоеПоле) Тогда
			Продолжить;
		КонецЕсли;
		Результат.ПроверяетсяОграничениеУсловием = Истина;
		Для Каждого ИмяПрава Из ПраваСОграничением Цикл
			Если СтрокаОбъекта[ИмяПрава] И ОграничениеУсловием(ИмяПрава, ОбъектВида, КлючевоеПоле, КлючевоеПоле, Роль) Тогда
				СтрокаОбъекта.ОграничениеУсловием = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строит индекс обратных связей конфигурации: для каждого объекта метаданных - кто на него ссылается.
// Просматриваются все объекты конфигурации и их подчиненные объекты, кроме стандартных реквизитов
// и стандартных табличных частей: их типы задает платформа по связям, настроенным в самих объектах.
// Для кэширования на время сеанса используйте УИ_НавигаторПоМетаданнымПовтИсп.ИндексОбратныхСвязей.
//
// Параметры:
//  МетаданныеКонфигурации - ОбъектМетаданныхКонфигурация - конфигурация
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - полное имя объекта метаданных, на который ссылаются
//   * Значение - ФиксированныйМассив из ФиксированнаяСтруктура:
//     ** Объект - Строка - полное имя объекта, который ссылается
//     ** Вид - Строка - вид этого объекта
//     ** Свойство - Строка - имя свойства, через которое он ссылается
Функция ИндексОбратныхСвязей(МетаданныеКонфигурации) Экспорт

	Контекст = НовыйКонтекстИндекса(МетаданныеКонфигурации);
	ПолноеИмяКонфигурации = МетаданныеКонфигурации.ПолноеИмя();
	ОписаниеВидаКонфигурации = ОписаниеВидаДляИндекса(Контекст, МетаданныеКонфигурации, "Конфигурация", "");
	ДобавитьСвязиУзла(Контекст, МетаданныеКонфигурации, ОписаниеВидаКонфигурации, ПолноеИмяКонфигурации);

	Коллекции = Новый Структура;
	Для Каждого ИмяКоллекции Из ИменаКоллекцийКонфигурации() Цикл
		Коллекции.Вставить(ИмяКоллекции, Контекст.Маркер);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Коллекции, МетаданныеКонфигурации);

	Для Каждого Коллекция Из Коллекции Цикл
		Если Коллекция.Значение = Контекст.Маркер Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеКоллекции = НовоеОписаниеКоллекцииДляИндекса(Коллекция.Ключ);
		ДобавитьСвязиКоллекции(Контекст, Коллекция.Значение, ОписаниеКоллекции, "");
	КонецЦикла;

	Индекс = Новый Соответствие;
	Для Каждого СвязиЦели Из Контекст.Связи Цикл
		Индекс.Вставить(СвязиЦели.Ключ, Новый ФиксированныйМассив(СвязиЦели.Значение));
	КонецЦикла;
	Результат = Новый ФиксированноеСоответствие(Индекс);
	Возврат Результат;

КонецФункции

// Возвращает метаданные активного в текущем сеансе расширения конфигурации.
//
// Параметры:
//  ИмяРасширения - Строка - имя расширения
//
// Возвращаемое значение:
//  ОбъектМетаданныхКонфигурация, Неопределено - метаданные расширения или Неопределено, если оно не активно
Функция МетаданныеРасширения(ИмяРасширения) Экспорт

	МетаданныеКонфигурации = Неопределено;
	Для Каждого ОписаниеРасширения Из УИ_НавигаторПоМетаданнымПовтИсп.РасширенияСеанса() Цикл
		Если ОписаниеРасширения.Имя = ИмяРасширения Тогда
			МетаданныеКонфигурации = ОписаниеРасширения.Метаданные;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат МетаданныеКонфигурации;

КонецФункции

// Возвращает активные в сеансе расширения конфигурации с их метаданными в порядке применения.
// Для кэширования на время сеанса используйте УИ_НавигаторПоМетаданнымПовтИсп.РасширенияСеанса.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура:
//   * Имя - Строка - имя расширения
//   * Синоним - Строка - синоним расширения
//   * Версия - Строка - версия расширения
//   * Метаданные - ОбъектМетаданныхКонфигурация - метаданные расширения
Функция ОписанияРасширенийСеанса() Экспорт

	Описания = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные) Цикл
		ОписаниеРасширения = Новый Структура;
		ОписаниеРасширения.Вставить("Имя", Расширение.Имя);
		ОписаниеРасширения.Вставить("Синоним", Расширение.Синоним);
		ОписаниеРасширения.Вставить("Версия", Расширение.Версия);
		ОписаниеРасширения.Вставить("Метаданные", Новый ОбъектМетаданныхКонфигурация(Расширение.ПолучитьДанные()));
		Описания.Добавить(Новый ФиксированнаяСтруктура(ОписаниеРасширения));
	КонецЦикла;
	Возврат Новый ФиксированныйМассив(Описания);

КонецФункции

// Возвращает объекты конфигурации, которые заимствуют активные расширения текущего сеанса: заимствованные
// объекты верхнего уровня и их заимствованные подчиненные объекты, у каждого - заимствующие расширения.
// Собственные объекты расширений в результат не входят. Для кэширования на время сеанса используйте
// УИ_НавигаторПоМетаданнымПовтИсп.ЗаимствованныеОбъектыРасширений.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - полное имя заимствованного объекта метаданных
//   * Значение - ФиксированноеСоответствие из КлючИЗначение - расширения, которые заимствуют объект:
//     ** Ключ - Строка - имя расширения
//     ** Значение - Булево - в объекте расширения есть подчиненные объекты или состав,
//                  см. ЕстьПодчиненныеОбъектыРасширения
Функция ЗаимствованныеОбъектыРасширенийСеанса() Экспорт

	// Стандартные реквизиты и табличные части не объекты метаданных: их расширение заимствует вместе с объектом.
	КоллекцииОбъекта = Новый Массив;
	Для Каждого ОписаниеКоллекции Из КоллекцииСостава() Цикл
		Если ПустаяСтрока(ОписаниеКоллекции.ВидЭлемента) Тогда
			КоллекцииОбъекта.Добавить(ОписаниеКоллекции.Имя);
		КонецЕсли;
	КонецЦикла;

	ЗаимствованныеОбъекты = Новый Соответствие;
	КоллекцииКонфигурации = ИменаКоллекцийКонфигурации();
	Для Каждого ОписаниеРасширения Из УИ_НавигаторПоМетаданнымПовтИсп.РасширенияСеанса() Цикл
		ДобавитьЗаимствованныеОбъекты(ЗаимствованныеОбъекты, ОписаниеРасширения.Имя, ОписаниеРасширения.Метаданные,
			КоллекцииКонфигурации, КоллекцииОбъекта);
	КонецЦикла;

	ФиксированныеОбъекты = Новый Соответствие;
	Для Каждого ОписаниеОбъекта Из ЗаимствованныеОбъекты Цикл
		ФиксированныеОбъекты.Вставить(ОписаниеОбъекта.Ключ, Новый ФиксированноеСоответствие(ОписаниеОбъекта.Значение));
	КонецЦикла;
	Результат = Новый ФиксированноеСоответствие(ФиксированныеОбъекты);
	Возврат Результат;

КонецФункции

// Собирает состав объекта метаданных и свойства всех его элементов.
// Свойства читаются по общему списку групп свойств: если у объекта нет свойства
// (другой вид объекта, другая версия платформы), оно просто не попадает в результат.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект, свойства которого нужно показать
//  МетаданныеКонфигурации - ОбъектМетаданныхКонфигурация, Неопределено - конфигурация, которой принадлежит объект.
//                           Нужна, чтобы показывать типы как объекты метаданных. По умолчанию - текущая конфигурация.
//  КлючКэша - Строка, Неопределено - чья это конфигурация, см. НайтиОбъектМетаданных. По нему определяется,
//             можно ли проверить изменения расширениями, см. ПризнакиРасширений.
//             Если конфигурация не указана, это текущая конфигурация.
//
// Возвращаемое значение:
//  Структура:
//   * Состав - ДеревоЗначений - узлы объекта, его коллекций и элементов коллекций:
//     ** Ключ - Строка - ключ узла, по нему отбираются свойства узла
//     ** Имя - Строка - имя объекта или коллекции
//     ** Синоним - Строка - синоним объекта или представление коллекции
//     ** Вид - Строка - вид объекта (см. ВидОбъектаМетаданных), для узла коллекции - имя коллекции
//     ** ПолноеИмя - Строка - полное имя объекта метаданных, у стандартных реквизитов и коллекций пусто
//     ** ЭтоКоллекция - Булево - узел группирует элементы коллекции, например "Реквизиты"
//     ** Количество - Число - количество элементов коллекции
//     ** ДобавленРасширением - Булево - объект добавлен расширением, см. ПризнакиРасширений
//     ** ЗаимствованРасширением - Булево - объект заимствован расширением, см. ПризнакиРасширений
//     ** ИзмененРасширением - Булево - объект изменен расширениями, см. ПризнакиРасширений
//     ** ЭтоСсылка - Булево - узел ссылается на объект верхнего уровня из состава подсистемы, его свойства
//          не входят в таблицу Свойства и читаются отдельно, см. СвойстваОбъекта
//   * Свойства - ТаблицаЗначений - свойства всех узлов состава:
//     ** КлючУзла - Строка - ключ узла состава
//     ** ИмяГруппы - Строка - имя группы свойств
//     ** Группа - Строка - представление группы свойств
//     ** Имя - Строка - имя свойства
//     ** Значение - Строка - представление значения свойства
//     ** Ссылки - Строка - полные имена объектов метаданных из значения, через перенос строки
//   * ЭлементыСостава - ТаблицаЗначений - состав общего реквизита или плана обмена, у других объектов пустая:
//     ** Объект - Строка - полное имя объекта метаданных из состава
//     ** Вид - Строка - вид этого объекта, см. ВидОбъектаМетаданных
//     ** Использование - Строка - представление использования общего реквизита у объекта
//     ** Используется - Булево - общий реквизит используется у объекта с учетом автоиспользования,
//          у элементов состава плана обмена всегда Истина
//     ** УсловноеРазделение - Строка - полное имя объекта метаданных, от которого зависит разделение объекта
//     ** Авторегистрация - Булево - изменения объекта регистрируются в плане обмена автоматически
Функция ДанныеСвойствОбъекта(ОбъектМетаданных, МетаданныеКонфигурации = Неопределено, КлючКэша = Неопределено) Экспорт

	Контекст = НовыйКонтекстЗаполнения(МетаданныеКонфигурации, КлючКэша);
	Вид = ВидОбъектаМетаданных(ОбъектМетаданных);
	ДобавитьУзелОбъекта(Контекст, Контекст.Состав.Строки, ОбъектМетаданных, Вид, ОбъектМетаданных.ПолноеИмя());

	Результат = Новый Структура;
	Результат.Вставить("Состав", Контекст.Состав);
	Результат.Вставить("Свойства", Контекст.Свойства);
	Результат.Вставить("ЭлементыСостава", Контекст.ЭлементыСостава);
	Возврат Результат;

КонецФункции

// Возвращает свойства одного объекта метаданных без его состава. Нужна для узлов-ссылок состава подсистемы:
// их свойства читаются при первом показе узла, см. ДанныеСвойствОбъекта.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных из той же конфигурации
//
// Возвращаемое значение:
//  ТаблицаЗначений - свойства объекта с колонками таблицы Свойства, см. ДанныеСвойствОбъекта
Функция СвойстваОбъекта(НайденныйОбъект, ПолноеИмя) Экспорт

	Контекст = НовыйКонтекстЗаполнения(НайденныйОбъект.МетаданныеКонфигурации, НайденныйОбъект.КлючКэша);
	// Объекты состава подсистемы - объекты конфигурации, а не сама конфигурация.
	ОбъектМетаданных = Контекст.МетаданныеКонфигурации.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных <> Неопределено Тогда
		ДобавитьСвойстваОбъекта(Контекст, ОбъектМетаданных, ПолноеИмя);
	КонецЕсли;
	Возврат Контекст.Свойства;

КонецФункции

// Возвращает данные текущей информационной базы по узлу состава: предопределенные элементы,
// управление итогами и агрегатами, структуру хранения.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  КлючУзла - Строка - ключ узла состава
//
// Возвращаемое значение:
//  Структура:
//   * Дерево - ДеревоЗначений - данные по группам:
//     ** Имя - Строка - имя группы или показателя
//     ** Значение - Строка - представление значения
//     ** НавигационнаяСсылка - Строка - навигационная ссылка на элемент данных, который описывает строка
//     ** ЭтоГруппа - Булево - строка группирует данные
//   * Пояснение - Строка - почему данных нет; пустая строка, если данные есть
Функция ДанныеБазыУзла(НайденныйОбъект, КлючУзла) Экспорт

	Дерево = НовоеДеревоДанныхБазы();
	Пояснение = "";

	ЧастиИмени = СтрРазделить(КлючУзла, ".");
	ОбъектМетаданных = Неопределено;
	Если ЧастиИмени.Количество() > 1 Тогда
		КлючОбъекта = СтрШаблон("%1.%2", ЧастиИмени[0], ЧастиИмени[1]);
		ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, КлючОбъекта);
	КонецЕсли;

	Если ОбъектМетаданных = Неопределено Тогда
		Пояснение = НСтр("ru = 'Данные базы можно посмотреть только у объектов метаданных текущего сеанса.'");
	ИначеЕсли ТипЗнч(ОбъектМетаданных) <> Тип("ОбъектМетаданных") Тогда
		// У самой конфигурации своих данных в базе нет.
		Пояснение = НСтр("ru = 'У этого объекта нет данных в базе.'");
	Иначе
		Вид = ВидОбъектаМетаданных(ОбъектМетаданных);
		Если КлючУзла = ОбъектМетаданных.ПолноеИмя() Тогда
			ДобавитьПредопределенныеЭлементы(Дерево, ОбъектМетаданных, Вид);
			ДобавитьУправлениеИтогами(Дерево, ОбъектМетаданных, Вид);
			ДобавитьАгрегаты(Дерево, ОбъектМетаданных, Вид);
		КонецЕсли;
		ДобавитьСтруктуруХранения(Дерево, ОбъектМетаданных, Вид, КлючУзла);
		Если Дерево.Строки.Количество() = 0 Тогда
			Пояснение = НСтр("ru = 'У этого объекта нет данных в базе.'");
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Дерево", Дерево);
	Результат.Вставить("Пояснение", Пояснение);
	Возврат Результат;

КонецФункции

// Возвращает, какими настройками итогов регистра можно управлять и какие пересчеты итогов выполнять. Итогами
// управляют у регистров накопления, бухгалтерии и у регистров сведений с итогами по срезу первых или последних,
// и только у регистров метаданных текущего сеанса.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  см. НовыеВозможностиУправленияИтогами
Функция ВозможностиУправленияИтогамиОбъекта(НайденныйОбъект, ПолноеИмя) Экспорт

	Регистр = РегистрУправленияИтогами(НайденныйОбъект, ПолноеИмя);
	Если Регистр = Неопределено Тогда
		Возможности = НовыеВозможностиУправленияИтогами();
	Иначе
		Возможности = Регистр.Возможности;
	КонецЕсли;
	Возврат Возможности;

КонецФункции

// Возвращает настройки итогов регистра в текущей базе.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя регистра
//
// Возвращаемое значение:
//  Структура:
//   * Настройки - см. НовыеНастройкиИтогов
//   * ЕстьПраво - Булево - у пользователя есть право "Управление итогами" на регистр
//   * ТекстОшибки - Строка - почему настройки не прочитаны; пустая строка, если прочитаны
Функция НастройкиИтоговРегистра(НайденныйОбъект, ПолноеИмя) Экспорт

	Результат = Новый Структура("Настройки, ЕстьПраво, ТекстОшибки", НовыеНастройкиИтогов(), Ложь, "");
	Регистр = РегистрУправленияИтогами(НайденныйОбъект, ПолноеИмя);
	Если Регистр = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Итогами этого объекта управлять нельзя.'");
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьПраво = ЕстьПравоУправленияИтогами(Регистр.ОбъектМетаданных);
	Попытка
		ЗаполнитьНастройкиИтогов(Результат.Настройки, Регистр);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось прочитать настройки итогов: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Записывает настройки итогов регистра. Устанавливаются только настройки, которые отличаются от текущих в базе:
// установка периода рассчитанных итогов пересчитывает итоги, поэтому неизмененные настройки не трогаются.
// Если запись не удалась, пользователю выводится сообщение, а настройки, установленные до ошибки, остаются.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя регистра
//  Настройки - см. НовыеНастройкиИтогов
//
// Возвращаемое значение:
//  Булево - Истина, если все настройки записаны
Функция ЗаписатьНастройкиИтоговРегистра(НайденныйОбъект, ПолноеИмя, Настройки) Экспорт

	Записаны = Ложь;
	Регистр = РегистрДляИзмененияИтогов(НайденныйОбъект, ПолноеИмя);
	Если Регистр = Неопределено Тогда
		Возврат Записаны;
	КонецЕсли;

	Попытка
		УстановитьИзмененныеНастройкиИтогов(Регистр, Настройки);
		Записаны = Истина;
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать настройки итогов: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	Возврат Записаны;

КонецФункции

// Пересчитывает итоги регистра.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя регистра
//  Операция - Строка - "ПересчитатьИтоги", "ПересчитатьТекущиеИтоги" или "ПересчитатьИтогиЗаПериод"
//  Период - СтандартныйПериод - период пересчета для операции "ПересчитатьИтогиЗаПериод"
//
// Возвращаемое значение:
//  Булево - Истина, если итоги пересчитаны; иначе пользователю выводится сообщение
Функция ПересчитатьИтогиРегистра(НайденныйОбъект, ПолноеИмя, Операция, Период) Экспорт

	Пересчитаны = Ложь;
	Регистр = РегистрДляИзмененияИтогов(НайденныйОбъект, ПолноеИмя);
	Если Регистр = Неопределено Тогда
		Возврат Пересчитаны;
	КонецЕсли;

	Менеджер = Регистр.Менеджер;
	Попытка
		Если Операция = "ПересчитатьИтоги" Тогда
			Менеджер.ПересчитатьИтоги();
		ИначеЕсли Операция = "ПересчитатьТекущиеИтоги" Тогда
			Менеджер.ПересчитатьТекущиеИтоги();
		ИначеЕсли Операция = "ПересчитатьИтогиЗаПериод" Тогда
			Менеджер.ПересчитатьИтогиЗаПериод(Период.ДатаНачала, Период.ДатаОкончания);
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестная операция с итогами ""%1"".'"), Операция);
		КонецЕсли;
		Пересчитаны = Истина;
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось пересчитать итоги: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	Возврат Пересчитаны;

КонецФункции

// Возвращает настройки итогов регистра со значениями по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * ИспользованиеИтогов - Булево - итоги используются; у регистра оборотов в режиме агрегатов не применяется
//   * ИспользованиеТекущихИтогов - Булево - только у регистров остатков и бухгалтерии
//   * РежимРазделенияИтогов - Булево - только у регистров накопления и бухгалтерии
//   * РежимАгрегатов - Булево - только у регистров оборотов
//   * ИспользованиеАгрегатов - Булево - только у регистров оборотов в режиме агрегатов
//   * МинимальныйПериодРассчитанныхИтогов - Дата - только у регистров остатков и бухгалтерии
//   * МаксимальныйПериодРассчитанныхИтогов - Дата - только у регистров остатков и бухгалтерии
Функция НовыеНастройкиИтогов() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ИспользованиеИтогов", Ложь);
	Настройки.Вставить("ИспользованиеТекущихИтогов", Ложь);
	Настройки.Вставить("РежимРазделенияИтогов", Ложь);
	Настройки.Вставить("РежимАгрегатов", Ложь);
	Настройки.Вставить("ИспользованиеАгрегатов", Ложь);
	Настройки.Вставить("МинимальныйПериодРассчитанныхИтогов", Дата(1, 1, 1));
	Настройки.Вставить("МаксимальныйПериодРассчитанныхИтогов", Дата(1, 1, 1));
	Возврат Настройки;

КонецФункции

// Проверяет, что подключением объекта можно управлять: объект - внешний источник данных метаданных текущего сеанса.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Булево - Истина, если объект - внешний источник данных текущего сеанса
Функция ЕстьУправлениеПодключениемОбъекта(НайденныйОбъект, ПолноеИмя) Экспорт

	Результат = (ВнешнийИсточникДанныхСеанса(НайденныйОбъект, ПолноеИмя) <> Неопределено);
	Возврат Результат;

КонецФункции

// Возвращает состояние соединения с внешним источником данных в текущем сеансе и его параметры соединения.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя внешнего источника данных
//  ВидПараметров - Строка - "Общие", "Сеанса" или "Пользователя"
//  ПользовательИБ - Строка - имя пользователя информационной базы для параметров пользователя
//
// Возвращаемое значение:
//  Структура:
//   * Параметры - см. НовыеПараметрыСоединения
//   * СоединениеУстановлено - Булево - соединение с источником в текущем сеансе установлено
//   * ЕстьПраво - Булево - у пользователя есть право изменять параметры соединения этого вида
//   * ТекстОшибки - Строка - почему параметры не прочитаны; пустая строка, если прочитаны
Функция ПодключениеВнешнегоИсточника(НайденныйОбъект, ПолноеИмя, ВидПараметров, ПользовательИБ) Экспорт

	Результат = Новый Структура("Параметры, СоединениеУстановлено, ЕстьПраво", НовыеПараметрыСоединения(), Ложь, Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Источник = ВнешнийИсточникДанныхСеанса(НайденныйОбъект, ПолноеИмя);
	Если Источник = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Подключением этого объекта управлять нельзя.'");
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьПраво = ЕстьПравоИзмененияПараметровСоединения(Источник.ОбъектМетаданных, ВидПараметров,
		ПользовательИБ);
	Попытка
		Состояние = Источник.Менеджер.ПолучитьСостояние();
		Результат.СоединениеУстановлено = (Состояние = СостояниеВнешнегоИсточникаДанных.Подключен);
		ПараметрыСоединения = ПараметрыСоединенияИсточника(Источник.Менеджер, ВидПараметров, ПользовательИБ);
		// Пароль из параметров соединения не читается, известно только, установлен ли он.
		ЗаполнитьЗначенияСвойств(Результат.Параметры, ПараметрыСоединения, , "Пароль");
	Исключение
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось прочитать параметры соединения: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Записывает параметры соединения с внешним источником данных. Пароль из базы не читается, поэтому записывается,
// только если он изменен, иначе остается установленный.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя внешнего источника данных
//  ВидПараметров - Строка - "Общие", "Сеанса" или "Пользователя"
//  ПользовательИБ - Строка - имя пользователя информационной базы для параметров пользователя
//  Параметры - см. НовыеПараметрыСоединения
//
// Возвращаемое значение:
//  Булево - Истина, если параметры записаны; иначе пользователю выводится сообщение
Функция ЗаписатьПараметрыСоединенияВнешнегоИсточника(НайденныйОбъект, ПолноеИмя, ВидПараметров, ПользовательИБ,
	Параметры) Экспорт

	Записаны = Ложь;
	Источник = ВнешнийИсточникДляУправленияПодключением(НайденныйОбъект, ПолноеИмя);
	Если Источник = Неопределено Тогда
		Возврат Записаны;
	КонецЕсли;

	Попытка
		// Параметры читаются из базы, чтобы в них остался установленный пароль.
		ПараметрыСоединения = ПараметрыСоединенияИсточника(Источник.Менеджер, ВидПараметров, ПользовательИБ);
		ПараметрыСоединения.СУБД = Параметры.СУБД;
		ПараметрыСоединения.СтрокаСоединения = Параметры.СтрокаСоединения;
		ПараметрыСоединения.АутентификацияОС = Параметры.АутентификацияОС;
		ПараметрыСоединения.АутентификацияСтандартная = Параметры.АутентификацияСтандартная;
		ПараметрыСоединения.ИмяПользователя = Параметры.ИмяПользователя;
		Если Параметры.ПарольИзменен Тогда
			ПараметрыСоединения.Пароль = Параметры.Пароль;
		КонецЕсли;
		УстановитьПараметрыСоединенияИсточника(Источник.Менеджер, ВидПараметров, ПользовательИБ, ПараметрыСоединения);
		Записаны = Истина;
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать параметры соединения: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	Возврат Записаны;

КонецФункции

// Устанавливает или разрывает соединение с внешним источником данных в текущем сеансе.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя внешнего источника данных
//  Установить - Булево - Истина - установить соединение, Ложь - разорвать
//
// Возвращаемое значение:
//  Булево - Истина, если соединение установлено или разорвано; иначе пользователю выводится сообщение
Функция ИзменитьСоединениеВнешнегоИсточника(НайденныйОбъект, ПолноеИмя, Установить) Экспорт

	Изменено = Ложь;
	Источник = ВнешнийИсточникДляУправленияПодключением(НайденныйОбъект, ПолноеИмя);
	Если Источник = Неопределено Тогда
		Возврат Изменено;
	КонецЕсли;

	Попытка
		Если Установить Тогда
			Источник.Менеджер.УстановитьСоединение();
		Иначе
			Источник.Менеджер.РазорватьСоединение();
		КонецЕсли;
		Изменено = Истина;
	Исключение
		Если Установить Тогда
			Шаблон = НСтр("ru = 'Не удалось установить соединение с внешним источником данных: %1'");
		Иначе
			Шаблон = НСтр("ru = 'Не удалось разорвать соединение с внешним источником данных: %1'");
		КонецЕсли;
		УИ_ОбщегоНазначения.СообщитьПользователю(СтрШаблон(Шаблон, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Изменено;

КонецФункции

// Возвращает имена пользователей информационной базы для выбора пользователя, чьи параметры соединения
// показываются. Без права получать список пользователей возвращается только текущий пользователь.
//
// Возвращаемое значение:
//  Массив из Строка - имена пользователей по алфавиту
Функция ИменаПользователейДляПараметровСоединения() Экспорт

	Имена = Новый СписокЗначений;
	Попытка
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			Имена.Добавить(ПользовательИБ.Имя);
		КонецЦикла;
	Исключение
		Имена.Очистить();
		Имена.Добавить(ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	КонецПопытки;
	Имена.СортироватьПоЗначению();
	Результат = Имена.ВыгрузитьЗначения();
	Возврат Результат;

КонецФункции

// Возвращает параметры соединения с внешним источником данных, по умолчанию - не заданные. Неопределено
// в значении параметра - параметр не задан на этом уровне и берется из родительских параметров соединения:
// у параметров сеанса - из параметров пользователя, у параметров пользователя - из общих.
//
// Возвращаемое значение:
//  Структура:
//   * СУБД - Строка, Неопределено - тип СУБД, например MSSQLServer или PostgreSQL; пустая строка - "Прочее"
//   * СтрокаСоединения - Строка, Неопределено - строка соединения с источником
//   * АутентификацияОС - Булево, Неопределено - соединяться с аутентификацией операционной системы
//   * АутентификацияСтандартная - Булево, Неопределено - соединяться со стандартной аутентификацией
//   * ИмяПользователя - Строка, Неопределено - имя пользователя стандартной аутентификации
//   * Пароль - Строка, Неопределено - пароль стандартной аутентификации; из базы не читается
//   * ПарольУстановлен - Булево - в параметрах соединения установлен пароль
//   * ПарольИзменен - Булево - пароль нужно записать; иначе остается установленный
Функция НовыеПараметрыСоединения() Экспорт

	ПараметрыСоединения = Новый Структура;
	ПараметрыСоединения.Вставить("СУБД", Неопределено);
	ПараметрыСоединения.Вставить("СтрокаСоединения", Неопределено);
	ПараметрыСоединения.Вставить("АутентификацияОС", Неопределено);
	ПараметрыСоединения.Вставить("АутентификацияСтандартная", Неопределено);
	ПараметрыСоединения.Вставить("ИмяПользователя", Неопределено);
	ПараметрыСоединения.Вставить("Пароль", Неопределено);
	ПараметрыСоединения.Вставить("ПарольУстановлен", Ложь);
	ПараметрыСоединения.Вставить("ПарольИзменен", Ложь);
	Возврат ПараметрыСоединения;

КонецФункции

// Обновляет нумерацию объекта метаданных текущего сеанса, а у конфигурации текущего сеанса - нумерацию всех
// объектов. Нумерацию обновляют, например, после загрузки данных, если новые номера или коды повторяют
// загруженные. Обновлять нумерацию может только администратор.
//
// Параметры:
//  НайденныйОбъект - см. НайтиОбъектМетаданных
//  ПолноеИмя - Строка - полное имя объекта с номером или кодом либо конфигурации,
//              см. УИ_НавигаторПоМетаданнымКлиентСервер.МожноОбновитьНумерациюОбъекта
//
// Возвращаемое значение:
//  Булево - Истина, если нумерация обновлена; иначе пользователю выводится сообщение
Функция ОбновитьНумерациюОбъекта(НайденныйОбъект, ПолноеИмя) Экспорт

	Обновлена = Ложь;
	ТекстОшибки = "";
	ОбъектМетаданных = ОбъектМетаданныхСеанса(НайденныйОбъект, ПолноеИмя);
	Если ОбъектМетаданных = Неопределено
		Или Не УИ_НавигаторПоМетаданнымКлиентСервер.МожноОбновитьНумерациюОбъекта(ПолноеИмя) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Нумерацию объекта ""%1"" обновить нельзя.'"), ПолноеИмя);
	ИначеЕсли Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ТекстОшибки = НСтр("ru = 'Нет права ""Администрирование"": обновить нумерацию может только администратор.'");
	Иначе
		Попытка
			Если ВидПоПолномуИмени(ПолноеИмя) = "Конфигурация" Тогда
				ОбновитьНумерациюОбъектов();
			Иначе
				ОбновитьНумерациюОбъектов(ОбъектМетаданных);
			КонецЕсли;
			Обновлена = Истина;
		Исключение
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось обновить нумерацию: %1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		УИ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	Возврат Обновлена;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПоискОбъекта

// Возвращает конфигурации, отмеченные в дереве отбора, в порядке поиска.
//
// Параметры:
//  ДеревоОтбораКонфигураций - ДеревоЗначений, Неопределено - дерево отбора конфигураций навигатора
//
// Возвращаемое значение:
//  Массив из Структура:
//   * МетаданныеКонфигурации - ОбъектМетаданныхКонфигурация - метаданные конфигурации
//   * КлючКэша - Строка, Неопределено - см. НайтиОбъектМетаданных
Функция КонфигурацииОтбора(ДеревоОтбораКонфигураций)

	Результат = Новый Массив;
	Если ДеревоОтбораКонфигураций = Неопределено Тогда
		СтрокиКонфигураций = Новый Массив;
	Иначе
		СтрокиКонфигураций = ДеревоОтбораКонфигураций.Строки;
	КонецЕсли;

	// Как и навигатор, учитываем первую конфигурацию, в которой что-то отмечено.
	Для Каждого СтрокаКонфигурации Из СтрокиКонфигураций Цикл
		Если СтрокаКонфигурации.Пометка = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаКонфигурации.Пометка = 1 Тогда
			ДобавитьМетаданныеСтрокиОтбора(Результат, СтрокаКонфигурации, Ложь);
		Иначе
			Для Каждого СтрокаРасширения Из СтрокаКонфигурации.Строки Цикл
				Если СтрокаРасширения.Пометка = 1 Тогда
					ДобавитьМетаданныеСтрокиОтбора(Результат, СтрокаРасширения, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьМетаданныеСтрокиОтбора(ОписанияКонфигураций, СтрокаОтбора, ЭтоРасширение)

	// Адреса двоичных данных принадлежат форме навигатора: после ее закрытия данных по ним уже нет.
	ДанныеМетаданных = Неопределено;
	Если ЭтоАдресВременногоХранилища(СтрокаОтбора.АдресМетаданных) Тогда
		ДанныеМетаданных = ПолучитьИзВременногоХранилища(СтрокаОтбора.АдресМетаданных);
	КонецЕсли;

	МетаданныеКонфигурации = Неопределено;
	Если ТипЗнч(ДанныеМетаданных) = Тип("ДвоичныеДанные") Тогда
		МетаданныеКонфигурации = Новый ОбъектМетаданныхКонфигурация(ДанныеМетаданных);
	ИначеЕсли СтрокаОтбора.ЭтоТекущаяБазаДанных И Не ЭтоРасширение Тогда
		МетаданныеКонфигурации = Метаданные;
	ИначеЕсли СтрокаОтбора.ЭтоТекущаяБазаДанных Тогда
		МетаданныеКонфигурации = МетаданныеРасширения(СтрокаОтбора.Имя);
	КонецЕсли;

	// Кэшируются только конфигурация текущей базы и ее активные расширения: их метаданные не меняются до конца сеанса.
	КлючКэша = Неопределено;
	Если СтрокаОтбора.ЭтоТекущаяБазаДанных И ЭтоРасширение Тогда
		КлючКэша = СтрокаОтбора.Имя;
	ИначеЕсли СтрокаОтбора.ЭтоТекущаяБазаДанных Тогда
		КлючКэша = "";
	КонецЕсли;

	Если МетаданныеКонфигурации <> Неопределено Тогда
		ОписаниеКонфигурации = Новый Структура;
		ОписаниеКонфигурации.Вставить("МетаданныеКонфигурации", МетаданныеКонфигурации);
		ОписаниеКонфигурации.Вставить("КлючКэша", КлючКэша);
		ОписанияКонфигураций.Добавить(ОписаниеКонфигурации);
	КонецЕсли;

КонецПроцедуры

// Находит объект метаданных в конфигурации по полному имени. Саму конфигурацию НайтиПоПолномуИмени не находит,
// поэтому ее полное имя проверяется отдельно.
//
// Параметры:
//  МетаданныеКонфигурации - ОбъектМетаданныхКонфигурация - конфигурация
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  ОбъектМетаданных, ОбъектМетаданныхКонфигурация, Неопределено - найденный объект
Функция НайтиВКонфигурации(МетаданныеКонфигурации, ПолноеИмя)

	Если МетаданныеКонфигурации.ПолноеИмя() = ПолноеИмя Тогда
		ОбъектМетаданных = МетаданныеКонфигурации;
	Иначе
		ОбъектМетаданных = МетаданныеКонфигурации.НайтиПоПолномуИмени(ПолноеИмя);
	КонецЕсли;
	Возврат ОбъектМетаданных;

КонецФункции

// Возвращает вид объекта по полному имени: предпоследняя часть имени. Справочник.Номенклатура - Справочник,
// Документ.Заказ.ТабличнаяЧасть.Товары - ТабличнаяЧасть, Подсистема.Продажи.Подсистема.Отчеты - Подсистема.
// У конфигурации полное имя из двух частей, вид - первая часть.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Строка - вид объекта метаданных
Функция ВидПоПолномуИмени(ПолноеИмя)

	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	ИндексВида = Макс(ЧастиИмени.ВГраница() - 1, 0);
	Вид = ЧастиИмени[ИндексВида];
	Возврат Вид;

КонецФункции

#КонецОбласти

#Область ЗаполнениеСостава

Функция НовыйКонтекстЗаполнения(МетаданныеКонфигурации, КлючКэша = Неопределено)

	Маркер = Новый УникальныйИдентификатор;

	ГруппыСвойств = ГруппыСвойств();
	ШаблонСвойств = Новый Структура;
	Для Каждого Группа Из ГруппыСвойств Цикл
		Для Каждого ИмяСвойства Из Группа.Свойства Цикл
			ШаблонСвойств.Вставить(ИмяСвойства, Маркер);
		КонецЦикла;
	КонецЦикла;

	КоллекцииСостава = КоллекцииСостава();
	ШаблонКоллекций = Новый Структура;
	Для Каждого Коллекция Из КоллекцииСостава Цикл
		ШаблонКоллекций.Вставить(Коллекция.Имя, Маркер);
	КонецЦикла;

	КоллекцииСвойств = КоллекцииСвойств();
	ШаблонКоллекцийСвойств = Новый Структура;
	Для Каждого Коллекция Из КоллекцииСвойств Цикл
		ШаблонКоллекцийСвойств.Вставить(Коллекция.Имя, Маркер);
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("МетаданныеКонфигурации", ?(МетаданныеКонфигурации = Неопределено, Метаданные, МетаданныеКонфигурации));
	Контекст.Вставить("КлючКэша", ?(МетаданныеКонфигурации = Неопределено, "", КлючКэша));
	Контекст.Вставить("Маркер", Маркер);
	Контекст.Вставить("ГруппыСвойств", ГруппыСвойств);
	Контекст.Вставить("ШаблонСвойств", Новый ФиксированнаяСтруктура(ШаблонСвойств));
	Контекст.Вставить("КоллекцииСвойств", КоллекцииСвойств);
	Контекст.Вставить("ШаблонКоллекцийСвойств", Новый ФиксированнаяСтруктура(ШаблонКоллекцийСвойств));
	Контекст.Вставить("КоллекцииСостава", КоллекцииСостава);
	Контекст.Вставить("ШаблонКоллекций", Новый ФиксированнаяСтруктура(ШаблонКоллекций));
	Контекст.Вставить("Состав", НовоеДеревоСостава());
	Контекст.Вставить("Свойства", НоваяТаблицаСвойств());
	Контекст.Вставить("ЭлементыСостава", НоваяТаблицаЭлементовСостава());
	Возврат Контекст;

КонецФункции

Функция НовоеДеревоСостава()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Ключ", ТипСтрока);
	Дерево.Колонки.Добавить("Имя", ТипСтрока);
	Дерево.Колонки.Добавить("Синоним", ТипСтрока);
	Дерево.Колонки.Добавить("Вид", ТипСтрока);
	Дерево.Колонки.Добавить("ПолноеИмя", ТипСтрока);
	Дерево.Колонки.Добавить("ЭтоКоллекция", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("ЭтоСсылка", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ДобавленРасширением", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ЗаимствованРасширением", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ИзмененРасширением", Новый ОписаниеТипов("Булево"));
	Возврат Дерево;

КонецФункции

Функция НоваяТаблицаСвойств()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КлючУзла", ТипСтрока);
	Таблица.Колонки.Добавить("ИмяГруппы", ТипСтрока);
	Таблица.Колонки.Добавить("Группа", ТипСтрока);
	Таблица.Колонки.Добавить("Имя", ТипСтрока);
	Таблица.Колонки.Добавить("Значение", ТипСтрока);
	Таблица.Колонки.Добавить("Ссылки", ТипСтрока);
	Таблица.Индексы.Добавить("КлючУзла");
