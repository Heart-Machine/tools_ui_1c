		|ВнешниеИсточникиДанных");
	Возврат Имена;

КонецФункции

// Возвращает группы обратных связей в порядке вывода.
// Ключ соответствия - "Вид.Свойство", "Свойство" или "НачалоИмениСвойства*", см. ГруппаОбратнойСвязи.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - ключ связи
//   * Значение - Структура - см. ГруппаОбратнойСвязи
Функция ГруппыОбратныхСвязей()

	Группы = Новый Соответствие;
	ДобавитьГруппуОбратныхСвязей(Группы, "Подсистемы", НСтр("ru = 'Подсистемы'"), "Подсистема.Состав");
	ДобавитьГруппуОбратныхСвязей(Группы, "Регистраторы", НСтр("ru = 'Регистраторы'"), "Документ.Движения");
	ДобавитьГруппуОбратныхСвязей(Группы, "Последовательности", НСтр("ru = 'Последовательности'"),
		"Последовательность.Документы, Последовательность.Движения, СоответствиеДвижениям, СоответствиеДокументам");
	ДобавитьГруппуОбратныхСвязей(Группы, "ПодпискиНаСобытия", НСтр("ru = 'Подписки на события'"),
		"ПодпискаНаСобытие.Источник, ПодпискаНаСобытие.Обработчик");
	ДобавитьГруппуОбратныхСвязей(Группы, "РегламентныеЗадания", НСтр("ru = 'Регламентные задания'"),
		"РегламентноеЗадание.ИмяМетода");
	ДобавитьГруппуОбратныхСвязей(Группы, "Команды", НСтр("ru = 'Команды с параметром этого типа'"), "ТипПараметраКоманды");
	ДобавитьГруппуОбратныхСвязей(Группы, "ОбщиеРеквизиты", НСтр("ru = 'Общие реквизиты'"),
		"ОбщийРеквизит.Состав, ЗначениеРазделенияДанных, ИспользованиеРазделенияДанных");
	ДобавитьГруппуОбратныхСвязей(Группы, "ФункциональныеОпции", НСтр("ru = 'Функциональные опции'"),
		"ФункциональнаяОпция.Состав, ФункциональнаяОпция.Хранение, ПараметрФункциональныхОпций.Использование");
	ДобавитьГруппуОбратныхСвязей(Группы, "ОпределяемыеТипы", НСтр("ru = 'Определяемые типы'"), "ОпределяемыйТип.Тип");
	ДобавитьГруппуОбратныхСвязей(Группы, "Типы", НСтр("ru = 'Используется в типах'"), "Тип");
	ДобавитьГруппуОбратныхСвязей(Группы, "ПодчиненныеСправочники", НСтр("ru = 'Подчиненные справочники'"), "Владельцы");
	ДобавитьГруппуОбратныхСвязей(Группы, "ВводНаОсновании", НСтр("ru = 'На основании вводятся'"), "ВводитсяНаОсновании");
	ДобавитьГруппуОбратныхСвязей(Группы, "ПланыОбмена", НСтр("ru = 'Планы обмена'"), "ПланОбмена.Состав");
	ДобавитьГруппуОбратныхСвязей(Группы, "КритерииОтбора", НСтр("ru = 'Критерии отбора'"), "КритерийОтбора.Состав");
	ДобавитьГруппуОбратныхСвязей(Группы, "ЖурналыДокументов", НСтр("ru = 'Журналы документов'"),
		"ЖурналДокументов.РегистрируемыеДокументы, Графа.Ссылки");
	ДобавитьГруппуОбратныхСвязей(Группы, "Нумераторы", НСтр("ru = 'Документы с этим нумератором'"), "Нумератор");
	ДобавитьГруппуОбратныхСвязей(Группы, "РегистрыИПланы", НСтр("ru = 'Регистры и планы'"),
		"ПланСчетов, ВидыСубконто, ПланВидовРасчета, График, ЗначениеГрафика, ДатаГрафика, БазовыеВидыРасчета,
		|ДополнительныеЗначенияХарактеристик, ИзмерениеРегистра, ДанныеВедущихРегистров, ПризнакУчета,
		|ПризнакУчетаСубконто");
	ДобавитьГруппуОбратныхСвязей(Группы, "БизнесПроцессыИЗадачи", НСтр("ru = 'Бизнес-процессы и задачи'"),
		"Задача, Адресация, ОсновнойРеквизитАдресации, ТекущийИсполнитель, ИзмерениеАдресации");
	ДобавитьГруппуОбратныхСвязей(Группы, "WebСервисы", НСтр("ru = 'Web-сервисы'"), "ПакетыXDTO");
	ДобавитьГруппуОбратныхСвязей(Группы, "ГруппыКоманд", НСтр("ru = 'Команды группы'"), "Группа");
	ДобавитьГруппуОбратныхСвязей(Группы, "ФормыВыбора", НСтр("ru = 'Форма выбора'"), "ФормаВыбора");
	ДобавитьГруппуОбратныхСвязей(Группы, "ФормыИМакетыПоУмолчанию", НСтр("ru = 'Основные и дополнительные формы и макеты'"),
		"ОсновнаяФорма*, ДополнительнаяФорма*, ОсновнаяСхемаКомпоновкиДанных, ОсновнойМакетОформленияОтчета");
	ДобавитьГруппуОбратныхСвязей(Группы, "СвойстваКонфигурации", НСтр("ru = 'Свойства конфигурации'"),
		"ОсновнойЯзык, ОсновнойСтиль, ОсновнойИнтерфейс, ОсновныеРоли, Хранилище*");
	// Права ролей не входят в индекс, см. ПраваРолейУзла.
	ДобавитьГруппуОбратныхСвязей(Группы, "Роли", НСтр("ru = 'Роли'"), "Роль.Права");
	Возврат Группы;

КонецФункции

Процедура ДобавитьГруппуОбратныхСвязей(Группы, Имя, Представление, КлючиСвязей)

	ОписаниеГруппы = Новый Структура;
	ОписаниеГруппы.Вставить("Имя", Имя);
	ОписаниеГруппы.Вставить("Представление", Представление);
	ОписаниеГруппы.Вставить("Порядок", Группы.Количество());
	Для Каждого КлючСвязи Из СписокИмен(КлючиСвязей) Цикл
		Группы.Вставить(КлючСвязи, ОписаниеГруппы);
	КонецЦикла;

КонецПроцедуры

// Возвращает права, которые роли задают объектам метаданных каждого вида, в порядке вывода.
// У web-сервисов, HTTP-сервисов и сервисов интеграции права задаются их операциям, методам и каналам.
// Права полей (реквизитов, табличных частей, измерений и т.п.) действуют вместе с правами на объект,
// см. ЗаполнитьПраваРолейНаПоле.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - вид объекта метаданных, см. ВидОбъектаМетаданных
//   * Значение - Массив из Строка - имена прав
Функция ПраваВидовОбъектов()

	ПраваОбъекта = "Чтение, Добавление, Изменение, Удаление, Просмотр, Редактирование, ВводПоСтроке,
		|ИнтерактивноеДобавление, ИнтерактивноеУдаление, ИнтерактивнаяПометкаУдаления, ИнтерактивноеСнятиеПометкиУдаления,
		|ИнтерактивноеУдалениеПомеченных";
	ПраваПредопределенных = "ИнтерактивноеУдалениеПредопределенныхДанных, ИнтерактивнаяПометкаУдаленияПредопределенныхДанных,
		|ИнтерактивноеСнятиеПометкиУдаленияПредопределенныхДанных, ИнтерактивноеУдалениеПомеченныхПредопределенныхДанных";
	ПраваПроведения = "Проведение, ОтменаПроведения, ИнтерактивноеПроведение, ИнтерактивноеПроведениеНеОперативное,
		|ИнтерактивнаяОтменаПроведения, ИнтерактивноеИзменениеПроведенных";
	ПраваИстории = "ЧтениеИсторииДанных, ПросмотрИсторииДанных, ИзменениеИсторииДанных, ИзменениеНастроекИсторииДанных,
		|ИзменениеКомментарияВерсииИсторииДанных, РедактированиеКомментарияВерсииИсторииДанных, ПереходНаВерсиюИсторииДанных";
	ПраваИсторииОтсутствующихДанных = "ЧтениеИсторииДанныхОтсутствующихДанных, ИзменениеИсторииДанныхОтсутствующихДанных";
	ПраваРегистра = "Чтение, Изменение, Просмотр, Редактирование, УправлениеИтогами";

	Права = Новый Соответствие;
	ДобавитьПраваВидов(Права, "Конфигурация",
		"Администрирование, АдминистрированиеДанных, ОбновлениеКонфигурацииБазыДанных, АдминистрированиеРасширенийКонфигурации,
		|МонопольныйРежим, АктивныеПользователи, ЖурналРегистрации, ТонкийКлиент, ВебКлиент, МобильныйКлиент, ТолстыйКлиент,
		|ВнешнееСоединение, Automation, РежимВсеФункции, РежимТехническогоСпециалиста, СохранениеДанныхПользователя,
		|ИнтерактивноеОткрытиеВнешнихОбработок, ИнтерактивноеОткрытиеВнешнихОтчетов, Вывод,
		|РежимОсновногоОкнаОбычный, РежимОсновногоОкнаРабочееМесто, РежимОсновногоОкнаВстроенноеРабочееМесто,
		|РежимОсновногоОкнаПолноэкранноеРабочееМесто, РежимОсновногоОкнаКиоск, КлиентСистемыАналитики,
		|РегистрацияИнформационнойБазыСистемыВзаимодействия");
	ДобавитьПраваВидов(Права, "Подсистема, ОбщаяФорма, ОбщаяКоманда, КритерийОтбора, Команда", "Просмотр");
	ДобавитьПраваВидов(Права, "ОбщийРеквизит", "Просмотр, Редактирование");
	ДобавитьПраваВидов(Права, "ПараметрСеанса", "Получение, Установка");
	ДобавитьПраваВидов(Права, "Константа", СтрШаблон("Чтение, Изменение, Просмотр, Редактирование, %1", ПраваИстории));
	ДобавитьПраваВидов(Права, "Справочник, ПланВидовХарактеристик, ПланСчетов, ПланВидовРасчета",
		СтрШаблон("%1, %2, %3, %4", ПраваОбъекта, ПраваПредопределенных, ПраваИстории, ПраваИсторииОтсутствующихДанных));
	ДобавитьПраваВидов(Права, "ПланОбмена",
		СтрШаблон("%1, %2, %3", ПраваОбъекта, ПраваИстории, ПраваИсторииОтсутствующихДанных));
	ДобавитьПраваВидов(Права, "Документ",
		СтрШаблон("%1, %2, %3, %4", ПраваОбъекта, ПраваПроведения, ПраваИстории, ПраваИсторииОтсутствующихДанных));
	ДобавитьПраваВидов(Права, "ЖурналДокументов", "Чтение, Просмотр");
	ДобавитьПраваВидов(Права, "Последовательность", "Чтение, Изменение");
	ДобавитьПраваВидов(Права, "Отчет, Обработка", "Использование, Просмотр");
	ДобавитьПраваВидов(Права, "РегистрСведений",
		СтрШаблон("%1, %2, %3", ПраваРегистра, ПраваИстории, ПраваИсторииОтсутствующихДанных));
	ДобавитьПраваВидов(Права, "РегистрНакопления, РегистрБухгалтерии", ПраваРегистра);
	ДобавитьПраваВидов(Права, "РегистрРасчета", "Чтение, Изменение, Просмотр, Редактирование");
	ДобавитьПраваВидов(Права, "БизнесПроцесс",
		СтрШаблон("%1, Старт, ИнтерактивныйСтарт, ИнтерактивнаяАктивация, %2", ПраваОбъекта, ПраваИстории));
	ДобавитьПраваВидов(Права, "Задача",
		СтрШаблон("%1, Выполнение, ИнтерактивноеВыполнение, ИнтерактивнаяАктивация, %2", ПраваОбъекта, ПраваИстории));
	ДобавитьПраваВидов(Права, "Операция, Метод, КаналСервисаИнтеграции", "Использование");
	ДобавитьПраваВидов(Права, ВидыПолейСПравами(), "Просмотр, Редактирование");
	Возврат Права;

КонецФункции

Процедура ДобавитьПраваВидов(Права, Виды, ИменаПрав)

	СписокПрав = СписокИмен(ИменаПрав);
	Для Каждого Вид Из СписокИмен(Виды) Цикл
		Права.Вставить(Вид, СписокПрав);
	КонецЦикла;

КонецПроцедуры

// Возвращает коллекции подчиненных объектов в порядке вывода в составе.
// Список общий для всех видов: у конкретного объекта выводятся только те коллекции, которые у него есть.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка - имя свойства-коллекции объекта метаданных
//   * Представление - Строка - представление коллекции
//   * ВидЭлемента - Строка - вид элементов, если они не объекты метаданных (стандартные реквизиты и табличные части)
Функция КоллекцииСостава()

	Коллекции = Новый Массив;
