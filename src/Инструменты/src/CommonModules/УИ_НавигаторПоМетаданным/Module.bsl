	ДобавитьКоллекциюСостава(Коллекции, "ЗначенияПеречисления", НСтр("ru = 'Значения'"));
	ДобавитьКоллекциюСостава(Коллекции, "Графы", НСтр("ru = 'Графы'"));
	ДобавитьКоллекциюСостава(Коллекции, "Перерасчеты", НСтр("ru = 'Перерасчеты'"));
	ДобавитьКоллекциюСостава(Коллекции, "Поля", НСтр("ru = 'Поля'"));
	ДобавитьКоллекциюСостава(Коллекции, "Таблицы", НСтр("ru = 'Таблицы'"));
	ДобавитьКоллекциюСостава(Коллекции, "Кубы", НСтр("ru = 'Кубы'"));
	ДобавитьКоллекциюСостава(Коллекции, "ТаблицыИзмерений", НСтр("ru = 'Таблицы измерений'"));
	ДобавитьКоллекциюСостава(Коллекции, "Функции", НСтр("ru = 'Функции'"));
	ДобавитьКоллекциюСостава(Коллекции, "Параметры", НСтр("ru = 'Параметры'"));
	ДобавитьКоллекциюСостава(Коллекции, "Операции", НСтр("ru = 'Операции'"));
	ДобавитьКоллекциюСостава(Коллекции, "ШаблоныURL", НСтр("ru = 'Шаблоны URL'"));
	ДобавитьКоллекциюСостава(Коллекции, "Методы", НСтр("ru = 'Методы'"));
	ДобавитьКоллекциюСостава(Коллекции, "КаналыСервисаИнтеграции", НСтр("ru = 'Каналы'"));
	ДобавитьКоллекциюСостава(Коллекции, "Подсистемы", НСтр("ru = 'Подсистемы'"));
	ДобавитьКоллекциюСостава(Коллекции, "Формы", НСтр("ru = 'Формы'"));
