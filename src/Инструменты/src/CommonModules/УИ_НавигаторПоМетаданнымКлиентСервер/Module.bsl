#Область ПрограммныйИнтерфейс

// Возвращает способ, которым команда "Открыть объект/список метаданных" открывает объект метаданных.
// Открываются объекты верхнего уровня, формы любых объектов, макеты объектов верхнего уровня, а также таблицы,
// кубы и таблицы измерений внешних источников данных.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, например Справочник.Валюты или
//              Справочник.Валюты.Форма.ФормаЭлемента, Справочник.Валюты.Макет.Классификатор
//
// Возвращаемое значение:
//  Строка - способ открытия; пустая строка, если объект этой командой не открывается:
//   "ФормаСписка" - открывается форма списка объекта,
//   "Форма" - открывается основная форма обработки или отчета,
//   "ФормаКонстант" - открывается форма констант,
//   "ПолноеИмя" - открывается форма с этим полным именем: общая форма или форма объекта,
//   "Макет" - открывается общий макет или макет объекта
Функция СпособОткрытияОбъекта(ПолноеИмя) Экспорт

	Результат = "";
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	КоличествоЧастей = ЧастиИмени.Количество();
	Если КоличествоЧастей < 2 Или КоличествоЧастей % 2 = 1 Тогда
		Возврат Результат;
	КонецЕсли;

	// Вид самого объекта - предпоследняя часть полного имени.
	Вид = ЧастиИмени[КоличествоЧастей - 2];
	Если КоличествоЧастей > 2 Тогда
		Если Вид = "Форма" Тогда
			Результат = "ПолноеИмя";
		ИначеЕсли Вид = "Макет" И КоличествоЧастей = 4 Тогда
			// Макет получается у менеджера владельца, поэтому открываются только макеты объектов верхнего уровня.
			Результат = "Макет";
		ИначеЕсли ЧастиИмени[0] = "ВнешнийИсточникДанных"
			И (Вид = "Таблица" Или Вид = "Куб" Или Вид = "ТаблицаИзмерения") Тогда
			Результат = "ФормаСписка";
		КонецЕсли;
	ИначеЕсли ВидыСФормойСписка().Найти(Вид) <> Неопределено Тогда
		Результат = "ФормаСписка";
	ИначеЕсли Вид = "Обработка" Или Вид = "Отчет" Тогда
		Результат = "Форма";
	ИначеЕсли Вид = "Константа" Тогда
		Результат = "ФормаКонстант";
	ИначеЕсли Вид = "ОбщаяФорма" Тогда
		Результат = "ПолноеИмя";
	ИначеЕсли Вид = "ОбщийМакет" Тогда
		Результат = "Макет";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет, что объект метаданных открывается командой "Открыть объект/список метаданных",
// см. СпособОткрытияОбъекта.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Булево - Истина, если объект можно открыть
Функция МожноОткрытьОбъектСписокМетаданных(ПолноеИмя) Экспорт

	Результат = Не ПустаяСтрока(СпособОткрытияОбъекта(ПолноеИмя));
	Возврат Результат;

КонецФункции

// Проверяет, что у объекта метаданных можно открыть динамический список: у объектов с формой списка,
// кроме перечислений.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных верхнего уровня
//
// Возвращаемое значение:
//  Булево - Истина, если динамический список можно открыть
Функция МожноОткрытьДинамическийСписок(ПолноеИмя) Экспорт

	Вид = ВидОбъекта(ПолноеИмя);
	Результат = (ВидыСФормойСписка().Найти(Вид) <> Неопределено И Вид <> "Перечисление");
	Возврат Результат;

КонецФункции

// Проверяет, что у объекта метаданных можно показать карту маршрута: объект - бизнес-процесс.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Булево - Истина, если объект - бизнес-процесс
Функция МожноПоказатьКартуМаршрута(ПолноеИмя) Экспорт

	Результат = (ВидОбъекта(ПолноеИмя) = "БизнесПроцесс");
	Возврат Результат;

КонецФункции

// Проверяет, что у объекта метаданных можно обновить нумерацию: это объект верхнего уровня с номером или кодом
// либо конфигурация - тогда обновляется нумерация всех объектов.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, у конфигурации - Конфигурация.<Имя>
//
// Возвращаемое значение:
//  Булево - Истина, если нумерацию можно обновить
Функция МожноОбновитьНумерациюОбъекта(ПолноеИмя) Экспорт

	Вид = ВидОбъекта(ПолноеИмя);
	Результат = (Вид = "Конфигурация" Или ВидыСНумерацией().Найти(Вид) <> Неопределено);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидОбъекта(ПолноеИмя)

	// Открываются только объекты верхнего уровня: их полное имя состоит из вида и имени.
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Если ЧастиИмени.Количество() = 2 Тогда
		Результат = ЧастиИмени[0];
	Иначе
		Результат = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ВидыСФормойСписка()

	Виды = Новый Массив;
	Виды.Добавить("Справочник");
	Виды.Добавить("Документ");
	Виды.Добавить("БизнесПроцесс");
	Виды.Добавить("Задача");
	Виды.Добавить("ПланСчетов");
	Виды.Добавить("ПланОбмена");
	Виды.Добавить("ПланВидовХарактеристик");
	Виды.Добавить("ПланВидовРасчета");
	Виды.Добавить("Перечисление");
	Виды.Добавить("ЖурналДокументов");
	Виды.Добавить("РегистрСведений");
	Виды.Добавить("РегистрНакопления");
	Виды.Добавить("РегистрБухгалтерии");
	Виды.Добавить("РегистрРасчета");
	Возврат Виды;

КонецФункции

// Виды объектов, у которых платформа ведет нумерацию: номера документов, бизнес-процессов и задач, коды справочников
// и планов, а также нумераторы документов.
Функция ВидыСНумерацией()

	Виды = Новый Массив;
	Виды.Добавить("Справочник");
	Виды.Добавить("Документ");
	Виды.Добавить("НумераторДокументов");
	Виды.Добавить("БизнесПроцесс");
	Виды.Добавить("Задача");
	Виды.Добавить("ПланВидовХарактеристик");
	Виды.Добавить("ПланВидовРасчета");
	Возврат Виды;

КонецФункции

#КонецОбласти
