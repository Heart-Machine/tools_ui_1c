#Область СлужебныйПрограммныйИнтерфейс

// Возвращает индекс обратных связей конфигурации. Индекс кэшируется на время сеанса:
// метаданные конфигурации и активных расширений в сеансе не меняются.
//
// Параметры:
//  КлючКонфигурации - Строка - пустая строка - текущая конфигурация вместе с активными расширениями,
//                     иначе имя активного расширения текущего сеанса
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - см. УИ_НавигаторПоМетаданным.ИндексОбратныхСвязей
Функция ИндексОбратныхСвязей(КлючКонфигурации) Экспорт

	МетаданныеКонфигурации = Метаданные;
	Если ЗначениеЗаполнено(КлючКонфигурации) Тогда
		МетаданныеРасширения = УИ_НавигаторПоМетаданным.МетаданныеРасширения(КлючКонфигурации);
		Если МетаданныеРасширения <> Неопределено Тогда
			МетаданныеКонфигурации = МетаданныеРасширения;
		КонецЕсли;
	КонецЕсли;
	Индекс = УИ_НавигаторПоМетаданным.ИндексОбратныхСвязей(МетаданныеКонфигурации);
	Возврат Индекс;

КонецФункции

// Возвращает активные в сеансе расширения конфигурации с их метаданными. Кэшируется на время сеанса:
// состав активных расширений в сеансе не меняется, а разбор метаданных расширения занимает время.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - см. УИ_НавигаторПоМетаданным.ОписанияРасширенийСеанса
Функция РасширенияСеанса() Экспорт

	Расширения = УИ_НавигаторПоМетаданным.ОписанияРасширенийСеанса();
	Возврат Расширения;

КонецФункции

// Возвращает объекты конфигурации, которые заимствуют активные расширения сеанса. Кэшируется на время сеанса:
// состав активных расширений в сеансе не меняется, а обход их метаданных нужен для каждой строки навигатора.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - см. УИ_НавигаторПоМетаданным.ЗаимствованныеОбъектыРасширенийСеанса
Функция ЗаимствованныеОбъектыРасширений() Экспорт

	ЗаимствованныеОбъекты = УИ_НавигаторПоМетаданным.ЗаимствованныеОбъектыРасширенийСеанса();
	Возврат ЗаимствованныеОбъекты;

КонецФункции

#КонецОбласти
