#Область ПрограммныйИнтерфейс

// Возвращает описания всех констант метаданных текущего сеанса со значениями. Значения читаются
// в привилегированном режиме: инструменты показывают константы независимо от прав пользователя.
//
// Возвращаемое значение:
//  Массив из см. НовоеОписаниеКонстанты
Функция ОписанияКонстант() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ОпцииКонстант = ФункциональныеОпцииКонстант();
	Описания = Новый Массив;
	Для Каждого Константа Из Метаданные.Константы Цикл
		Описания.Добавить(ОписаниеКонстантыМетаданных(Константа, ОпцииКонстант));
	КонецЦикла;
	Возврат Описания;

КонецФункции

// Возвращает описание константы метаданных текущего сеанса со значением. Значение читается
// в привилегированном режиме, см. ОписанияКонстант.
//
// Параметры:
//  ИмяКонстанты - Строка - имя константы
//
// Возвращаемое значение:
//  - см. НовоеОписаниеКонстанты
//  - Неопределено - если константы нет в метаданных текущего сеанса
Функция ОписаниеКонстанты(ИмяКонстанты) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Константа = Метаданные.Константы.Найти(ИмяКонстанты);
	Если Константа = Неопределено Тогда
		Описание = Неопределено;
	Иначе
		Описание = ОписаниеКонстантыМетаданных(Константа, ФункциональныеОпцииКонстант());
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Записывает значение константы с параметрами записи инструментов: в режиме загрузки, без авторегистрации
// изменений и т.п.
//
// Параметры:
//  ИмяКонстанты - Строка - имя константы
//  Значение - Произвольный - новое значение константы
//  ПараметрыЗаписи - см. УИ_ОбщегоНазначенияКлиентСервер.СтруктураПараметровЗаписиПоУмолчанию
//
// Возвращаемое значение:
//  Булево - Истина, если значение записано; иначе пользователю выводится сообщение
Функция ЗаписатьЗначениеКонстанты(ИмяКонстанты, Значение, ПараметрыЗаписи) Экспорт

	МенеджерЗначения = Константы[ИмяКонстанты].СоздатьМенеджерЗначения();
	МенеджерЗначения.Значение = Значение;
	Записано = УИ_ОбщегоНазначения.ЗаписатьОбъектВБазу(МенеджерЗначения, ПараметрыЗаписи);
	Возврат Записано;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает пустое описание константы. Ключи совпадают с колонками таблицы констант редактора констант.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяКонстанты - Строка - имя константы
//   * СинонимКонстанты - Строка - синоним константы
//   * ОписаниеТипов - ОписаниеТипов - тип значения константы
//   * ЗначениеКонстанты - Произвольный, Неопределено - значение константы в базе
//   * ФункциональнаяОпция - Строка - имя функциональной опции, которая хранится в константе; пустая строка,
//       если такой нет
//   * ПривилегированныйРежимПриПолучении - Булево - функциональная опция получается в привилегированном режиме
Функция НовоеОписаниеКонстанты()

	Описание = Новый Структура;
	Описание.Вставить("ИмяКонстанты", "");
	Описание.Вставить("СинонимКонстанты", "");
	Описание.Вставить("ОписаниеТипов", Новый ОписаниеТипов);
	Описание.Вставить("ЗначениеКонстанты", Неопределено);
	Описание.Вставить("ФункциональнаяОпция", "");
	Описание.Вставить("ПривилегированныйРежимПриПолучении", Ложь);
	Возврат Описание;

КонецФункции

// Возвращает описание константы со значением из базы.
//
// Параметры:
//  Константа - ОбъектМетаданных - константа
//  ОпцииКонстант - см. ФункциональныеОпцииКонстант
//
// Возвращаемое значение:
//  см. НовоеОписаниеКонстанты
Функция ОписаниеКонстантыМетаданных(Константа, ОпцииКонстант)

	Описание = НовоеОписаниеКонстанты();
	Описание.ИмяКонстанты = Константа.Имя;
	Описание.СинонимКонстанты = Константа.Синоним;
	Описание.ОписаниеТипов = Константа.Тип;
	Описание.ЗначениеКонстанты = Константы[Константа.Имя].Получить();
	Опция = ОпцииКонстант[Константа.Имя];
	Если Опция <> Неопределено Тогда
		Описание.ФункциональнаяОпция = Опция.Имя;
		Описание.ПривилегированныйРежимПриПолучении = Опция.ПривилегированныйРежимПриПолучении;
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Возвращает функциональные опции, которые хранятся в константах. Если в константе хранится несколько опций,
// берется последняя.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя константы
//   * Значение - ОбъектМетаданных - функциональная опция
Функция ФункциональныеОпцииКонстант()

	ОпцииКонстант = Новый Соответствие;
	Для Каждого ФункциональнаяОпция Из Метаданные.ФункциональныеОпции Цикл
		Если Метаданные.Константы.Содержит(ФункциональнаяОпция.Хранение) Тогда
			ОпцииКонстант.Вставить(ФункциональнаяОпция.Хранение.Имя, ФункциональнаяОпция);
		КонецЕсли;
	КонецЦикла;
	Возврат ОпцииКонстант;

КонецФункции

#КонецОбласти
