#Область ПрограммныйИнтерфейс

// Открывает объект метаданных в режиме 1С:Предприятие: форму списка, форму обработки или отчета, форму констант,
// общую форму, форму объекта, общий макет или макет объекта,
// см. УИ_НавигаторПоМетаданнымКлиентСервер.СпособОткрытияОбъекта.
// Объекты других видов не открываются.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, например Справочник.Валюты
//  Форма - ФормаКлиентскогоПриложения - форма, из которой открывается объект
//  Заголовок - Строка - заголовок окна макета; если не задан, используется имя макета
Процедура ОткрытьОбъектСписокМетаданных(ПолноеИмя, Форма, Заголовок = "") Экспорт

	СпособОткрытия = УИ_НавигаторПоМетаданнымКлиентСервер.СпособОткрытияОбъекта(ПолноеИмя);
	Если СпособОткрытия = "ФормаСписка" Тогда
		ОткрытьФорму(СтрШаблон("%1.ФормаСписка", ПолноеИмя));
	ИначеЕсли СпособОткрытия = "Форма" Тогда
		ОткрытьФорму(СтрШаблон("%1.Форма", ПолноеИмя));
	ИначеЕсли СпособОткрытия = "ФормаКонстант" Тогда
		ОткрытьФорму(СтрШаблон("%1.ФормаКонстант", ПолноеИмя));
	ИначеЕсли СпособОткрытия = "ПолноеИмя" Тогда
		ОткрытьФорму(ПолноеИмя);
	ИначеЕсли СпособОткрытия = "Макет" Тогда
		ОткрытьМакет(ПолноеИмя, Форма, Заголовок);
	КонецЕсли;

КонецПроцедуры

// Открывает динамический список объекта метаданных, если у объекта он есть,
// см. УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьДинамическийСписок.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных верхнего уровня
Процедура ОткрытьДинамическийСписок(ПолноеИмя) Экспорт

	Если УИ_НавигаторПоМетаданнымКлиентСервер.МожноОткрытьДинамическийСписок(ПолноеИмя) Тогда
		УИ_ОбщегоНазначенияКлиент.ОткрытьДинамическийСписок(ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

// Показывает карту маршрута бизнес-процесса, см. УИ_НавигаторПоМетаданнымКлиентСервер.МожноПоказатьКартуМаршрута.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя бизнес-процесса, например БизнесПроцесс.Задание
//  Форма - ФормаКлиентскогоПриложения - форма, из которой показывается карта
Процедура ПоказатьКартуМаршрута(ПолноеИмя, Форма) Экспорт

	АдресКарты = УИ_НавигаторПоМетаданнымВызовСервера.АдресКартыМаршрута(ПолноеИмя, Форма.УникальныйИдентификатор);
	Если Не ПустаяСтрока(АдресКарты) Тогда
		ПоказатьГрафическуюСхему(АдресКарты, СтрШаблон(НСтр("ru = 'Карта маршрута: %1'"), ПолноеИмя));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик выбора файла для сохранения макета.
//
// Параметры:
//  Результат - Массив из Строка, Неопределено - выбранные файлы
//  АдресДвоичныхДанных - Строка - адрес двоичных данных макета во временном хранилище
Процедура СохранениеФайлаМакетаЗавершение(Результат, АдресДвоичныхДанных) Экспорт

	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресДвоичныхДанных); // ДвоичныеДанные
	УдалитьИзВременногоХранилища(АдресДвоичныхДанных);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = Результат[0];
	Оповещение = Новый ОписаниеОповещения("СохранениеФайлаМакетаНачалоЗаписиЗавершение", ЭтотОбъект, ИмяФайла);
	ДанныеФайла.НачатьЗапись(Оповещение, ИмяФайла);

КонецПроцедуры

// Обработчик завершения записи файла макета.
//
// Параметры:
//  ИмяФайла - Строка - имя записанного файла
Процедура СохранениеФайлаМакетаНачалоЗаписиЗавершение(ИмяФайла) Экспорт

	Состояние(НСтр("ru = 'Файл сохранен.'"), , ИмяФайла, БиблиотекаКартинок.СохранитьФайл);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Показывает графическую схему, записанную на сервере в поток: саму схему между клиентом и сервером
// передать нельзя. Веб-клиент читать схему из потока не умеет, поэтому в нем схема не показывается.
//
// Параметры:
//  АдресСхемы - Строка - адрес схемы во временном хранилище, после показа данные из хранилища удаляются
//  Заголовок - Строка - заголовок окна схемы
Процедура ПоказатьГрафическуюСхему(АдресСхемы, Заголовок)

	#Если ВебКлиент Тогда
		УдалитьИзВременногоХранилища(АдресСхемы);
		ПоказатьПредупреждение( , НСтр("ru = 'В веб-клиенте графическую схему показать нельзя.'"));
	#Иначе
		ДанныеСхемы = ПолучитьИзВременногоХранилища(АдресСхемы); // ДвоичныеДанные
		УдалитьИзВременногоХранилища(АдресСхемы);
		ГрафическаяСхема = Новый ГрафическаяСхема;
		ГрафическаяСхема.Прочитать(ДанныеСхемы.ОткрытьПотокДляЧтения());
		ГрафическаяСхема.Показать(Заголовок);
	#КонецЕсли

КонецПроцедуры

Процедура ОткрытьМакет(ПолноеИмя, Форма, Заголовок)

	#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
		ЭтоТолстыйКлиент = Истина;
	#Иначе
		ЭтоТолстыйКлиент = Ложь;
	#КонецЕсли
	Результат = УИ_НавигаторПоМетаданнымВызовСервера.ДанныеОткрытияМакета(ПолноеИмя, ЭтоТолстыйКлиент,
		Форма.УникальныйИдентификатор);
	Если Результат.Отказ Тогда
		Возврат;
	КонецЕсли;

	// Имя макета - последняя часть полного имени: ОбщийМакет.Логотип, Справочник.Валюты.Макет.Классификатор.
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	ИмяМакета = ЧастиИмени[ЧастиИмени.ВГраница()];
	ЗаголовокМакета = ?(ПустаяСтрока(Заголовок), ИмяМакета, Заголовок);
	Если Результат.Макет <> Неопределено Тогда
		Результат.Макет.Показать(ЗаголовокМакета);
	ИначеЕсли Результат.ГрафическаяСхема <> Неопределено Тогда
		ПоказатьГрафическуюСхему(Результат.ГрафическаяСхема, ЗаголовокМакета);
	ИначеЕсли Результат.СхемаКомпоновкиДанных <> Неопределено Тогда
		УИ_ОбщегоНазначенияКлиент.ОткрытьКонструкторСхемыКомпоновкиДанных(Результат.СхемаКомпоновкиДанных, Форма, Истина);
	ИначеЕсли Результат.Текст <> Неопределено Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(Результат.Текст);
		ТекстовыйДокумент.Показать(ЗаголовокМакета);
	ИначеЕсли Результат.АдресДвоичныхДанных <> Неопределено Тогда
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Расширение = Результат.РасширениеФайла;
		Диалог.ПолноеИмяФайла = ИмяМакета;
		Диалог.Фильтр = НСтр("ru = 'Все файлы|*'");
		Диалог.Заголовок = НСтр("ru = 'Сохранить файл'");
		Оповещение = Новый ОписаниеОповещения("СохранениеФайлаМакетаЗавершение", ЭтотОбъект,
			Результат.АдресДвоичныхДанных);
		Диалог.Показать(Оповещение);
	ИначеЕсли Результат.HTMLДокумент <> Неопределено Тогда
		УИ_ОбщегоНазначенияКлиент.ОткрытьРедакторHTML(Результат.HTMLДокумент, Форма);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
